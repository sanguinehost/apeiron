+
+#[test]
+fn architecture_allowlist_maps_qk_permutation_and_refuses_unknown() {
+    assert_eq!(qk_row_permutation_for("qwen2"), Ok(false));
+    assert_eq!(qk_row_permutation_for("qwen35"), Ok(false));
+    assert_eq!(qk_row_permutation_for("llama"), Ok(true));
+    assert_eq!(
+        qk_row_permutation_for("mistral3"),
+        Err(EngineError::UnsupportedArchitecture("mistral3".to_string()))
+    );
+    assert_eq!(
+        qk_row_permutation_for(""),
+        Err(EngineError::UnsupportedArchitecture(String::new()))
+    );
+    let h = qwen2_header(0, 1 << 16);
+    assert!(!resolve_config(&h).unwrap().qk_row_permutation);
+}
