 /// The `general.architecture` this loader resolves config keys for.
 pub const QWEN2_ARCH: &str = "qwen2";
+/// Whether the loader must permute each head's `attn_q`/`attn_k` output rows, decided once from
+/// `general.architecture`. The engine implements the `NEOX` `RoPE` pairing `(j, j + n/2)`
+/// (`llama-model.cpp`, `llama_model_rope_type`: `LLM_ARCH_QWEN2` is `NEOX`, `LLM_ARCH_QWEN35` is
+/// `IMROPE`, which pairs like `NEOX` for text positions). `LLM_ARCH_LLAMA` is `NORM`, pairing
+/// `(2i, 2i + 1)`; its rows are permuted at load ([`qk_permute`]) so the same `NEOX` rotation
+/// yields the same scores.
+///
+/// # Errors
+///
+/// [`EngineError::UnsupportedArchitecture`] for any architecture outside `qwen2`, `qwen35`, `llama`.
+pub fn qk_row_permutation_for(architecture: &str) -> Result<bool, EngineError> {
+    match architecture {
+        "qwen2" | "qwen35" => Ok(false),
+        "llama" => Ok(true),
+        other => Err(EngineError::UnsupportedArchitecture(other.to_string())),
+    }
+}
