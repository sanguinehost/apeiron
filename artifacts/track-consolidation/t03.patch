+    /// The [`row_merged`] operands of two rows, or `None` when either row's spread exceeds
+    /// [`MERGED_SPREAD`] (then [`x2_shifted`] runs [`group2_x2`]). `sa`/`sb` have `blocks` entries.
+    pub(super) fn merged_operands<'a>(
+        sa: &[(i32, i64, i32)],
+        sb: &[(i32, i64, i32)],
+        spa: u32,
+        spb: u32,
+        ska: &'a mut [std::mem::MaybeUninit<(i32, i32)>; MAX_BLOCKS],
+        skb: &'a mut [std::mem::MaybeUninit<(i32, i32)>; MAX_BLOCKS],
+    ) -> Option<Merged<'a>> {
+        if spa.max(spb) > MERGED_SPREAD {
+            return None;
+        }
+        row_merged(sa, &mut ska[..sa.len()]);
+        row_merged(sb, &mut skb[..sb.len()]);
+        // SAFETY: `row_merged` initialized the first `sa.len()` / `sb.len()` entries.
+        unsafe {
+            Some((
+                std::slice::from_raw_parts(ska.as_ptr().cast(), sa.len()),
+                std::slice::from_raw_parts(skb.as_ptr().cast(), sb.len()),
+                spa,
+                spb,
+            ))
+        }
+    }
