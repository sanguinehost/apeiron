+/// One 64-byte line of `N` values of `T`: the unit of [`Aligned`].
+#[repr(C, align(64))]
+#[derive(Clone, Copy)]
+struct Line<T: Copy, const N: usize>([T; N]);
+
+/// A buffer of `T` whose base address is 64-byte aligned, so every 32-byte kernel load at a
+/// multiple of 32 bytes stays inside one cache line. The global allocator's 16-byte-aligned
+/// `Vec<u32>` made half of the activation loads straddle a line boundary. One allocation, as
+/// before; the length is a whole number of lines.
+struct Aligned<T: Copy + 'static, const N: usize> {
+    lines: Vec<Line<T, N>>,
+    len: usize,
+}
+
+impl<T: Copy, const N: usize> Aligned<T, N> {
+    fn with_capacity(n: usize) -> Self {
+        Self {
+            lines: Vec::with_capacity(n.div_ceil(N)),
+            len: 0,
+        }
+    }
+    fn as_ptr(&self) -> *const T {
+        self.lines.as_ptr().cast()
+    }
+    fn as_mut_ptr(&mut self) -> *mut T {
+        self.lines.as_mut_ptr().cast()
+    }
+    #[cfg(test)]
+    fn len(&self) -> usize {
+        self.len
+    }
+    /// # Safety
+    ///
+    /// `n` is a multiple of `N` and the first `n` values are initialized.
+    unsafe fn set_len(&mut self, n: usize) {
+        debug_assert!(n.is_multiple_of(N));
+        // SAFETY: by the caller's contract `n / N` whole lines are initialized.
+        unsafe { self.lines.set_len(n / N) };
+        self.len = n;
+    }
+}
