+// ---- real dense-model shapes -----------------------------------------------------------------
+
+/// FNV-1a over a slice of words.
+fn fnv(mut h: u64, v: &[i64]) -> u64 {
+    for w in v {
+        h = (h ^ w.cast_unsigned()).wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    h
+}
+
+/// Per class of the real prefill calls of `APEIRON_DENSE_MODEL` (default: the Qwen3.5 probe model)
+/// at `APEIRON_DENSE_IDS`: the layer-12 call with real weights and real columns (cyclic to `k`),
+/// best and median call time, GMAC/s and an FNV digest of every output word (equal digests across
+/// two builds prove identical words on these inputs).
+///
+/// Run: `APEIRON_F32_CARRIER=1 APEIRON_DENSE_MODEL=<gguf> APEIRON_DENSE_IDS=<ids> cargo test
+/// --release --lib --locked gemm_dense_shapes -- --ignored --nocapture`; `APEIRON_ATTRIB_K`
+/// (default 200), `APEIRON_ATTRIB_REPS` (default 40), `APEIRON_ATTRIB_ATT` (default 4 attempts).
+#[test]
+#[ignore = "release-only instrument: see the doc comment"]
+fn gemm_dense_shapes() {
+    use crate::engine::kern::gemm::{gemm_q8_0, gemm_q8_0_group, gemm_q8_0_swiglu};
+    use crate::engine::kern::gemm_probe::{hooks, raw, rebuild, take_k, wait_quiet, Load};
+    use crate::engine::loader::Engine;
+    use crate::engine::KernelMode;
+    use crate::format::quant::GGML_TYPE_Q8_0;
+    if !(std::is_x86_feature_detected!("avx2") && std::is_x86_feature_detected!("avxvnni")) {
+        println!("gemm_dense: host lacks AVX-VNNI");
+        return;
+    }
+    let env = |k: &str, d: usize| {
+        std::env::var(k)
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(d)
+    };
+    let model = std::env::var("APEIRON_DENSE_MODEL")
+        .unwrap_or_else(|_| crate::engine::kern::gemm_probe::MODEL.to_string());
+    let ids_path = std::env::var("APEIRON_DENSE_IDS")
+        .unwrap_or_else(|_| crate::engine::kern::gemm_probe::IDS.to_string());
+    let ids: Vec<u32> = std::fs::read_to_string(&ids_path)
+        .expect("ids")
+        .split_whitespace()
+        .filter_map(|x| x.parse().ok())
+        .take(env("APEIRON_DENSE_PP", 200))
+        .collect();
+    let e = Engine::open(&model).expect("open model");
+    let names = crate::engine::kern::gemm_probe::tensor_names(&e);
+    let mut st = e.state(ids.len() + 1).expect("state");
+    e.prefill_state(&mut st, &ids, KernelMode::Q8Act)
+        .expect("warm");
+    hooks::start(2);
+    let mut st = e.state(ids.len() + 1).expect("state");
+    e.prefill_state(&mut st, &ids, KernelMode::Q8Act)
+        .expect("prefill");
+    let cap = hooks::stop();
+    let k = env("APEIRON_ATTRIB_K", 200);
+    let reps = env("APEIRON_ATTRIB_REPS", 40);
+    let attempts = env("APEIRON_ATTRIB_ATT", 4);
+    println!(
+        "== gemm_dense == model {model} pp {} k {k} pool width {} prefill block {}",
+        ids.len(),
+        crate::engine::chart::pool::Pool::global().width(),
+        crate::engine::step::prefill_block()
+    );
+    let mut seen = std::collections::BTreeSet::new();
+    for c in &cap {
+        let label = {
+            let n: Vec<String> = c
+                .parts
+                .iter()
+                .map(|p| {
+                    crate::engine::kern::gemm_probe::strip_layer(
+                        names.get(&p.ptr).map_or("?", String::as_str),
+                    )
+                })
+                .collect();
+            format!(
+                "{:?} {} n_in={} n_out={:?}",
+                c.kind,
+                n.join("+"),
+                c.n_in,
+                c.parts.iter().map(|p| p.n_out).collect::<Vec<_>>()
+            )
+        };
+        if c.k < 8
+            || !seen.insert(label.clone())
+            || std::env::var("APEIRON_DENSE_ONLY").is_ok_and(|o| !label.contains(&o))
+        {
+            continue;
+        }
+        // The layer-12 call of this class (or the last one when the model is shallower).
+        let pick = cap
+            .iter()
+            .filter(|d| {
+                d.kind == c.kind
+                    && d.n_in == c.n_in
+                    && d.k == c.k
+                    && d.parts.len() == c.parts.len()
+                    && d.parts
+                        .iter()
+                        .zip(&c.parts)
+                        .all(|(a, b)| a.n_out == b.n_out)
+            })
+            .collect::<Vec<_>>();
+        let d = pick.get(12).or(pick.last()).expect("call");
+        let (qs, _) = rebuild(&take_k(&d.cols, k));
+        let macs: f64 = d
+            .parts
+            .iter()
+            .map(|p| p.n_out as f64 * d.n_in as f64 * k as f64)
+            .sum();
+        let mut digest = 0xcbf2_9ce4_8422_2325u64;
+        // SAFETY: the engine is alive for the whole test.
+        let call = |digest: Option<&mut u64>| unsafe {
+            match d.kind {
+                hooks::Kind::Gemm => {
+                    let r = gemm_q8_0(
+                        GGML_TYPE_Q8_0,
+                        raw(&d.parts[0]),
+                        d.parts[0].n_out,
+                        d.n_in,
+                        &qs,
+                    );
+                    if let (Some(h), Some(r)) = (digest, &r) {
+                        for col in r {
+                            *h = fnv(*h, col);
+                        }
+                    }
+                    std::hint::black_box(r).is_some()
+                }
+                hooks::Kind::Group => {
+                    let parts: Vec<(u32, &[u8], usize)> = d
+                        .parts
+                        .iter()
+                        .map(|p| (GGML_TYPE_Q8_0, raw(p), p.n_out))
+                        .collect();
+                    let r = gemm_q8_0_group(&parts, d.n_in, &qs);
+                    if let (Some(h), Some(r)) = (digest, &r) {
+                        for part in r {
+                            for col in part {
+                                *h = fnv(*h, col);
+                            }
+                        }
+                    }
+                    std::hint::black_box(r).is_some()
+                }
+                hooks::Kind::Swiglu => {
+                    let r = gemm_q8_0_swiglu(
+                        raw(&d.parts[0]),
+                        raw(&d.parts[1]),
+                        d.parts[0].n_out,
+                        d.n_in,
+                        &qs,
+                    );
+                    if let (Some(h), Some(Ok(r))) = (digest, &r) {
+                        for col in r {
+                            *h = fnv(*h, col);
+                        }
+                    }
+                    std::hint::black_box(r).is_some()
+                }
+            }
+        };
+        assert!(call(Some(&mut digest)), "{label}: refused");
+        for _ in 0..30 {
+            call(None);
+        }
+        let mut best_run: Option<(f64, f64, f64)> = None;
+        for _ in 0..attempts {
+            let (_, busy) = wait_quiet();
+            let l = Load::begin();
+            let mut v: Vec<f64> = (0..reps)
+                .map(|_| {
+                    let t = Instant::now();
+                    call(None);
+                    t.elapsed().as_secs_f64() * 1e3
+                })
+                .collect();
+            let foreign = l.foreign();
+            v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            let cand = (v[0], v[v.len() / 2], foreign);
+            let _ = busy;
+            if best_run.is_none_or(|b| (cand.2 < 0.05, -cand.0) > (b.2 < 0.05, -b.0)) {
+                best_run = Some(cand);
+            }
+        }
+        let (best, med, foreign) = best_run.unwrap();
+        println!(
+            "SHAPE {label} k={k}: best {best:.4} ms = {:.1} GMAC/s, median {med:.4} ms = {:.1} GMAC/s, foreign {foreign:.3}, digest {digest:016x}",
+            macs / best / 1e6,
+            macs / med / 1e6
+        );
+    }
+}
