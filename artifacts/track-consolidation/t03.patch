+    /// `x2_shifted` returns the lane sums of the reference kernel [`x86::group2_x2`] for row
+    /// pairs at, below and above the merged-multiplier bound (`row spread + group spread ≤ 19`),
+    /// with the largest weight mantissa (`0x7bff`: `m = 2047`), extreme weight codes and columns
+    /// spanning 1 to 30 bits of block magnitude. Both the merged and the fallback branch occur.
+    #[test]
+    #[cfg(target_arch = "x86_64")]
+    fn merged_kernel_equals_the_shifted_kernel() {
+        if !(std::is_x86_feature_detected!("avx2") && std::is_x86_feature_detected!("avxvnni")) {
+            return;
+        }
+        let (n_in, blocks) = (256usize, 8usize);
+        let mut seed = 0x6d65_7267_6564_u64;
+        let (mut merged_runs, mut fallback_runs) = (0usize, 0usize);
+        for row_spread in [0u16, 1, 7, 12, 18, 19, 20, 24] {
+            let lo = 0x7bff - 0x0400 * row_spread;
+            for range in [1u32, 3, 8, 12, 19, 25, 30] {
+                for codes in [0u8, 1, 2] {
+                    let mut raw = payload(2, n_in, &[0x7bff, lo], &mut seed);
+                    if codes != 0 {
+                        // Extreme codes: all -128 (or all 127) in every block.
+                        let fill = if codes == 1 { 0x80 } else { 0x7f };
+                        for blk in raw.chunks_mut(Q8_0_BLOCK_BYTES) {
+                            blk[2..].fill(fill);
+                        }
+                    }
+                    let qs = columns(16, n_in, range, &mut seed);
+                    let p = pack(&qs, blocks).expect("power-of-two scales");
+                    let (ra, rb) = raw.split_at(blocks * Q8_0_BLOCK_BYTES);
+                    let mut sa = vec![(0i32, 0i64, 0i32); blocks];
+                    let mut sb = vec![(0i32, 0i64, 0i32); blocks];
+                    // SAFETY: AVX2 checked above; rows hold `blocks` blocks.
+                    let (Some((_, spa)), Some((_, spb))) = (unsafe {
+                        (
+                            x86::row_scales_avx2(ra, blocks, &mut sa),
+                            x86::row_scales_avx2(rb, blocks, &mut sb),
+                        )
+                    }) else {
+                        panic!("finite scales");
+                    };
+                    let mut ska =
+                        [const { std::mem::MaybeUninit::<(i32, i32)>::uninit() }; MAX_BLOCKS];
+                    let mut skb =
+                        [const { std::mem::MaybeUninit::<(i32, i32)>::uninit() }; MAX_BLOCKS];
+                    let merged = x86::merged_operands(&sa, &sb, spa, spb, &mut ska, &mut skb);
+                    let eligible = merged.is_some()
+                        && spa.max(spb) + p.spread[0].max(p.spread[1]) <= x86::MERGED_SPREAD;
+                    merged_runs += usize::from(eligible);
+                    fallback_runs += usize::from(!eligible);
+                    // SAFETY: AVX2 and AVX-VNNI checked; groups 0 and 1 exist (`k = 16`).
+                    let (got, want) = unsafe {
+                        (
+                            x86::x2_shifted(ra, rb, &sa, &sb, merged, blocks, &p, 0),
+                            x86::group2_x2(
+                                ra,
+                                rb,
+                                &sa,
+                                &sb,
+                                blocks,
+                                p.words.as_ptr(),
+                                p.words.as_ptr().add(blocks * 8 * LANES),
+                                p.shift.as_ptr(),
+                                p.shift.as_ptr().add(blocks * LANES),
+                            ),
+                        )
+                    };
+                    // SAFETY: `__m256i` is 32 plain bytes.
+                    let (got, want): ([[i64; 4]; 8], [[i64; 4]; 8]) = unsafe {
+                        (
+                            std::mem::transmute::<[std::arch::x86_64::__m256i; 8], [[i64; 4]; 8]>(
+                                got,
+                            ),
+                            std::mem::transmute::<[std::arch::x86_64::__m256i; 8], [[i64; 4]; 8]>(
+                                want,
+                            ),
+                        )
+                    };
+                    assert_eq!(
+                        got, want,
+                        "row spread {row_spread} range {range} codes {codes} (spa {spa} spb {spb} group spreads {} {})",
+                        p.spread[0], p.spread[1]
+                    );
+                }
+            }
+        }
+        assert!(
+            merged_runs > 0 && fallback_runs > 0,
+            "{merged_runs} merged, {fallback_runs} fallback"
+        );
+    }
