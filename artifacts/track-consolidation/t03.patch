+    /// Largest `row spread + column-group spread` for [`group2_x2_merged`]: the merged multiplier
+    /// `m·2^(k−k_min+e−e_min)` has `|m| < 2^11` ([`f16_split`]), so `|m|·2^19 < 2^30` fits `i32`.
+    pub(super) const MERGED_SPREAD: u32 = 19;
+
+    /// Both rows' [`row_merged`] operands and their spreads.
+    pub(super) type Merged<'a> = (&'a [(i32, i32)], &'a [(i32, i32)], u32, u32);
+
+    /// One row's per-block operands of [`group2_x2_merged`]: `(m << (k − k_min), −bias)`.
+    ///
+    /// The row's spread is at most [`MERGED_SPREAD`] (the caller checks), so every `k − k_min` is
+    /// below 32 and the shift cannot overflow.
+    ///
+    /// # Complexity
+    ///
+    /// `O(blocks)` scalar steps per row.
+    pub(super) fn row_merged(
+        sa: &[(i32, i64, i32)],
+        out: &mut [std::mem::MaybeUninit<(i32, i32)>],
+    ) {
+        for (o, &(m, k, ba)) in out.iter_mut().zip(sa) {
+            o.write((m << k, ba.wrapping_neg()));
+        }
+    }
+
+    /// [`group2_x2`] with the per-block multiplier merged: for row operand `(mk, −ba)` and column
+    /// shift `sh = e − e_min`, the term `((D − ba)·m) << (k − k_min + sh)` of each lane is
+    /// `(D − ba) · (mk << sh)`, one `vpsllvd` of the row's `mk` by the group's shifts and one
+    /// `vpmuldq` into `i64` lanes, exactly equal while `row spread + group spread ≤`
+    /// [`MERGED_SPREAD`] (`|D − ba| ≤ 2^19` and `|mk << sh| < 2^30`, so both factors are `i32`
+    /// and the product is exact in `i64`). The bias is the accumulator's initial value (`vpdpbusd`
+    /// and the `i32` sum wrap identically), so the per-block `vpsubd`, `vpmulld`, `vpaddq` of the
+    /// shift count and `vpsllvq` are gone. The shift array's `i64` lanes are read as dwords: the
+    /// count sits in the even dword of each lane and the odd dword is zero.
+    ///
+    /// # Safety
+    ///
+    /// AVX2 and AVX-VNNI; `ra`, `rb` hold `blocks` blocks, `ska`/`skb` hold `blocks` entries from
+    /// [`row_merged`], the word and shift pointers address the two groups' `blocks·64` words and
+    /// `blocks·8` shifts, and every `k − k_min + sh` of the operands is at most [`MERGED_SPREAD`].
+    ///
+    /// # Complexity
+    ///
+    /// `O(blocks)` vector steps, 32 `vpdpbusd` and about 40 other vector operations per block.
+    #[target_feature(enable = "avx2")]
+    #[allow(
+        clippy::cast_ptr_alignment,
+        clippy::too_many_arguments,
+        clippy::similar_names,
+        clippy::too_many_lines,
+        reason = "unaligned 256-bit loads and 32-bit weight-word reads"
+    )]
+    pub(super) unsafe fn group2_x2_merged(
+        ra: &[u8],
+        rb: &[u8],
+        ska: &[(i32, i32)],
+        skb: &[(i32, i32)],
+        blocks: usize,
+        words_g0: *const u32,
+        words_g1: *const u32,
+        shift_g0: *const i64,
+        shift_g1: *const i64,
+    ) -> [__m256i; 8] {
+        let z = _mm256_setzero_si256();
+        let (mut a0_0, mut a1_0, mut b0_0, mut b1_0) = (z, z, z, z);
+        let (mut a0_1, mut a1_1, mut b0_1, mut b1_1) = (z, z, z, z);
+        for b in 0..blocks {
+            // SAFETY: in range by the caller's geometry.
+            unsafe {
+                let ca = ra.as_ptr().add(b * Q8_0_BLOCK_BYTES + 2);
+                let cb = rb.as_ptr().add(b * Q8_0_BLOCK_BYTES + 2);
+                let wb0 = words_g0.add(b * 8 * LANES);
+                let wb1 = words_g1.add(b * 8 * LANES);
+                let (mka, nba) = ska[b];
+                let (mkb, nbb) = skb[b];
+                let mut da0 = _mm256_set1_epi32(nba);
+                let mut da1 = da0;
+                let mut db0 = _mm256_set1_epi32(nbb);
+                let mut db1 = db0;
+                for quad in 0..8 {
+                    let act0 = _mm256_loadu_si256(wb0.add(quad * LANES).cast::<__m256i>());
+                    let act1 = _mm256_loadu_si256(wb1.add(quad * LANES).cast::<__m256i>());
+                    let wa = _mm256_set1_epi32(ca.add(4 * quad).cast::<i32>().read_unaligned());
+                    da0 = dpbusd(da0, act0, wa);
+                    da1 = dpbusd(da1, act1, wa);
+                    let wbv = _mm256_set1_epi32(cb.add(4 * quad).cast::<i32>().read_unaligned());
+                    db0 = dpbusd(db0, act0, wbv);
+                    db1 = dpbusd(db1, act1, wbv);
+                }
+                let e00 = _mm256_loadu_si256(shift_g0.add(b * LANES).cast::<__m256i>());
+                let e01 = _mm256_loadu_si256(shift_g0.add(b * LANES + 4).cast::<__m256i>());
+                let e10 = _mm256_loadu_si256(shift_g1.add(b * LANES).cast::<__m256i>());
+                let e11 = _mm256_loadu_si256(shift_g1.add(b * LANES + 4).cast::<__m256i>());
+                let va = _mm256_set1_epi32(mka);
+                let vb = _mm256_set1_epi32(mkb);
+                let term = |d: __m256i, v: __m256i, e0: __m256i, e1: __m256i| {
+                    (
+                        _mm256_mul_epi32(
+                            _mm256_cvtepi32_epi64(_mm256_castsi256_si128(d)),
+                            _mm256_sllv_epi32(v, e0),
+                        ),
+                        _mm256_mul_epi32(
+                            _mm256_cvtepi32_epi64(_mm256_extracti128_si256(d, 1)),
+                            _mm256_sllv_epi32(v, e1),
+                        ),
+                    )
+                };
+                let (t0, t1) = term(da0, va, e00, e01);
+                a0_0 = _mm256_add_epi64(a0_0, t0);
+                a1_0 = _mm256_add_epi64(a1_0, t1);
+                let (t0, t1) = term(da1, va, e10, e11);
+                a0_1 = _mm256_add_epi64(a0_1, t0);
+                a1_1 = _mm256_add_epi64(a1_1, t1);
+                let (t0, t1) = term(db0, vb, e00, e01);
+                b0_0 = _mm256_add_epi64(b0_0, t0);
+                b1_0 = _mm256_add_epi64(b1_0, t1);
+                let (t0, t1) = term(db1, vb, e10, e11);
+                b0_1 = _mm256_add_epi64(b0_1, t0);
+                b1_1 = _mm256_add_epi64(b1_1, t1);
+            }
+        }
+        [a0_0, a1_0, b0_0, b1_0, a0_1, a1_1, b0_1, b1_1]
+    }
