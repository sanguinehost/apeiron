/target
# The fuzzer's own build tree, and the corpus it grows. The corpus is a cache: it makes a later
# run reach coverage faster, and it is regenerated by running the fuzzer, so it is not source.
/fuzz/target
/fuzz/corpus
/fuzz/coverage
# Crash inputs are NOT ignored. If the fuzzer ever writes one, it belongs in the history with the
# fix, as the regression test that proves the fix.
# Cross-stream coordination for the three parallel work streams. Working notes, not source.
/.tracks/

# Python bytecode caches. Generated by importing the tools; not source.
__pycache__/
*.pyc

# tools/gate is a standalone crate; its build products are never tracked.
tools/gate/target/
proof/extract/target/
