import struct
p = "/home/lucas/models/nq-scratch/nq06-v3.nqp"
f = open(p, "rb")
magic, version, at, layers, kinds, linears, extra = struct.unpack("<8sIIIIII", f.read(32))
hist, fulls = {}, {}
for _ in range(linears):
    f.seek(at)
    raw = f.read(36)
    layer, kind, out, inn, rank, u_words, v_words, k = struct.unpack_from("<IIIIIIII", raw)
    res_layers = struct.unpack_from("<I", raw, 32)[0]
    hist[(k, res_layers)] = hist.get((k, res_layers), 0) + 1
    fulls[(inn // 32, kind)] = fulls.get((inn // 32, kind), 0) + 1
    payload = (out*u_words*4 + rank*v_words*4 + inn*2 + rank*2 + out*2
               + k*4 + out*k*2 + res_layers*out*v_words*4 + res_layers*out*2)
    at += 36 + payload
print(f"pack {p}")
print(f"magic {magic.decode()} version {version} layers {layers} kinds {kinds} linears {linears}")
print("k,res_layers histogram:", hist)
print("full=inn/32 by kind:", dict(sorted(fulls.items())))
print("end offset", at)
