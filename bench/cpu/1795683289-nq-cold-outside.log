wait_quiet() {
  for _ in $(seq 1 90); do
    load=$(awk "{print \$1}" /proc/loadavg)
    if awk -v l="$load" "BEGIN{exit !(l<1.5)}"; then break; fi
    sleep 5
  done
}

echo "### provenance"
date -u
uname -a
lscpu | grep -E "Model name|CPU\(s\)|Socket|Thread|Core|L3" || true
sha256sum "$BEFORE" "$AFTER" "$GGUF" "$NQP" "$TOK" "$LLAMA" "$LLAMA_BIN"

run_llama() {
  local tag=$1
  "$LLAMA_BIN" -m "$LLAMA" -p 1827 -n 0 -t 8 -r 1 > "$OUT/llama-$tag.wall" 2>&1
  echo "[$tag llama]"
  grep -E "pp1827" "$OUT/llama-$tag.wall" | tail -1
}

run_ours() {
  local tag=$1 bin=$2 extra=${3:-}
  "$bin" --model "$GGUF" --pack "$NQP" --tokenizer "$TOK" --len 1827 --differ 0 --decode 0 --mb 440 $extra > "$OUT/$tag.wall" 2>&1
  echo "[$tag]"
  if [ -n "$extra" ]; then
    grep -E "head |pass |pool\.wait|outside\." "$OUT/$tag.wall" | head -n 10
  fi
  grep "cold " "$OUT/$tag.wall"
}

wait_quiet
echo "### untraced paired start $(uptime)"
# Round 1: llama, before, after
run_llama r1
run_ours before-r1 "$BEFORE"
run_ours after-r1 "$AFTER"
# Round 2: before, after, llama
run_ours before-r2 "$BEFORE"
run_ours after-r2 "$AFTER"
run_llama r2
# Round 3: after, llama, before
run_ours after-r3 "$AFTER"
run_llama r3
run_ours before-r3 "$BEFORE"
echo "### untraced paired end $(uptime)"

wait_quiet
echo "### traced paired start $(uptime)"
run_ours before-p1 "$BEFORE" "--phases"
run_ours after-p1 "$AFTER" "--phases"
run_ours after-p2 "$AFTER" "--phases"
run_ours before-p2 "$BEFORE" "--phases"
run_ours before-p3 "$BEFORE" "--phases"
run_ours after-p3 "$AFTER" "--phases"
echo "### traced paired end $(uptime)"

