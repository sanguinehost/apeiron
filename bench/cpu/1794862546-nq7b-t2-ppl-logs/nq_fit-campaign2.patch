+/// Write the completed prefix of the pack atomically, so a later failure keeps every section.
+fn write_pack(path: &str, layers: usize, linears: &[PackedLinear]) -> Result<(), Box<dyn Error>> {
+    let pack = NqPack::new(layers, linears.to_vec())?;
+    let bytes = write(&pack)?;
+    let tmp = format!("{path}.tmp");
+    std::fs::write(&tmp, &bytes)?;
+    std::fs::rename(&tmp, path)?;
+    println!(
+        "pack {path} {} B, {} sections, {:.6} b/w",
+        bytes.len(),
+        pack.linears.len(),
+        pack.bits_per_weight().unwrap_or(0.0)
+    );
+    Ok(())
+}
