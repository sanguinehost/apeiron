### the quiet-window pair
# script /tmp/gap8-pair.sh (run under ~/bin/adg run -- bash /tmp/gap8-pair.sh)
# start: 06:45:23 up 1 day 21:48, load average: 1.31, 1.18, 0.82
# the script waits for load < 1.5, then runs llama and ours three times, interleaved,
# then one --phases run. The six runs use the same binaries, model, pack and width.

#!/usr/bin/env bash
set -u
cd "$HOME/Workspace/apeiron-nq-clean"
OUT=/tmp/gap8; mkdir -p "$OUT"
GGUF=$HOME/models/qwen3-0.6b-base-nq/nq-pack/skeleton-q8head.gguf
NQP=$HOME/models/nq-scratch/nq06-v3.nqp
TOK=$HOME/models/qwen3-0.6b-base-e8/tokenizer.json
LLAMA=$HOME/models/qwen3-0.6b-base-f16/Qwen3-0.6B-Base.f16.gguf
BIN=$HOME/bin/prefix_solve.cleanfin

for _ in $(seq 1 90); do
  load=$(awk '{print $1}' /proc/loadavg)
  if awk -v l="$load" 'BEGIN{exit !(l<1.5)}'; then break; fi
  sleep 10
done
echo "start $(uptime)"

for i in 1 2 3; do
  "$HOME/llama.cpp/build/bin/llama-bench" -m "$LLAMA" -p 1827 -n 0 -t 8 -r 1 \
    > "$OUT/l$i.wall" 2>&1
  grep -E 'pp1827' "$OUT/l$i.wall" | tail -1
  "$BIN" --model "$GGUF" --pack "$NQP" --tokenizer "$TOK" --len 1827 --differ 0 \
    --decode 0 --mb 440 > "$OUT/o$i.wall" 2>&1
  grep cold "$OUT/o$i.wall"
done

"$BIN" --model "$GGUF" --pack "$NQP" --tokenizer "$TOK" --len 1827 --differ 0 \
  --decode 0 --mb 440 --phases > "$OUT/phases.txt" 2>&1
grep -E 'pass |pool.wait|cold ' "$OUT/phases.txt"
echo "end $(uptime)"

