    let hi ← hi_b * 32#usize
    let rows ← hi - lo
    let (gate_dst, _) ← chart.ffn.RowPtr.as_mut_slice gate_ptr lo rows
    let (up_dst, _) ← chart.ffn.RowPtr.as_mut_slice up_ptr lo rows
    let (h_dst, _) ← chart.ffn.RowPtr.as_mut_slice hidden_ptr lo rows
    let (r, gate_dst1) ←
