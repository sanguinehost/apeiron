  (gate_type : Std.U32) (gate_raw : Slice Std.U8)
  (gate_pp : chart.ffn.ProjPrep) (up_type : Std.U32) (up_raw : Slice Std.U8)
  (up_pp : chart.ffn.ProjPrep) (n_in : Std.Usize) (q : chart.QuantAct)
  (gate_ptr : chart.ffn.RowPtr) (up_ptr : chart.ffn.RowPtr)
  (hidden_ptr : chart.ffn.RowPtr) (act_ptr : chart.ffn.ActPtr)
  (carrier : mixer.Carrier)
  (proj_err : chart.pool.FirstErr Std.U128 matvec.MatvecError)
