          let idx ← lo + lane
          chart.pool.FirstErr.record core.cmp.OrdUsize swiglu_err idx e
      | core.result.Result.Err e =>
        let i3 ← chart.task.pair_key 1#usize lo
        chart.pool.FirstErr.record core.cmp.OrdU128 proj_err i3 e
    | core.result.Result.Err e =>
      let i3 ← chart.task.pair_key 0#usize lo
