        | core.result.Result.Ok _ =>
          let o ← chart.quant_act h_dst1
          match o with
          | none =>
            chart.pool.FirstErr.record core.cmp.OrdUsize quant_err lo_b ()
          | some qa =>
            let s ← chart.QuantAct.impl.scales qa
            let p ← core.slice.Slice.as_ptr s
            let i3 ← hi_b - lo_b
