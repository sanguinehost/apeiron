    let (s, deref_mut_back) ← lift (alloc.vec.Vec.deref_mut y)
    let (r, s1) ← rope.RopeTable.rotate_one table s pos
    match r with
    | core.result.Result.Ok _ =>
      let y1 := deref_mut_back s1
      ok (core.result.Result.Ok y1)
