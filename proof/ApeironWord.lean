def fp.F32.to_q32 (self : fp.F32) : Result (Option Std.I64) := do
  let i ← self >>> 23#i32
  let e ← lift (i &&& 255#u32)
  if e = 255#u32
  then ok none
  else
    let frac ← lift (self &&& 8388607#u32)
    let m ←
      if e = 0#u32
      then ok (core.convert.num.FromU64U32.from frac)
      else
        do
        let i1 ← lift (frac ||| 8388608#u32)
        ok (core.convert.num.FromU64U32.from i1)
    let i1 ← lift (self &&& fp.SIGN)
    let ee ← if e = 0#u32
               then ok 1#u32
               else ok e
    if ee >= 118#u32
    then
      let k ← ee - 118#u32
      if k > 40#u32
      then ok none
      else
        let i2 ← lift (core.convert.num.FromU128U64.from m)
        let mag ← i2 <<< k
        let lim ← 1#u128 <<< 63#i32
        if i1 != 0#u32
        then
          let o ← lift (core.cmp.impls.OrdU128.cmp mag lim)
          match o with
          | Ordering.lt =>
            let i3 ← lift (UScalar.hcast .I64 mag)
            let i4 ← -. i3
            ok (some i4)
          | Ordering.eq => ok (some core.num.I64.MIN)
          | Ordering.gt => ok none
        else
          if mag >= lim
          then ok none
          else let i3 ← lift (UScalar.hcast .I64 mag)
               ok (some i3)
    else
      let sh ← 118#u32 - ee
      let mag ←
        if sh > 24#u32
        then ok 0#u128
        else
          do
          let i2 ← sh - 1#u32
          let i3 ← 1#u64 <<< i2
          let i4 ← m + i3
          let i5 ← i4 >>> sh
          ok (core.convert.num.FromU128U64.from i5)
      let lim ← 1#u128 <<< 63#i32
      if i1 != 0#u32
      then
        let o ← lift (core.cmp.impls.OrdU128.cmp mag lim)
        match o with
        | Ordering.lt =>
          let i2 ← lift (UScalar.hcast .I64 mag)
          let i3 ← -. i2
          ok (some i3)
        | Ordering.eq => ok (some core.num.I64.MIN)
        | Ordering.gt => ok none
      else
        if mag >= lim
        then ok none
        else let i2 ← lift (UScalar.hcast .I64 mag)
             ok (some i2)

