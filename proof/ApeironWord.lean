def exchange.elastic_exchange
  {R : Type} (scalarRingInst : scalar.Ring R) (p : cell.Cell R)
  (q : cell.Cell R) :
  Result (exchange.Exchange R)
  := do
  let impulse ← exchange.exchange_impulse scalarRingInst p q
  let t ← scalarRingInst.sub p.a impulse.a
  let t1 ← scalarRingInst.sub p.b impulse.b
  let c ← cell.Cell.new scalarRingInst t t1
  let t2 ← scalarRingInst.add q.a impulse.a
  let t3 ← scalarRingInst.add q.b impulse.b
  let c1 ← cell.Cell.new scalarRingInst t2 t3
  ok { impulse, carrier_after := c, body_after := c1 }

