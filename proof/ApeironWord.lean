  let o ← lift (I64.checked_sub right left)
  match o with
  | none => ok none
  | some difference =>
    let o1 ← lift (I64.checked_rem difference 2#i64)
    match o1 with
    | none => ok none
    | some remainder =>
      if remainder != 0#i64
      then ok none
      else
        let o2 ← lift (I64.checked_div difference 2#i64)
        match o2 with
        | none => ok none
        | some half => ok (I64.checked_sub 0#i64 half)

