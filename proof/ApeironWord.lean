def packing.round_scaled
  (sig : Std.I64) (rbits : Std.U32) (positive : Bool) : Result Std.I64 := do
  if rbits >= 25#u32
  then ok 0#i64
  else
    let q ← sig >>> rbits
    let i ← 1#i64 <<< rbits
    let i1 ← i - 1#i64
    let rem ← lift (sig &&& i1)
    let i2 ← rbits - 1#u32
    let half ← 1#i64 <<< i2
    if positive
    then if rem >= half
         then q + 1#i64
         else ok q
    else if rem > half
         then q + 1#i64
         else ok q

