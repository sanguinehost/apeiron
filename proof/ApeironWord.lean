  (q : cell.Cell R) (claimed : cell.Cell R) :
  Result (Option (exchange.Exchange R))
  := do
  let c ← exchange.exchange_impulse scalarRingInst p q
  let b ←
    cell.Cell.Insts.CoreCmpPartialEqCell.eq scalarRingInst.corecmpPartialEqInst
      claimed c
