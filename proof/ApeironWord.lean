def error.TensorKey.blk
  (layer : Std.Usize) (part : Std.U8) : Result error.TensorKey := do
  let i ← lift (UScalar.cast .Usize core.num.U32.MAX)
  if layer > i
  then ok { layer := core.num.U32.MAX, part }
  else let l ← lift (UScalar.cast .U32 layer)
       ok { layer := l, part }

