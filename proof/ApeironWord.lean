    Source: '../../src/engine/step/cols.rs', lines 68:4-100:5 -/
def step.cols.Engine.compose_cols
  (self : loader.Engine) (kv : attn.KvState)
  (affine : Option mixer.AffineState) (tokens : Slice Std.U32)
  (sched : step.Sched) (mode : step.KernelMode) (parallel_heads : Bool)
  (snapshot : Option (Slice mixer.AffineLayer)) :
  Result ((core.result.Result (alloc.vec.Vec (alloc.vec.Vec Std.I64))
    step.StepError) × attn.KvState × (Option mixer.AffineState) × (Option
    (Slice mixer.AffineLayer)))
  := do
  let none_state ← mixer.AffineState.empty
  match affine with
  | none =>
    match snapshot with
    | none =>
      let (s, _) ←
        lift (Array.to_slice_mut (Std.Array.empty mixer.AffineLayer))
      let (r, kv1, _, _) ←
        step.cols.Engine.compose_cols_in self kv none_state tokens sched mode
          parallel_heads s
      ok (r, kv1, none, none)
    | some s =>
      let (r, kv1, _, s1) ←
        step.cols.Engine.compose_cols_in self kv none_state tokens sched mode
          parallel_heads s
      ok (r, kv1, none, some s1)
  | some a =>
    match snapshot with
    | none =>
      let (s, _) ←
        lift (Array.to_slice_mut (Std.Array.empty mixer.AffineLayer))
      let (r, kv1, a1, _) ←
        step.cols.Engine.compose_cols_in self kv a tokens sched mode
          parallel_heads s
      ok (r, kv1, some a1, none)
    | some s =>
      let (r, kv1, a1, s1) ←
        step.cols.Engine.compose_cols_in self kv a tokens sched mode
          parallel_heads s
      ok (r, kv1, some a1, some s1)

