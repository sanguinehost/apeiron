import Apeiron.Trichotomy.Basic
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv
import Mathlib.Analysis.SpecialFunctions.Trigonometric.DerivHyp
import Mathlib.Analysis.ODE.ExistUnique
import Mathlib.Analysis.ODE.Gronwall

/-!
# The algebra as grids, and why the sign of σ classifies a flow

@name Quadratic
@cite vattay-2026-reply
@cite lohmiller-slotine-2024
@cite kisil-2010
@cite yaglom-1979
@grade proved

The classical description of a system and its quantum description agree exactly when the
Hamiltonian is at most quadratic in position and momentum, and not otherwise. That is a theorem
rather than a rule of thumb, and `theory/LITERATURE.md` §H carries it with the dispute it came
out of. A system built from at-most-quadratic Hamiltonians therefore sits inside the
window where the two descriptions are one object.

This file says what the trichotomy has to do with that window.

## The chain

A quadratic Hamiltonian in one dimension, `H = p²/2 + ω²x²/2`, has linear equations of motion,
`ẋ = p` and `ṗ = −ω²x`. So the flow is generated by the grid `[[0, 1], [−ω², 0]]`, its trace is
zero, and its determinant is `ω²`. A traceless real grid has eigenvalues `±√(−det)`, so the
determinant's sign decides whether the flow rotates, shears or squeezes, which is the elliptic,
parabolic and hyperbolic classification of one-parameter subgroups.

The algebra meets that classification at the determinant. `rep` sends a point to the grid it
multiplies by, `rep_mul` says that is a ring map, and `det_rep` says **the norm form is the
determinant**. Not an analogue of it, the same function. So the quantity classifying the flow and
the quantity classifying the algebra are one quantity, and `generator_trichotomy` reads the three
cases off the sign of `σ`.

The generator itself is `rep σ (0, 1)` transposed, at `σ = −ω²`, and the determinant does not see
a transpose. That is where the sign convention comes from: it is forced, not chosen.

## What this does not settle

It does not build the flow through `Matrix.exp`. What it does instead is exhibit the three
one-parameter subgroups directly, as the size-one points of each face: the circle below zero with
the angle adding, a line at zero with the shear adding, the hyperbola above zero with the rapidity
adding. `elliptic_one_param`, `parabolic_one_param` and `hyperbolic_one_param` are those three
group laws, and `rep_det_one_iff` says size one is exactly the area-preserving condition. So the
classification is built here rather than cited.

What is still taken from outside is the reading: that the circle is the harmonic oscillator's
flow, the line the free particle's and the hyperbola the inverted one's. That identification runs
through `det_generator`, which fixes `σ = −ω²`, and no dynamics is integrated here to confirm
it.
-/

namespace Apeiron
namespace Physics

open Trichotomy Matrix

/-- The grid a point multiplies by.

    (σ : ℝ) (z : Cell)                   [the parameter and a point]
    : Matrix (Fin 2) (Fin 2) ℝ           [the two-by-two grid multiplying by it]
    Matrix                               [a rectangle of numbers, indexed by row and column]
    Cell                                 [a point: two real numbers written side by side]

    So: the regular representation. Multiplying by `z` is a linear map on a two-dimensional
    space, and this is that map written out on the grid `1` and the generator. -/
def rep (σ : ℝ) (z : Cell) : Matrix (Fin 2) (Fin 2) ℝ :=
  !![z.1, σ * z.2; z.2, z.1]

/-- Representing a product is multiplying the grids.

    (σ : ℝ) (z w : Cell)                              [the parameter and two points]
    rep σ (mul σ z w) = rep σ z * rep σ w             [the representation is a ring map]
    rep                                               [the grid a point multiplies by]
    mul                                               [multiply two points together, the σ way] -/
theorem rep_mul (σ : ℝ) (z w : Cell) :
    rep σ (mul σ z w) = rep σ z * rep σ w := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [rep] <;> ring

/-- The unit represents as the identity grid.

    (σ : ℝ)                              [the parameter]
    rep σ one = 1                        [the unit becomes the grid that changes nothing]
    rep                                  [the grid a point multiplies by]
    one                                  [the point that multiplication leaves alone] -/
theorem rep_one (σ : ℝ) : rep σ one = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [rep]

/-- **The norm form is the determinant.**

    (σ : ℝ) (z : Cell)                        [the parameter and a point]
    (rep σ z).det = normForm σ z              [the grid's determinant is the point's size]
    rep                                       [the grid a point multiplies by]
    normForm                                  [the norm form: a point times its conjugate,
                                               which can come out negative]

    So: the two quantities are one function. The size of a point is what multiplying by it does to
    areas, and that is what places the flow it generates in the elliptic, parabolic or hyperbolic
    class. The corpus was measuring a determinant from the start. -/
theorem det_rep (σ : ℝ) (z : Cell) : (rep σ z).det = normForm σ z := by
  simp only [rep, normForm, Matrix.det_fin_two_of]
  ring

/-- The trace reads the first slot twice.

    (σ : ℝ) (z : Cell)                        [the parameter and a point]
    (rep σ z).trace = 2 * z.1                 [the grid's trace is twice the first slot]
    rep                                       [the grid a point multiplies by] -/
theorem trace_rep (σ : ℝ) (z : Cell) : (rep σ z).trace = 2 * z.1 := by
  simp only [rep, Matrix.trace_fin_two_of]
  ring

/-- A point represents as a traceless grid exactly when its first slot is zero.

    (σ : ℝ) (z : Cell)                        [the parameter and a point]
    (rep σ z).trace = 0                       [the grid is traceless]
    ↔                                         [exactly when]
    z.1 = 0                                   [the point is pure second slot]
    rep                                       [the grid a point multiplies by]

    So: the traceless grids inside the representation are a line, spanned by the generator, and
    a flow generator has to be traceless for the flow to preserve areas. -/
theorem rep_traceless_iff (σ : ℝ) (z : Cell) : (rep σ z).trace = 0 ↔ z.1 = 0 := by
  rw [trace_rep]
  constructor
  · intro h; linarith
  · intro h; rw [h]; ring

/-- The generator's determinant is `σ`, negated and scaled.

    (σ v : ℝ)                                          [σ and a step along the generator]
    (rep σ (0, v)).det = -(σ * v ^ 2)                  [its determinant]
    rep                                                [the grid a point multiplies by]

    So: `H = p²/2 + ω²x²/2` has generator `[[0, 1], [−ω², 0]]`, which is this grid transposed at
    `σ = −ω²` and `v = 1`, and a determinant does not see a transpose. The sign convention is
    forced here rather than chosen. -/
theorem det_generator (σ v : ℝ) : (rep σ ((0 : ℝ), v)).det = -(σ * v ^ 2) := by
  rw [det_rep]
  simp only [normForm]
  ring

/-- The sign of `σ` decides which of the three classes the generator falls in.

    (σ v : ℝ) (hv : v ≠ 0)                             [the parameter and a non-zero step]
    (0 < (rep σ (0, v)).det ↔ σ < 0)                   [rotating exactly below zero]
    ∧ ((rep σ (0, v)).det = 0 ↔ σ = 0)                 [shearing exactly at zero]
    ∧ ((rep σ (0, v)).det < 0 ↔ 0 < σ)                 [squeezing exactly above zero]
    rep                                                [the grid a point multiplies by]
    ≠                                                  [is not equal to]
    ∧                                                  [both are true]
    ↔                                                  [exactly when, in both directions]
    <                                                  [is smaller than]

    So: this is the join. A traceless real grid has eigenvalues `±√(−det)`, so a positive
    determinant gives an imaginary pair and a rotation, zero gives a nilpotent and a shear, and a
    negative determinant gives a real pair and a squeeze. Those three are the elliptic, parabolic
    and hyperbolic one-parameter subgroups, classified in the cited literature by the sign of the
    generator's norm. `det_rep` says that norm is `normForm σ`.

    So the classification of the flow and the classification of the algebra are not two facts that
    agree, they are one quantity read twice. The three values of `σ` are the three
    quadratic Hamiltonians on which the classical and the quantum description coincide exactly:
    below zero the harmonic oscillator, at zero the free particle, above zero the inverted one. -/
theorem generator_trichotomy (σ v : ℝ) (hv : v ≠ 0) :
    (0 < (rep σ ((0 : ℝ), v)).det ↔ σ < 0) ∧
      ((rep σ ((0 : ℝ), v)).det = 0 ↔ σ = 0) ∧
      ((rep σ ((0 : ℝ), v)).det < 0 ↔ 0 < σ) := by
  have hv2 : (0 : ℝ) < v ^ 2 := by positivity
  rw [det_generator]
  refine ⟨?_, ?_, ?_⟩
  · constructor
    · intro h; nlinarith
    · intro h; nlinarith
  · constructor
    · intro h
      have : σ * v ^ 2 = 0 := by linarith
      rcases mul_eq_zero.mp this with h0 | h0
      · exact h0
      · exact absurd h0 (ne_of_gt hv2)
    · intro h; rw [h]; ring
  · constructor
    · intro h; nlinarith
    · intro h; nlinarith


-- ═══════════════════════════════════════════════════════════════════
-- THE UNIT-NORM POINTS ARE THE THREE ONE-PARAMETER SUBGROUPS
-- ═══════════════════════════════════════════════════════════════════

/-- A grid in the representation preserves areas exactly when its point has size one.

    (σ : ℝ) (z : Cell)                        [the parameter and a point]
    (rep σ z).det = 1 ↔ normForm σ z = 1      [area-preserving exactly at size one]
    rep                                       [the grid a point multiplies by]
    normForm                                  [the norm form: a point times its conjugate]
    ↔                                         [exactly when, in both directions]

    So: for one degree of freedom the area-preserving grids are the symplectic ones, and this says
    which points give them. A Gaussian state evolving under a quadratic Hamiltonian moves by one of
    these, and the size being one is the uncertainty relation holding. -/
theorem rep_det_one_iff (σ : ℝ) (z : Cell) : (rep σ z).det = 1 ↔ normForm σ z = 1 := by
  rw [det_rep]

/-- Size one is closed under multiplication.

    (σ : ℝ) {z w : Cell}                              [the parameter and two points]
    (hz : normForm σ z = 1) (hw : normForm σ w = 1)   [both of size one]
    normForm σ (mul σ z w) = 1                        [so is their product]
    normForm                                          [the norm form]
    mul                                               [multiply two points together, the σ way] -/
theorem unitNorm_mul {σ : ℝ} {z w : Cell} (hz : normForm σ z = 1) (hw : normForm σ w = 1) :
    normForm σ (mul σ z w) = 1 := by
  rw [normForm_mul, hz, hw]
  norm_num

/-- Below zero the size-one points are the circle, and multiplying adds the angle.

    (s t : ℝ)                                                     [two angles]
    mul (-1) (Real.cos s, Real.sin s) (Real.cos t, Real.sin t)
      = (Real.cos (s + t), Real.sin (s + t))                      [multiplying adds them]
    mul                                                           [multiply two points, the σ way]
    Real.cos                                                      [how far along a turn goes across]
    Real.sin                                                      [how far along a turn goes up]

    So: the elliptic one-parameter subgroup, built rather than cited. The size-one points below
    zero are the unit circle, the group law is addition of the angle, and the grid is a rotation
    (`rep_elliptic_is_rotation`). This is the harmonic oscillator's flow. -/
theorem elliptic_one_param (s t : ℝ) :
    mul (-1) (Real.cos s, Real.sin s) (Real.cos t, Real.sin t)
      = (Real.cos (s + t), Real.sin (s + t)) := by
  simp only [mul, Real.cos_add, Real.sin_add, Prod.ext_iff]
  constructor <;> ring

/-- Pure elliptic rotors commute, so their multiplication is not an order-sensitive scan.

    (s t : ℝ)                                           [two rotor angles]
    mul (-1) (cos s, sin s) (cos t, sin t)             [multiply in one order]
      = mul (-1) (cos t, sin t) (cos s, sin s)         [equals the reverse order]
    mul                                                 [multiply two points, the σ way]
    Real.cos                                            [the horizontal rotor coordinate]
    Real.sin                                            [the vertical rotor coordinate]

    Both products add their angles by `elliptic_one_param`, and real addition commutes. Any
    order-sensitive rotor scan therefore needs state or a payload action beyond pure rotor
    multiplication. -/
theorem elliptic_rotors_commute (s t : ℝ) :
    mul (-1) (Real.cos s, Real.sin s) (Real.cos t, Real.sin t) =
      mul (-1) (Real.cos t, Real.sin t) (Real.cos s, Real.sin s) := by
  rw [elliptic_one_param, elliptic_one_param, add_comm]

/-- Below zero the circle has size one.

    (t : ℝ)                                              [an angle]
    normForm (-1) (Real.cos t, Real.sin t) = 1           [the point on the circle has size one]
    normForm                                             [the norm form]
    Real.cos                                             [how far along a turn goes across]
    Real.sin                                             [how far along a turn goes up] -/
theorem unitNorm_elliptic (t : ℝ) : normForm (-1) (Real.cos t, Real.sin t) = 1 := by
  simp only [normForm]
  have := Real.sin_sq_add_cos_sq t
  nlinarith [this]

/-- Below zero the grid is a rotation.

    (t : ℝ)                                              [an angle]
    rep (-1) (Real.cos t, Real.sin t)
      = !![Real.cos t, -Real.sin t; Real.sin t, Real.cos t]   [the rotation grid]
    rep                                                  [the grid a point multiplies by]
    Real.cos                                             [how far along a turn goes across]
    Real.sin                                             [how far along a turn goes up] -/
theorem rep_elliptic_is_rotation (t : ℝ) :
    rep (-1) (Real.cos t, Real.sin t)
      = !![Real.cos t, -Real.sin t; Real.sin t, Real.cos t] := by
  simp only [rep]
  norm_num

/-- At zero the size-one points are a line, and multiplying adds along it.

    (s t : ℝ)                                        [two shears]
    mul 0 (1, s) (1, t) = (1, s + t)                 [multiplying adds them]
    mul                                              [multiply two points together, the σ way]

    So: the parabolic one-parameter subgroup. The group law is plain addition, which is why the
    parabolic face is the one where the two channels have collapsed onto each other. This is the
    free particle's flow. -/
theorem parabolic_one_param (s t : ℝ) : mul 0 ((1 : ℝ), s) ((1 : ℝ), t) = ((1 : ℝ), s + t) := by
  simp only [mul, Prod.ext_iff]
  constructor <;> ring

/-- The literal shear line obeys the additive parameter law exactly on the parabolic face.

    (σ : ℝ)                                             [the algebra parameter]
    ∀ s t : ℝ                                           [for every pair of shear parameters]
    mul σ (1, s) (1, t) = (1, s + t)                   [multiplication is literal addition]
    ↔ σ = 0                                             [exactly when, true in both directions]
    mul                                                 [multiply two points, the σ way]

    The reverse direction is `parabolic_one_param`. For the forward direction, the first
    coordinate at `s = t = 1` is `1 + σ`, so closure on the literal line forces `σ = 0`.
    This theorem classifies that embedding, not order-blindness: `mul σ` is commutative for every
    `σ`. -/
theorem shear_additive_iff_parabolic (σ : ℝ) :
    (∀ s t : ℝ, mul σ ((1 : ℝ), s) ((1 : ℝ), t) = ((1 : ℝ), s + t)) ↔ σ = 0 := by
  constructor
  · intro h
    have hfirst := congrArg Prod.fst (h 1 1)
    linarith
  · intro h
    subst σ
    exact parabolic_one_param

/-- At zero those points have size one.

    (v : ℝ)                                  [a shear]
    normForm 0 ((1 : ℝ), v) = 1              [the point has size one]
    normForm                                 [the norm form] -/
theorem unitNorm_parabolic (v : ℝ) : normForm 0 ((1 : ℝ), v) = 1 := by
  simp only [normForm]
  ring

/-- Above zero the size-one points are the hyperbola, and multiplying adds the rapidity.

    (s t : ℝ)                                                         [two rapidities]
    mul 1 (Real.cosh s, Real.sinh s) (Real.cosh t, Real.sinh t)
      = (Real.cosh (s + t), Real.sinh (s + t))                        [multiplying adds them]
    mul                                                               [multiply two points]
    Real.cosh                                                         [the even half of growth]
    Real.sinh                                                         [the odd half of growth]

    So: the hyperbolic one-parameter subgroup. This is the inverted oscillator's flow, and the
    same group law a boost obeys, which is why the split-complex face carries relativity's
    two-dimensional shape. -/
theorem hyperbolic_one_param (s t : ℝ) :
    mul 1 (Real.cosh s, Real.sinh s) (Real.cosh t, Real.sinh t)
      = (Real.cosh (s + t), Real.sinh (s + t)) := by
  simp only [mul, Real.cosh_add, Real.sinh_add, Prod.ext_iff]
  constructor <;> ring

/-- Above zero the hyperbola has size one.

    (t : ℝ)                                                  [a rapidity]
    normForm 1 (Real.cosh t, Real.sinh t) = 1                [the point has size one]
    normForm                                                 [the norm form]
    Real.cosh                                                [the even half of growth]
    Real.sinh                                                [the odd half of growth] -/
theorem unitNorm_hyperbolic (t : ℝ) : normForm 1 (Real.cosh t, Real.sinh t) = 1 := by
  simp only [normForm]
  have := Real.cosh_sq_sub_sinh_sq t
  nlinarith [this]


-- ═══════════════════════════════════════════════════════════════════
-- WHAT A TURNED SCORE CAN SEE
-- ═══════════════════════════════════════════════════════════════════

/-- Turning by an angle.

    (t : ℝ)                     [an angle]
    : Cell                      [the point on the unit circle at that angle]
    Real.cos                    [how far along a turn goes across]
    Real.sin                    [how far along a turn goes up]

    So: the size-one point of the elliptic face at parameter `t`. `elliptic_one_param` says these
    compose by adding the angle, so they are the rotation subgroup written in the algebra. -/
noncomputable def rot (t : ℝ) : Cell := (Real.cos t, Real.sin t)

/-- Turning back undoes turning.

    (t : ℝ)                                  [an angle]
    mul (-1) (rot (-t)) (rot t) = one        [turning back then forward changes nothing]
    mul                                      [multiply two points together, the σ way]
    rot                                      [the point on the unit circle at that angle]
    one                                      [the point that multiplication leaves alone] -/
theorem rot_neg_mul (t : ℝ) : mul (-1) (rot (-t)) (rot t) = one := by
  rw [rot, rot, elliptic_one_param]
  simp [Trichotomy.one]

/-- **A turned score sees only the gap between the turns.**

    (s t : ℝ) (q k : Cell)                                    [two angles and two points]
    form (-1) (mul (-1) (rot s) q) (mul (-1) (rot t) k)       [turn each, then measure the pull]
    = form (-1) q (mul (-1) (rot (t - s)) k)                  [the same as turning one, by the gap]
    form                                                      [how much two points pull on each
                                                               other, measured the σ way]
    mul                                                       [multiply two points, the σ way]
    rot                                                       [the point on the unit circle]

    So: turning both arguments by absolute angles leaves a score that depends on the difference
    alone. This is what a rotary position embedding is for, and it rests on two facts from this
    corpus: `form_mul` says multiplying both arguments scales the pull by the
    multiplier's size, and the size here is one, so it is an isometry; `elliptic_one_param` says
    the turns compose by adding.

    The predecessor states the same thing at `../sanguine-ref`'s
    `Substrate/Algebra/Neural/RopeRelative.lean`, whose title is that only the gap is seen. It is
    re-derived here from the σ-parametrized construction rather than ported. `form_mul` holds at
    every setting, and only the identification of the size-one points with turns is elliptic. -/
theorem score_sees_only_the_gap (s t : ℝ) (q k : Cell) :
    form (-1) (mul (-1) (rot s) q) (mul (-1) (rot t) k)
      = form (-1) q (mul (-1) (rot (t - s)) k) := by
  have hkey := form_mul (-1) (rot (-s)) (mul (-1) (rot s) q) (mul (-1) (rot t) k)
  rw [← Trichotomy.mul_assoc, ← Trichotomy.mul_assoc, rot_neg_mul, Trichotomy.one_mul] at hkey
  rw [rot, rot, elliptic_one_param] at hkey
  have hnorm : normForm (-1) (rot (-s)) = 1 := unitNorm_elliptic (-s)
  rw [rot] at hnorm
  rw [hnorm, _root_.one_mul] at hkey
  simp only [rot] at hkey ⊢
  rw [show t - s = -s + t by ring]
  exact hkey.symm

-- ═══════════════════════════════════════════════════════════════════
-- THE FLOW: ONE FUNCTION SOLVING THE GENERATOR'S EQUATION OF MOTION,
-- AND THE ONLY ONE THAT DOES (ROADMAP A2, `flow_is_one_param`)
-- ═══════════════════════════════════════════════════════════════════

/-- The size-one point of σ's face, at parameter `t`: the three group laws above,
    `elliptic_one_param`, `parabolic_one_param` and `hyperbolic_one_param`, read as three
    branches of one function of `σ` rather than three separate constructions.

    (σ t : ℝ)                            [the parameter and how far along the flow]
    : Cell                               [the point the flow has reached]
    Real.sqrt                            [the number that squares to give this]

    So: below zero this turns on the circle, at zero it shears along the line, above zero it
    runs out along the hyperbola. -/
noncomputable def flowPoint (σ t : ℝ) : Cell :=
  if σ < 0 then
    (Real.cos (Real.sqrt (-σ) * t), Real.sin (Real.sqrt (-σ) * t) / Real.sqrt (-σ))
  else if 0 < σ then
    (Real.cosh (Real.sqrt σ * t), Real.sinh (Real.sqrt σ * t) / Real.sqrt σ)
  else ((1 : ℝ), t)

/-- Below zero `flowPoint` unfolds to the circle.

    {σ : ℝ} (hσ : σ < 0) (t : ℝ)                                    [σ below zero, a time]
    flowPoint σ t = (Real.cos (Real.sqrt (-σ) * t),
      Real.sin (Real.sqrt (-σ) * t) / Real.sqrt (-σ))                [the point on the circle]
    Real.sqrt                                                     [the number that squares to
                                                                    this] -/
theorem flowPoint_neg {σ : ℝ} (hσ : σ < 0) (t : ℝ) :
    flowPoint σ t
      = (Real.cos (Real.sqrt (-σ) * t), Real.sin (Real.sqrt (-σ) * t) / Real.sqrt (-σ)) := by
  unfold flowPoint; rw [if_pos hσ]

/-- At zero `flowPoint` unfolds to the shear line.

    (t : ℝ)                              [a time]
    flowPoint 0 t = ((1 : ℝ), t)         [the point on the shear line] -/
theorem flowPoint_at_zero (t : ℝ) : flowPoint 0 t = ((1 : ℝ), t) := by
  unfold flowPoint; rw [if_neg (lt_irrefl (0:ℝ)), if_neg (lt_irrefl (0:ℝ))]

/-- Above zero `flowPoint` unfolds to the hyperbola.

    {σ : ℝ} (hσ : 0 < σ) (t : ℝ)                                    [σ above zero, a time]
    flowPoint σ t = (Real.cosh (Real.sqrt σ * t),
      Real.sinh (Real.sqrt σ * t) / Real.sqrt σ)                     [the point on the hyperbola]
    Real.sqrt                                                     [the number that squares to
                                                                    this] -/
theorem flowPoint_pos {σ : ℝ} (hσ : 0 < σ) (t : ℝ) :
    flowPoint σ t = (Real.cosh (Real.sqrt σ * t), Real.sinh (Real.sqrt σ * t) / Real.sqrt σ) := by
  unfold flowPoint; rw [if_neg (not_lt.mpr hσ.le), if_pos hσ]

/-- Below zero `flowPoint` is `rot`.

    (t : ℝ)                              [an angle]
    flowPoint (-1) t = rot t             [the two constructions agree at the standard setting]
    rot                                  [the point on the unit circle at that angle] -/
theorem flowPoint_neg_one (t : ℝ) : flowPoint (-1) t = rot t := by
  rw [flowPoint_neg (by norm_num : (-1:ℝ) < 0)]
  norm_num [rot]

/-- The flow's first coordinate obeys its own half of the generator's equation.

    (σ t : ℝ)                                                      [the parameter and a time]
    HasDerivAt (fun u => (flowPoint σ u).1)
      (mul σ (flowPoint σ t) ((0:ℝ),(1:ℝ))).1 t                    [its rate of change]
    HasDerivAt                                                     [is changing at that rate]
    mul                                                            [multiply two points, the σ
                                                                    way] -/
theorem hasDerivAt_flowPoint_fst (σ t : ℝ) :
    HasDerivAt (fun u => (flowPoint σ u).1) (mul σ (flowPoint σ t) ((0 : ℝ), (1 : ℝ))).1 t := by
  rcases lt_trichotomy σ 0 with h | h | h
  · have hpos : (0 : ℝ) < -σ := by linarith
    have hsq : Real.sqrt (-σ) ^ 2 = -σ := Real.sq_sqrt hpos.le
    have hne : Real.sqrt (-σ) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hpos)
    have hin : HasDerivAt (fun u : ℝ => Real.sqrt (-σ) * u) (Real.sqrt (-σ)) t := by
      simpa using (hasDerivAt_id t).const_mul (Real.sqrt (-σ))
    have hc := (Real.hasDerivAt_cos (Real.sqrt (-σ) * t)).comp t hin
    have hval : (mul σ (flowPoint σ t) ((0 : ℝ), (1 : ℝ))).1
        = -(Real.sin (Real.sqrt (-σ) * t) * Real.sqrt (-σ)) := by
      rw [flowPoint_neg h]
      simp only
      field_simp
      linear_combination Real.sin (Real.sqrt (-σ) * t) * hsq
    rw [hval, show (fun u => (flowPoint σ u).1) = (fun u => Real.cos (Real.sqrt (-σ) * u)) from
      funext fun u => congrArg Prod.fst (flowPoint_neg h u)]
    convert hc using 1 <;> first | rfl | simp
  · subst h
    have heq : (fun u : ℝ => (flowPoint 0 u).1) = fun _ : ℝ => (1 : ℝ) :=
      funext fun u => congrArg Prod.fst (flowPoint_at_zero u)
    rw [heq, flowPoint_at_zero]
    simpa [mul] using hasDerivAt_const t (1 : ℝ)
  · have hsq : Real.sqrt σ ^ 2 = σ := Real.sq_sqrt h.le
    have hne : Real.sqrt σ ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr h)
    have hin : HasDerivAt (fun u : ℝ => Real.sqrt σ * u) (Real.sqrt σ) t := by
      simpa using (hasDerivAt_id t).const_mul (Real.sqrt σ)
    have hc := (Real.hasDerivAt_cosh (Real.sqrt σ * t)).comp t hin
    have hval : (mul σ (flowPoint σ t) ((0 : ℝ), (1 : ℝ))).1
        = Real.sinh (Real.sqrt σ * t) * Real.sqrt σ := by
      rw [flowPoint_pos h]
      simp only
      field_simp
      linear_combination (-Real.sinh (Real.sqrt σ * t)) * hsq
    rw [hval, show (fun u => (flowPoint σ u).1) = (fun u => Real.cosh (Real.sqrt σ * u)) from
      funext fun u => congrArg Prod.fst (flowPoint_pos h u)]
    convert hc using 1 <;> rfl

/-- The flow's second coordinate obeys its own half of the generator's equation.

    (σ t : ℝ)                                                      [the parameter and a time]
    HasDerivAt (fun u => (flowPoint σ u).2)
      (mul σ (flowPoint σ t) ((0:ℝ),(1:ℝ))).2 t                    [its rate of change]
    HasDerivAt                                                     [is changing at that rate]
    mul                                                            [multiply two points, the σ
                                                                    way] -/
theorem hasDerivAt_flowPoint_snd (σ t : ℝ) :
    HasDerivAt (fun u => (flowPoint σ u).2) (mul σ (flowPoint σ t) ((0 : ℝ), (1 : ℝ))).2 t := by
  rcases lt_trichotomy σ 0 with h | h | h
  · have hpos : (0 : ℝ) < -σ := by linarith
    have hne : Real.sqrt (-σ) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hpos)
    have hin : HasDerivAt (fun u : ℝ => Real.sqrt (-σ) * u) (Real.sqrt (-σ)) t := by
      simpa using (hasDerivAt_id t).const_mul (Real.sqrt (-σ))
    have hs := ((Real.hasDerivAt_sin (Real.sqrt (-σ) * t)).comp t hin).div_const (Real.sqrt (-σ))
    have hval : (mul σ (flowPoint σ t) ((0 : ℝ), (1 : ℝ))).2 = Real.cos (Real.sqrt (-σ) * t) := by
      rw [flowPoint_neg h]; simp only; ring
    rw [hval, show (fun u => (flowPoint σ u).2)
        = (fun u => Real.sin (Real.sqrt (-σ) * u) / Real.sqrt (-σ)) from
      funext fun u => congrArg Prod.snd (flowPoint_neg h u)]
    have hfinal : Real.cos (Real.sqrt (-σ) * t)
        = Real.cos (Real.sqrt (-σ) * t) * Real.sqrt (-σ) / Real.sqrt (-σ) := by field_simp
    rw [hfinal]
    simpa [Function.comp] using hs
  · subst h
    have heq : (fun u : ℝ => (flowPoint 0 u).2) = fun u : ℝ => u :=
      funext fun u => congrArg Prod.snd (flowPoint_at_zero u)
    rw [heq, flowPoint_at_zero]
    convert hasDerivAt_id t using 1 <;> first | rfl | simp
  · have hne : Real.sqrt σ ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr h)
    have hin : HasDerivAt (fun u : ℝ => Real.sqrt σ * u) (Real.sqrt σ) t := by
      simpa using (hasDerivAt_id t).const_mul (Real.sqrt σ)
    have hs := ((Real.hasDerivAt_sinh (Real.sqrt σ * t)).comp t hin).div_const (Real.sqrt σ)
    have hval : (mul σ (flowPoint σ t) ((0 : ℝ), (1 : ℝ))).2 = Real.cosh (Real.sqrt σ * t) := by
      rw [flowPoint_pos h]; simp only; ring
    rw [hval, show (fun u => (flowPoint σ u).2)
        = (fun u => Real.sinh (Real.sqrt σ * u) / Real.sqrt σ) from
      funext fun u => congrArg Prod.snd (flowPoint_pos h u)]
    have hfinal : Real.cosh (Real.sqrt σ * t)
        = Real.cosh (Real.sqrt σ * t) * Real.sqrt σ / Real.sqrt σ := by field_simp
    rw [hfinal]
    simpa [Function.comp] using hs

/-- **The flow's own velocity is itself multiplied by the generator, at every value of σ.**

    (σ t : ℝ)                                                  [the parameter and a time]
    HasDerivAt (flowPoint σ) (mul σ (flowPoint σ t) ((0:ℝ),(1:ℝ))) t
                                                                [the rate of change]
    HasDerivAt                                                 [is changing at that rate]
    mul                                                        [multiply two points, the σ way]

    So: the flow solves `z' = z · x` with `x = (0,1)` the generator, one theorem read at the
    three values of `σ`: `cos² + sin² = 1`'s derivative pair below zero, the trivial
    `(1,t)' = (0,1)` at zero, `cosh² − sinh² = 1`'s pair above zero. -/
theorem hasDerivAt_flowPoint (σ t : ℝ) :
    HasDerivAt (flowPoint σ) (mul σ (flowPoint σ t) ((0 : ℝ), (1 : ℝ))) t := by
  have h1 := hasDerivAt_flowPoint_fst σ t
  have h2 := hasDerivAt_flowPoint_snd σ t
  exact h1.prodMk h2

/-- **The generator's linear equation of motion, solved.** Multiplying by `flowPoint σ t` moves
    any starting point `x0` along the flow, and that motion satisfies `x' = (0,1) · x` at every
    time.

    (σ : ℝ) (x0 : Cell) (t : ℝ)                              [σ, a starting point, a time]
    HasDerivAt (fun u => mul σ (flowPoint σ u) x0)
      (mul σ ((0:ℝ),(1:ℝ)) (mul σ (flowPoint σ t) x0)) t        [the state's own rate of change
                                                                is the generator acting on the
                                                                current state]
    Cell                                                       [a point: two reals side by side]
    HasDerivAt                                                 [is changing at that rate]
    mul                                                        [multiply two points, the σ way]
    `ℝ` [the real numbers: every number on the number line]
    `σ` [the parameter; its sign decides the algebra: below zero, zero, or above]

    So: `x(t) = flowPoint σ t · x0` solves `x' = A·x` for the generator `A = rep σ (0,1)`, since
    `rep σ z *ᵥ x0 = mul σ z x0` (`rep`'s own definition), read on the point rather than on the
    grid. -/
theorem flow_is_one_param (σ : ℝ) (x0 : Cell) (t : ℝ) :
    HasDerivAt (fun u => mul σ (flowPoint σ u) x0)
      (mul σ ((0 : ℝ), (1 : ℝ)) (mul σ (flowPoint σ t) x0)) t := by
  have hc := hasDerivAt_flowPoint_fst σ t
  have hs := hasDerivAt_flowPoint_snd σ t
  have h1 : HasDerivAt (fun u => (flowPoint σ u).1 * x0.1 + σ * (flowPoint σ u).2 * x0.2)
      (mul σ ((0 : ℝ), (1 : ℝ)) (mul σ (flowPoint σ t) x0)).1 t := by
    have hd := (hc.mul_const x0.1).add ((hs.const_mul σ).mul_const x0.2)
    convert hd using 1 <;> first | rfl | (simp only; ring)
  have h2 : HasDerivAt (fun u => (flowPoint σ u).1 * x0.2 + (flowPoint σ u).2 * x0.1)
      (mul σ ((0 : ℝ), (1 : ℝ)) (mul σ (flowPoint σ t) x0)).2 t := by
    have hd := (hc.mul_const x0.2).add (hs.mul_const x0.1)
    convert hd using 1 <;> first | rfl | (simp only; ring)
  exact h1.prodMk h2

open scoped NNReal in
/-- The generator acts as a Lipschitz map: `mul σ (0,1)` is bounded, uniformly, so the ODE it
    generates has a well-posed uniqueness theory.

    (σ : ℝ)                                                    [the parameter]
    ∃ K : ℝ≥0, LipschitzWith K (mul σ ((0:ℝ),(1:ℝ)))           [some Lipschitz constant bounds
                                                                the generator's own action]
    Cell                                                       [a point: two reals side by side]
    `∃` [there is at least one]
    `mul` [multiply two points together, the σ way]

    So: `mul σ (0,1)` is linear on a finite-dimensional space and every linear map there is
    bounded; the bound exhibited here, `1 + |σ|`, is not claimed sharp. -/
theorem generator_lipschitz (σ : ℝ) :
    ∃ K : ℝ≥0, LipschitzWith K (fun x : Cell => mul σ ((0 : ℝ), (1 : ℝ)) x) := by
  refine ⟨(1 + |σ|).toNNReal, ?_⟩
  have h := LipschitzWith.of_dist_le' (K := 1 + |σ|)
    (f := fun x : Cell => mul σ ((0 : ℝ), (1 : ℝ)) x) fun x y => by
      simp only [mul, Prod.dist_eq, Real.dist_eq]
      have hfst : (0 : ℝ) * x.1 + σ * 1 * x.2 - (0 * y.1 + σ * 1 * y.2) = σ * (x.2 - y.2) := by
        ring
      have hsnd : (0 : ℝ) * x.2 + 1 * x.1 - (0 * y.2 + 1 * y.1) = x.1 - y.1 := by ring
      rw [hfst, hsnd, abs_mul]
      set M := max |x.1 - y.1| |x.2 - y.2| with hM
      have hMnonneg : (0 : ℝ) ≤ M := le_trans (abs_nonneg (x.1 - y.1)) (le_max_left _ _)
      have hle1 : |σ| * |x.2 - y.2| ≤ (1 + |σ|) * M := by
        calc |σ| * |x.2 - y.2| ≤ |σ| * M :=
              mul_le_mul_of_nonneg_left (le_max_right _ _) (abs_nonneg σ)
          _ ≤ (1 + |σ|) * M := by nlinarith [hMnonneg]
      have hle2 : |x.1 - y.1| ≤ (1 + |σ|) * M := by
        calc |x.1 - y.1| ≤ M := le_max_left _ _
          _ ≤ (1 + |σ|) * M := by nlinarith [hMnonneg, abs_nonneg σ]
      exact max_le hle1 hle2
  simpa using h

/-- **The solution through `x0` is the only one: ROADMAP A2's `flow_is_one_param`, closed.**
    Any curve solving the same generator's equation of motion and starting where the flow
    starts IS the flow: `flow_is_one_param` gives existence, and Mathlib's Gronwall-based ODE
    uniqueness (`ODE_solution_unique_univ`) gives that it is the only one, at every value of
    `σ`.

    (σ : ℝ) (x0 : Cell) (g : ℝ → Cell)                     [σ, a starting point, a candidate curve]
    (hg : ∀ t, HasDerivAt g (mul σ ((0:ℝ),(1:ℝ)) (g t)) t)      [it solves the same equation of
                                                                motion everywhere]
    (h0 : g 0 = x0)                                             [and starts at `x0`]
    g = fun t => mul σ (flowPoint σ t) x0                       [it is exactly the flow]

    Cell                                                        [a point: two reals side by side]
    HasDerivAt                                                  [is changing at that rate]
    mul                                                         [multiply two points, the σ way]
    `ℝ` [the real numbers: every number on the number line]
    `∀` [for every single one]
    `→` [if the left holds so does the right]

    So: the circle below zero, the line at zero and the hyperbola above zero are not just A
    solution the algebra happens to exhibit at each face, each is THE solution, and the reading
    `Quadratic.lean`'s own header left outside its theorems, that the circle is the harmonic
    oscillator's flow and the hyperbola the inverted one's, is now inside one: the unique curve
    through any starting point that obeys the generator's equation of motion is `flowPoint`
    acting on it. -/
theorem flow_is_one_param_unique (σ : ℝ) (x0 : Cell) (g : ℝ → Cell)
    (hg : ∀ t, HasDerivAt g (mul σ ((0 : ℝ), (1 : ℝ)) (g t)) t) (h0 : g 0 = x0) :
    g = fun t => mul σ (flowPoint σ t) x0 := by
  obtain ⟨K, hK⟩ := generator_lipschitz σ
  have hflow0 : mul σ (flowPoint σ (0:ℝ)) x0 = x0 := by
    rcases lt_trichotomy σ 0 with h | h | h
    · rw [flowPoint_neg h]; norm_num [Trichotomy.mul, Trichotomy.one_mul]
    · rw [h, flowPoint_at_zero]; norm_num [Trichotomy.mul, Trichotomy.one_mul]
    · rw [flowPoint_pos h]; norm_num [Trichotomy.mul, Trichotomy.one_mul]
  apply ODE_solution_unique_univ (v := fun _ x => mul σ ((0 : ℝ), (1 : ℝ)) x)
    (s := fun _ => Set.univ) (K := K) (t₀ := (0 : ℝ))
    (fun _ => lipschitzOnWith_univ.2 hK)
    (fun t => ⟨hg t, Set.mem_univ _⟩)
    (fun t => ⟨flow_is_one_param σ x0 t, Set.mem_univ _⟩)
  rw [h0, hflow0]

-- ═══════════════════════════════════════════════════════════════════
-- THE RING CORRESPONDENCE: RING AFFINE STEPS AS MATRIX AFFINE STEPS
-- ═══════════════════════════════════════════════════════════════════

section RingMatrixCorrespondence

variable {R : Type*} [CommRing R]

/-- The grid a ring point multiplies by.

    (σ : R) (z : AnyRing.RingCell R)   [the parameter and a point over the ring]
    : Matrix (Fin 2) (Fin 2) R         [the two-by-two grid multiplying by it]
    σ                                  [the parameter: what the adjoined direction squares to]
    Matrix                             [a rectangle of numbers, indexed by row and column]

    So: the regular representation over the ring, the grid `rep` with the reals replaced by
    `R`. -/
def ringRep (σ : R) (z : AnyRing.RingCell R) : Matrix (Fin 2) (Fin 2) R :=
  !![z.1, σ * z.2; z.2, z.1]

/-- The two slots of a ring point as a column vector.

    (z : AnyRing.RingCell R)   [the point]
    : Fin 2 → R                [its two slots as a column vector]
    →                          [takes the left and gives the right]

    So: the pair read as `![z.1, z.2]`, the vector the matrix affine step acts on. -/
def cellVec (z : AnyRing.RingCell R) : Fin 2 → R := ![z.1, z.2]

/-- A ring affine step read as a matrix affine step.

    (σ : R) (s : AnyRing.RingAffineStep R)   [the parameter and the ring step]
    : AnyRing.MatrixAffineStep (Fin 2) R     [the grid and vector step it becomes]
    σ                                        [the parameter: what the adjoined direction
                                              squares to]

    So: the coefficient becomes `ringRep σ s.coefficient` and the injection becomes
    `cellVec s.injection`. -/
def toMatrixStep (σ : R) (s : AnyRing.RingAffineStep R) :
    AnyRing.MatrixAffineStep (Fin 2) R :=
  ⟨ringRep σ s.coefficient, cellVec s.injection⟩

/-- Representing a ring product is multiplying the grids.

    (σ : R) (z w : AnyRing.RingCell R)   [the parameter and two ring points]
    ringRep σ (AnyRing.ringMul σ z w) = ringRep σ z * ringRep σ w   [the map is multiplicative]
    σ                                    [the parameter: what the adjoined direction squares to]
    ringRep                              [the grid a ring point multiplies by]

    So: `rep_mul` with the reals replaced by `R`, proved the same way. -/
theorem ringRep_mul (σ : R) (z w : AnyRing.RingCell R) :
    ringRep σ (AnyRing.ringMul σ z w) = ringRep σ z * ringRep σ w := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [ringRep] <;> ring

/-- Applying a ring step is applying its grid step to the point's vector.

    (σ : R) (s : AnyRing.RingAffineStep R) (z : AnyRing.RingCell R)   [the parameter, a ring
                                                                        step, and a ring point]
    AnyRing.matrixAffine ⟨ringRep σ s.coefficient, cellVec s.injection⟩ (cellVec z)
      = cellVec (AnyRing.ringAffineApply σ s z)                        [the readings agree]
    σ                                                                  [the parameter: what the
                                                                         adjoined direction
                                                                         squares to]
    matrixAffine                                                       [the grid and vector step
                                                                         applied to a vector]
    ringAffineApply                                                    [multiply by the ring
                                                                         coefficient, then add the
                                                                         injection]

    So: the affine action on ring points is the matrix affine action on their vectors. -/
theorem matrixStep_apply (σ : R) (s : AnyRing.RingAffineStep R) (z : AnyRing.RingCell R) :
    AnyRing.matrixAffine ⟨ringRep σ s.coefficient, cellVec s.injection⟩ (cellVec z) =
      cellVec (AnyRing.ringAffineApply σ s z) := by
  cases s with | mk c i =>
  ext k
  fin_cases k <;>
    simp [AnyRing.matrixAffine, ringRep, cellVec, AnyRing.ringAffineApply, AnyRing.ringMul] <;>
      ring

/-- Reading a composed ring step is composing the two read steps.

    (σ : R) (outer inner : AnyRing.RingAffineStep R)   [the parameter and the two ring steps]
    toMatrixStep σ (AnyRing.ringAffineCompose σ outer inner)
      = AnyRing.matrixStepComp (toMatrixStep σ outer) (toMatrixStep σ inner)
                                                       [composition is preserved]
    σ                                                  [the parameter: what the adjoined
                                                        direction squares to]
    toMatrixStep                                       [a ring step read as a grid and vector
                                                        step]
    ringAffineCompose                                  [apply the inner ring step, then the outer]
    matrixStepComp                                     [apply the inner grid step, then the outer]

    So: `toMatrixStep` carries `ringAffineCompose` to `matrixStepComp`, so the ring step monoid
    maps into the matrix step monoid. -/
theorem matrixStep_comp (σ : R) (outer inner : AnyRing.RingAffineStep R) :
    toMatrixStep σ (AnyRing.ringAffineCompose σ outer inner) =
      AnyRing.matrixStepComp (toMatrixStep σ outer) (toMatrixStep σ inner) := by
  cases outer with | mk oc oi =>
  cases inner with | mk ic ii =>
  simp only [toMatrixStep, AnyRing.ringAffineCompose, AnyRing.matrixStepComp,
    AnyRing.MatrixAffineStep.mk.injEq]
  constructor
  · exact ringRep_mul σ oc ic
  · simpa only [AnyRing.matrixAffine, AnyRing.ringAffineApply] using
      (matrixStep_apply σ ⟨oc, oi⟩ ii).symm

/-- At the reals the ring representation is the existing real representation.

    (σ : ℝ) (z : Cell)        [the parameter and a real point]
    ringRep σ z = rep σ z     [the two grids are the same]
    σ                         [the parameter: what the adjoined direction squares to]
    ringRep                   [the grid a ring point multiplies by]
    rep                       [the grid a real point multiplies by]

    So: `ringRep` at `ℝ` is `rep`, by definition. No existing declaration changes. -/
theorem ringRep_real_eq_rep (σ : ℝ) (z : Cell) : ringRep σ z = rep σ z := rfl

end RingMatrixCorrespondence

end Physics
end Apeiron
