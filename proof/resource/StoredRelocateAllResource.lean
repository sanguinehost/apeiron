namespace StoredRelocateAllResource
open Aeneas Aeneas.Std Result LoopTrace stored_relocate_all_source

/-- The carried key word at the stored face. -/
abbrev Key := table.keyrep.Stored Std.I64
/-- The table instance the extraction root instantiates. -/
abbrev Tbl := table.Table Std.I64 Std.I64 table.WordHome Key 16#usize
/-- The reserved storage the extraction root instantiates. -/
abbrev Resv := table.RebuildReserved Key Std.I64
/-- The real `Clone<i64>` instance the root passes for both key and value. -/
abbrev CI := core.clone.CloneI64
/-- The real `Home<WordHome, i64>` instance the root passes. -/
abbrev HI := table.WordHome.Insts.Stored_relocate_all_sourceTableHomeI64Sigma
/-- The real `KeyRep<Stored<i64>, i64, WordHome>` instance the root passes. -/
abbrev KI :=
  table.keyrep.Stored.Insts.Stored_relocate_all_sourceTableKeyrepKeyRep
    I64.Insts.Stored_relocate_all_sourceCoordLocatorLocator_coreExactIdentityU64Tuple
    core.clone.CloneI64
    table.WordHome.Insts.Stored_relocate_all_sourceTableHomeI64Sigma
/-- The state `Table::relocate_all` carries: table, reserved storage, and the plan cursor. -/
abbrev St := Tbl × Resv × Std.Usize

/-- The actual relocation transition of `Table::relocate_all`, at the root's instantiation. -/
def step (plan : table.RebuildPlan) : St → Result (ControlFlow St (Tbl × Resv)) :=
  fun st => table.Table.relocate_all_loop.body CI CI HI KI plan st.1 st.2.1 st.2.2

/-- The number of planned entries the transition is walking. -/
def planLen (plan : table.RebuildPlan) : Nat := plan.entries.val.length

/-- The extraction root forwards to the real `Table::relocate_all` body; the root restates no
    traversal. -/
theorem root_forwards (state : Tbl) (plan : table.RebuildPlan) (reserved : Resv) :
    stored_relocate_all_source.word_stored_relocate_all state plan reserved =
      table.Table.relocate_all CI CI HI KI state plan reserved := rfl

/-- `Table::relocate_all` is the relocation loop started at cursor `0`. -/
theorem relocate_all_is_loop_at_zero (state : Tbl) (plan : table.RebuildPlan) (reserved : Resv) :
    table.Table.relocate_all CI CI HI KI state plan reserved =
      table.Table.relocate_all_loop CI CI HI KI state plan reserved 0#usize := rfl

/-- The guard of the traversal reads the planned entry count. -/
theorem len_is_entries_length (plan : table.RebuildPlan) :
    (alloc.vec.Vec.len plan.entries).val = planLen plan := alloc.vec.Vec.len_val plan.entries

private theorem guard_iff (plan : table.RebuildPlan) (st : St) :
    st.2.2 < alloc.vec.Vec.len plan.entries ↔ st.2.2.val < planLen plan := by
  constructor
  · intro h
    simpa only [len_is_entries_length] using
      (UScalar.lt_equiv st.2.2 (alloc.vec.Vec.len plan.entries)).1 h
  · intro h
    apply (UScalar.lt_equiv st.2.2 (alloc.vec.Vec.len plan.entries)).2
    simpa only [len_is_entries_length] using h

/-! ## The relocation transition, with its guard -/

/-- **The relocation step.** Under the guard `entry_at < plan.entries.len` and a successful
    per-entry relocation, the transition returns the continuation carrying the relocated table and
    reserved storage with the cursor advanced by exactly one, and the rank
    `plan.entries.len - entry_at` falls by exactly one. -/
theorem relocate_step (plan : table.RebuildPlan) (st : St) (self' : Tbl) (reserved' : Resv)
    (hguard : st.2.2.val < planLen plan)
    (hentry : table.Table.relocate_entry CI CI HI KI st.1 plan st.2.1 st.2.2 =
      ok (self', reserved')) :
    ∃ (st' : St),
      step plan st = ok (ControlFlow.cont st') ∧
      st'.1 = self' ∧ st'.2.1 = reserved' ∧ st'.2.2.val = st.2.2.val + 1 ∧
      planLen plan - st'.2.2.val < planLen plan - st.2.2.val ∧
      planLen plan - st'.2.2.val + 1 = planLen plan - st.2.2.val := by
  have hlt : st.2.2 < alloc.vec.Vec.len plan.entries := (guard_iff plan st).2 hguard
  have h1 : (1#usize).val = 1 := by decide
  have hmax : st.2.2.val + 1 ≤ Std.Usize.max := by
    have hle := alloc.vec.Vec.len_ineq plan.entries
    have hle' : planLen plan ≤ Std.Usize.max := by
      simpa only [planLen, len_is_entries_length] using hle
    omega
  obtain ⟨entry_at1, hadd, hat1⟩ := WP.spec_imp_exists
    (Std.Usize.add_spec (x := st.2.2) (y := 1#usize) hmax)
  have hat1' : entry_at1.val = st.2.2.val + 1 := by rw [hat1, h1]
  have hstep : step plan st = ok (ControlFlow.cont (self', reserved', entry_at1)) := by
    show table.Table.relocate_all_loop.body CI CI HI KI plan st.1 st.2.1 st.2.2 =
      ok (ControlFlow.cont (self', reserved', entry_at1))
    rw [table.Table.relocate_all_loop.body, if_pos hlt]
    simp only [hentry, hadd, bind_tc_ok]
    rfl
  refine ⟨(self', reserved', entry_at1), hstep, rfl, rfl, ?_, ?_, ?_⟩
  · exact hat1'
  · show planLen plan - entry_at1.val < planLen plan - st.2.2.val
    omega
  · show planLen plan - entry_at1.val + 1 = planLen plan - st.2.2.val
    omega

/-- **The loop exit.** At or past the planned entry count the transition returns the table and the
    reserved storage unchanged, moving no entry and copying no word. -/
theorem relocate_exit (plan : table.RebuildPlan) (st : St)
    (hexit : ¬ st.2.2.val < planLen plan) :
    step plan st = ok (ControlFlow.done (st.1, st.2.1)) := by
  have hlt : ¬ st.2.2 < alloc.vec.Vec.len plan.entries := fun h => hexit ((guard_iff plan st).1 h)
  show table.Table.relocate_all_loop.body CI CI HI KI plan st.1 st.2.1 st.2.2 =
    ok (ControlFlow.done (st.1, st.2.1))
  rw [table.Table.relocate_all_loop.body, if_neg hlt]

/-- **The refusal branch.** `Table::relocate_entry` can refuse: it indexes the plan and the source
    storage (`Vec.index`, failing `arrayOutOfBounds` off the end) and takes the `SpillSite.Found` and
    `SpillSite.Grow` arms to `unreachable!` (`fail panic`). Under the guard the transition
    propagates that refusal unchanged, moving no entry. -/
theorem relocate_refusal (plan : table.RebuildPlan) (st : St) (e : Error)
    (hguard : st.2.2.val < planLen plan)
    (hentry : table.Table.relocate_entry CI CI HI KI st.1 plan st.2.1 st.2.2 = fail e) :
    step plan st = fail e := by
  have hlt : st.2.2 < alloc.vec.Vec.len plan.entries := (guard_iff plan st).2 hguard
  show table.Table.relocate_all_loop.body CI CI HI KI plan st.1 st.2.1 st.2.2 = fail e
  rw [table.Table.relocate_all_loop.body, if_pos hlt, hentry]
  simp

/-- The two outcomes of the transition are exclusive: it cannot both move an entry and refuse. -/
theorem step_exclusive (plan : table.RebuildPlan) (st : St) (st' : St) (e : Error) :
    ¬ (step plan st = ok (ControlFlow.cont st') ∧
       step plan st = (fail e : Result (ControlFlow St (Tbl × Resv)))) :=
  fun ⟨h1, h2⟩ => ok_not_fail (h1.symm.trans h2)

/-- A refusal is reachable exactly when the guard holds and the per-entry core refuses: on those
    two premises the transition is the refusal, and the exit premise excludes it. -/
theorem step_is_exit_or_refusal (plan : table.RebuildPlan) (st : St) (e : Error)
    (hguard : st.2.2.val < planLen plan)
    (hentry : table.Table.relocate_entry CI CI HI KI st.1 plan st.2.1 st.2.2 = fail e) :
    step plan st = fail e ∧ ¬ step plan st = ok (ControlFlow.done (st.1, st.2.1)) := by
  have hfail := relocate_refusal plan st e hguard hentry
  refine ⟨hfail, fun hdone => ok_not_fail (hdone.symm.trans hfail)⟩

/-! ## The work measure

The counted unit is one planned entry moved, together with the payload copies that move costs.
`Table::relocate_entry` clones the held key word and the value word of the selected source slot
(`src/table.rs:955-956` on the resident arm, `:959-960` on the spill arm), so one relocation is one
entry moved and two word copies. At this root both clone instances are `Clone<i64>`, whose `clone`
is the identity on a word, so a copy is one machine word, never an allocation and never a refusal.
Nothing in the traversal allocates: the only other per-entry work is the destination index and, on
the spill arm, the vacancy probe. -/

/-- Entries moved by one transition: one under the guard, none at the exit. -/
def entryCharge (plan : table.RebuildPlan) (st : St) : Nat :=
  if st.2.2.val < planLen plan then 1 else 0

/-- Payload word copies charged to one transition: two per relocated entry (the held key word and
    the value word), none at the exit. -/
def copyCharge (plan : table.RebuildPlan) (st : St) : Nat :=
  if st.2.2.val < planLen plan then 2 else 0

theorem entryCharge_le (plan : table.RebuildPlan) (st : St) : entryCharge plan st ≤ 1 := by
  unfold entryCharge; split <;> omega

theorem copyCharge_le (plan : table.RebuildPlan) (st : St) : copyCharge plan st ≤ 2 := by
  unfold copyCharge; split <;> omega

/-- Each moved entry costs exactly two payload word copies. -/
theorem copy_is_two_per_entry (plan : table.RebuildPlan) (st : St) :
    copyCharge plan st = 2 * entryCharge plan st := by
  unfold copyCharge entryCharge; split <;> simp_all

/-- The clone the per-entry core applies to the value word is the identity on a machine word, so a
    copy is a word copy and never a refusal. -/
theorem cloneI64_is_identity (x : Std.I64) : core.clone.CloneI64.clone x = ok x := rfl

/-- The clone the per-entry core applies to the held key word is likewise a word copy. -/
theorem cloneStoredI64_is_identity (k : Std.I64) :
    table.keyrep.Stored.Insts.CoreCloneClone.clone CI ⟨k⟩ = ok ⟨k⟩ := by
  simp [table.keyrep.Stored.Insts.CoreCloneClone.clone]

/-- `Table::relocate_all_loop` is the partial fixpoint `loop` of the actual transition, so every
    trace below projects to the real loop value. -/
theorem relocate_all_loop_eq (plan : table.RebuildPlan) (state : Tbl) (reserved : Resv)
    (entry_at : Std.Usize) :
    table.Table.relocate_all_loop CI CI HI KI state plan reserved entry_at =
      loop (step plan) (state, reserved, entry_at) := rfl

/-- One observed continuation collapses the loop onto its own continuation. -/
theorem loop_step_eq (plan : table.RebuildPlan) (st st' : St)
    (hstep : step plan st = ok (ControlFlow.cont st')) :
    loop (step plan) st = loop (step plan) st' := by
  rw [loop.eq_1, hstep, bind_ok]

/-- **Total relocation work of `Table::relocate_all`.** Started at cursor `j`, with every in-range
    per-entry relocation succeeding, the traversal returns `Ok` after moving exactly
    `plan.entries.len - j` entries and copying exactly `2 · (plan.entries.len - j)` payload words,
    the rank `plan.entries.len - cursor` falling by one per moved entry. -/
theorem relocate_all_total_work (plan : table.RebuildPlan) (state : Tbl) (reserved : Resv)
    (j : Std.Usize) (h0 : j.val ≤ planLen plan)
    (hex : ∀ (st : St), st.2.2.val < planLen plan →
      ∃ (self' : Tbl) (reserved' : Resv),
        table.Table.relocate_entry CI CI HI KI st.1 plan st.2.1 st.2.2 = ok (self', reserved')) :
    ∃ (self' : Tbl) (reserved' : Resv),
      table.Table.relocate_all_loop CI CI HI KI state plan reserved j = ok (self', reserved') ∧
      Trace (step plan) (entryCharge plan) (state, reserved, j)
        (ok (self', reserved')) (planLen plan - j.val) ∧
      Trace (step plan) (copyCharge plan) (state, reserved, j)
        (ok (self', reserved')) (2 * (planLen plan - j.val)) := by
  have key : ∀ (m : Nat) (st : St), st.2.2.val + m = planLen plan →
      ∃ (self' : Tbl) (reserved' : Resv),
        loop (step plan) st = ok (self', reserved') ∧
        Trace (step plan) (entryCharge plan) st (ok (self', reserved')) m ∧
        Trace (step plan) (copyCharge plan) st (ok (self', reserved')) (2 * m) := by
    intro m
    induction m with
    | zero =>
        intro st hsum
        have hexit : ¬ st.2.2.val < planLen plan := by omega
        have hdone : step plan st = ok (ControlFlow.done (st.1, st.2.1)) :=
          relocate_exit plan st hexit
        have hloop : loop (step plan) st = ok (st.1, st.2.1) := by
          unfold loop
          rw [hdone]
          exact bind_ok _ _
        have hcharge1 : entryCharge plan st = 0 := by simp [entryCharge, hexit]
        have hcharge2 : copyCharge plan st = 0 := by simp [copyCharge, hexit]
        refine ⟨st.1, st.2.1, hloop, ?_, ?_⟩
        · simpa only [hcharge1] using
            (Trace.done (body := step plan) (charge := entryCharge plan)
              (state := st) (value := (st.1, st.2.1)) (by simpa [step] using hdone))
        · simpa only [hcharge2] using
            (Trace.done (body := step plan) (charge := copyCharge plan)
              (state := st) (value := (st.1, st.2.1)) (by simpa [step] using hdone))
    | succ m ih =>
        intro st hsum
        have hguard : st.2.2.val < planLen plan := by omega
        obtain ⟨self', reserved', hentry⟩ := hex st hguard
        obtain ⟨st', hstep, hst1, hst2, hat, _, _⟩ :=
          relocate_step plan st self' reserved' hguard hentry
        have hsum' : st'.2.2.val + m = planLen plan := by omega
        obtain ⟨self'', reserved'', hloop, ht1, ht2⟩ := ih st' hsum'
        have hcharge1 : entryCharge plan st = 1 := by simp [entryCharge, hguard]
        have hcharge2 : copyCharge plan st = 2 := by simp [copyCharge, hguard]
        refine ⟨self'', reserved'', ?_, ?_, ?_⟩
        · rw [loop_step_eq plan st st' (by simpa [step] using hstep), hloop]
        · have hcont : Trace (step plan) (entryCharge plan) st
              (ok (self'', reserved'')) (entryCharge plan st + m) :=
            Trace.cont (body := step plan) (charge := entryCharge plan) (state := st)
              (next := st') (by simpa [step] using hstep) ht1
          simpa only [hcharge1, Nat.add_comm] using hcont
        · have hcont2 : Trace (step plan) (copyCharge plan) st
              (ok (self'', reserved'')) (copyCharge plan st + 2 * m) :=
            Trace.cont (body := step plan) (charge := copyCharge plan) (state := st)
              (next := st') (by simpa [step] using hstep) ht2
          have htwo : copyCharge plan st + 2 * m = 2 * (m + 1) := by rw [hcharge2]; omega
          rw [htwo] at hcont2
          exact hcont2
  obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h0
  obtain ⟨self', reserved', hloop, ht1, ht2⟩ := key m (state, reserved, j) (by
    show j.val + m = planLen plan
    omega)
  have hrank : planLen plan - j.val = m := by omega
  refine ⟨self', reserved', ?_, ?_, ?_⟩
  · rw [relocate_all_loop_eq]
    exact hloop
  · rw [hrank]
    exact ht1
  · rw [hrank]
    exact ht2

/-- **The root's whole traversal work.** `word_stored_relocate_all` relocates exactly the planned
    entries, `plan.entries.len` of them, copying two payload word copies each. -/
theorem root_total_work (plan : table.RebuildPlan) (state : Tbl) (reserved : Resv)
    (hex : ∀ (st : St), st.2.2.val < planLen plan →
      ∃ (self' : Tbl) (reserved' : Resv),
        table.Table.relocate_entry CI CI HI KI st.1 plan st.2.1 st.2.2 = ok (self', reserved')) :
    ∃ (self' : Tbl) (reserved' : Resv),
      stored_relocate_all_source.word_stored_relocate_all state plan reserved = ok (self', reserved') ∧
      Trace (step plan) (entryCharge plan) (state, reserved, 0#usize)
        (ok (self', reserved')) (planLen plan) ∧
      Trace (step plan) (copyCharge plan) (state, reserved, 0#usize)
        (ok (self', reserved')) (2 * planLen plan) := by
  obtain ⟨self', reserved', hloop, ht1, ht2⟩ :=
    relocate_all_total_work plan state reserved 0#usize (by simp) hex
  refine ⟨self', reserved', ?_, ht1, ht2⟩
  rw [root_forwards, relocate_all_is_loop_at_zero]
  exact hloop

/-! ## Reachable witnesses at the joint types

The witnesses below are concrete `RebuildPlan`, `Table` and `RebuildReserved` values at the types the
root instantiates, and the per-entry core is evaluated at them, so the success and the refusal
branches are inhabited rather than asserted. -/

private theorem len_one_le {α : Type} (x : α) : ([x] : List α).length ≤ Std.Usize.max := by
  simp only [List.length_cons, List.length_nil]
  grind

theorem zero_usize_val : (0#usize).val = 0 := by
  apply Std.Usize.ofNatCore_val_eq

theorem vec_index_zero {α : Type} (v : alloc.vec.Vec α) (x : α) (hv : v.slice.val = [x]) :
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice α) v 0#usize = ok x := by
  rw [alloc.vec.Vec.index_slice_index,
    show v.index_usize 0#usize = v.slice.index_usize 0#usize from rfl]
  have hb : (0#usize).val < v.slice.length := by
    rw [Slice.length, hv, zero_usize_val]
    simp only [List.length_cons, List.length_nil]
    omega
  obtain ⟨y, hy⟩ := WP.spec_imp_exists (Slice.index_usize_spec v.slice 0#usize hb)
  have hq : (v.slice.val : List α)[(0#usize).val]? = some x := by
    rw [hv, zero_usize_val]
    rfl
  rw [List.getElem?_eq_getElem hb] at hq
  rw [hy.1, hy.2.trans (Option.some.inj hq)]

theorem vec_index_usize_zero {α : Type} (v : alloc.vec.Vec α) (x : α) (hv : v.slice.val = [x]) :
    alloc.vec.Vec.index_usize v 0#usize = ok x := by
  have h : v.index_usize 0#usize = v.slice.index_usize 0#usize := rfl
  rw [h]
  have hb : (0#usize).val < (v.slice.val : List α).length := by
    rw [hv, zero_usize_val]
    simp only [List.length_cons, List.length_nil]
    omega
  obtain ⟨y, hy⟩ := WP.spec_imp_exists
    (Slice.index_usize_spec v.slice 0#usize (by simpa only [Slice.length] using hb))
  have hq : (v.slice.val : List α)[(0#usize).val]? = some x := by
    rw [hv, zero_usize_val]
    rfl
  rw [List.getElem?_eq_getElem hb] at hq
  rw [hy.1, hy.2.trans (Option.some.inj hq)]

theorem vec_index_mut_usize_empty {α : Type} (v : alloc.vec.Vec α) (hv : v.slice.val = []) :
    alloc.vec.Vec.index_mut_usize v 0#usize = fail Error.arrayOutOfBounds := by
  rw [alloc.vec.Vec.index_mut_usize, alloc.vec.Vec.index_usize]
  have hq : (v.slice.val : List α)[(0#usize).val]? = none := by
    rw [hv, zero_usize_val]
    rfl
  have hq' : v[(0#usize).val]? = none := by
    show (v.slice.val : List α)[(0#usize).val]? = none
    exact hq
  rw [hq', bind_tc_fail]

theorem vec_index_mut_usize_one {α : Type} (v : alloc.vec.Vec α) (x : α) (hv : v.slice.val = [x]) :
    alloc.vec.Vec.index_mut_usize v 0#usize = ok (x, alloc.vec.Vec.set v 0#usize) := by
  rw [alloc.vec.Vec.index_mut_usize, vec_index_usize_zero v x hv, bind_tc_ok]

/-- The one live resident slot the witnesses start from. -/
def slot0 : table.FlatSlot Key Std.I64 :=
  { live := true, sigma := cell.Sigma.Elliptic, held := ⟨7#i64⟩, value := 11#i64 }

/-- Its flat area, with one slot. -/
def flat0 : table.Flat Key Std.I64 :=
  { lanes := 1#usize, slots := alloc.vec.Vec.from [slot0] (len_one_le slot0) }

/-- An empty flat area, used by the refusal witness. -/
def flatEmpty : table.Flat Key Std.I64 :=
  { lanes := 0#usize, slots := alloc.vec.Vec.new (table.FlatSlot Key Std.I64) }

/-- The reverse-link directory with no links: the relocation finds no handle to retarget. -/
def loc0 : table.TableLocator :=
  { profile := none, directory := none, links := alloc.vec.Vec.new (U32 × table.PayloadLocation),
    staged := none }

/-- The table the witnesses start from: one live resident payload, no spill regions. -/
def tbl0 : Tbl :=
  { default := 0#i64, home := (), resident := flat0,
    shards := alloc.vec.Vec.new (table.Region Key Std.I64), len := 1#usize, key := (),
    locator := loc0 }

/-- The one planned entry: relocate the resident payload at slot `0` to flat slot `0`. -/
def entryFlat : table.RebuildPlanEntry :=
  { source := table.RebuildSource.Resident 0#usize, flat := some 0#usize, spill := 0#usize }

/-- The one-entry checked plan. -/
def plan1 : table.RebuildPlan :=
  { lanes := 1#usize, entries := alloc.vec.Vec.from [entryFlat] (len_one_le entryFlat),
    spill_loads := alloc.vec.Vec.new Std.Usize }

/-- Reserved storage whose flat slot `0` is vacant: the checked destination. -/
def resvFull : Resv :=
  { resident := flat0, regions := alloc.vec.Vec.new (table.Region Key Std.I64) }

/-- Reserved storage with no flat slots at all, so the destination index refuses. -/
def resvEmpty : Resv :=
  { resident := flatEmpty, regions := alloc.vec.Vec.new (table.Region Key Std.I64) }

theorem planLen_plan1 : planLen plan1 = 1 := by
  show plan1.entries.slice.length = 1
  have hval : plan1.entries.slice.val = [entryFlat] := Slice.from_val _ _
  rw [Slice.length, hval]
  simp only [List.length_cons, List.length_nil]

theorem plan1_index : alloc.vec.Vec.index
    (core.slice.index.SliceIndexUsizeSlice table.RebuildPlanEntry) plan1.entries 0#usize
    = ok entryFlat := vec_index_zero plan1.entries entryFlat (Slice.from_val _ _)

theorem flat0_slots_val : flat0.slots.slice.val = [slot0] := by
  show (alloc.vec.Vec.from [slot0] _).slice.val = [slot0]
  exact Slice.from_val _ _

theorem slot_index : alloc.vec.Vec.index
    (core.slice.index.SliceIndexUsizeSlice (table.FlatSlot Key Std.I64))
    flat0.slots 0#usize = ok slot0 := vec_index_zero flat0.slots slot0 flat0_slots_val

theorem resvFull_slots_val : resvFull.resident.slots.slice.val = [slot0] := by
  show (alloc.vec.Vec.from [slot0] _).slice.val = [slot0]
  exact Slice.from_val _ _

theorem resvFull_index_mut_usize :
    alloc.vec.Vec.index_mut_usize resvFull.resident.slots 0#usize
      = ok (slot0, alloc.vec.Vec.set resvFull.resident.slots 0#usize) :=
  vec_index_mut_usize_one resvFull.resident.slots slot0 resvFull_slots_val

theorem resvEmpty_index_mut_usize :
    alloc.vec.Vec.index_mut_usize resvEmpty.resident.slots 0#usize
      = fail Error.arrayOutOfBounds := by
  show alloc.vec.Vec.index_mut_usize flatEmpty.slots 0#usize = fail Error.arrayOutOfBounds
  unfold alloc.vec.Vec.index_mut_usize
  exact vec_index_mut_usize_empty flatEmpty.slots (Slice.new_val _)

/-- Retargeting a payload to the location it already occupies leaves the locator alone, which is
    what the flat-destination arm does when source and destination index agree. -/
theorem retarget_same (k : Key) : table.TableLocator.retarget_held CI HI KI loc0 () slot0.sigma
    k (table.PayloadLocation.Resident 0#usize) (table.PayloadLocation.Resident 0#usize)
    = ok loc0 := by
  unfold table.TableLocator.retarget_held
  have hsame : table.same_location (table.PayloadLocation.Resident 0#usize)
      (table.PayloadLocation.Resident 0#usize) = ok true := by
    unfold table.same_location
    simp only [Result.ok.injEq]
    exact of_decide_eq_true rfl
  rw [hsame]
  simp only [↓reduceIte, bind_tc_ok]

theorem cloneHeld_is_word_copy :
    table.keyrep.Stored.Insts.CoreCloneClone.clone CI slot0.held = ok slot0.held := by
  simp [table.keyrep.Stored.Insts.CoreCloneClone.clone]

/-- **The per-entry relocation of the one-entry plan succeeds**: at `tbl0`, `plan1` and the
    vacancy-carrying `resvFull`, the real `Table::relocate_entry` returns `Ok`. -/
theorem relocate_entry_ok :
    WP.spec (table.Table.relocate_entry CI CI HI KI tbl0 plan1 resvFull 0#usize)
      (fun _ => True) := by
  show table.Table.relocate_entry CI CI HI KI tbl0 plan1 resvFull 0#usize ⦃ _ => True ⦄
  rw [table.Table.relocate_entry, plan1_index, bind_tc_ok]
  simp only [entryFlat, tbl0]
  rw [slot_index, bind_tc_ok]
  simp (config := { zeta := true })
  rw [cloneHeld_is_word_copy, bind_tc_ok, retarget_same, bind_tc_ok, resvFull_index_mut_usize,
    bind_tc_ok]
  exact WP.spec.ret trivial

/-- The same per-entry relocation refuses with `arrayOutOfBounds` when the planned destination slot
    is missing from the reserved storage, i.e. on a plan the checked-plan premise excludes. -/
theorem relocate_entry_refuses :
    table.Table.relocate_entry CI CI HI KI tbl0 plan1 resvEmpty 0#usize
      = fail Error.arrayOutOfBounds := by
  rw [table.Table.relocate_entry, plan1_index, bind_tc_ok]
  simp only [entryFlat, tbl0]
  rw [slot_index, bind_tc_ok]
  simp (config := { zeta := true })
  rw [cloneHeld_is_word_copy, bind_tc_ok, retarget_same, bind_tc_ok]
  show (do
      let _p ← alloc.vec.Vec.index_mut_usize resvEmpty.resident.slots 0#usize
      ok _) = fail Error.arrayOutOfBounds
  rw [resvEmpty_index_mut_usize, bind_tc_fail]

/-- **A reachable success witness.** On the one-entry plan the whole traversal returns `Ok` after
    moving exactly one entry and copying exactly two payload word copies: the closed form
    `plan.entries.len` of `root_total_work`, inhabited at the concrete types above. -/
theorem success_witness :
    ∃ (self' : Tbl) (reserved' : Resv),
      stored_relocate_all_source.word_stored_relocate_all tbl0 plan1 resvFull = ok (self', reserved') ∧
      Trace (step plan1) (entryCharge plan1) (tbl0, resvFull, 0#usize) (ok (self', reserved')) 1 ∧
      Trace (step plan1) (copyCharge plan1) (tbl0, resvFull, 0#usize) (ok (self', reserved')) 2 := by
  obtain ⟨pair, hentry, -⟩ :=
    (WP.spec_equiv_exists (m := table.Table.relocate_entry CI CI HI KI tbl0 plan1 resvFull 0#usize)
      (P := fun _ => True)).mp relocate_entry_ok
  obtain ⟨self', reserved'⟩ := pair
  have hguard : (0#usize).val < planLen plan1 := by rw [planLen_plan1]; simp
  obtain ⟨st', hstep, hst1, hst2, hat, _, _⟩ :=
    relocate_step plan1 (tbl0, resvFull, 0#usize) self' reserved' hguard hentry
  have hexit : ¬ st'.2.2.val < planLen plan1 := by
    rw [hat]; simp only [planLen_plan1]; omega
  have hdone : step plan1 st' = ok (ControlFlow.done (st'.1, st'.2.1)) :=
    relocate_exit plan1 st' hexit
  have hcharge1 : entryCharge plan1 st' = 0 := by simp [entryCharge, hexit]
  have hcharge2 : copyCharge plan1 st' = 0 := by simp [copyCharge, hexit]
  have hcharge1₀ : entryCharge plan1 (tbl0, resvFull, 0#usize) = 1 := by
    simp [entryCharge, planLen_plan1]
  have hcharge2₀ : copyCharge plan1 (tbl0, resvFull, 0#usize) = 2 := by
    simp [copyCharge, planLen_plan1]
  have hcont1 : Trace (step plan1) (entryCharge plan1) (tbl0, resvFull, 0#usize)
      (ok (st'.1, st'.2.1)) (entryCharge plan1 (tbl0, resvFull, 0#usize) + 0) :=
    Trace.cont (body := step plan1) (charge := entryCharge plan1)
      (state := (tbl0, resvFull, 0#usize)) (next := st')
      (by simpa only [hst1, hst2] using hstep)
      (by simpa only [hcharge1] using
        (Trace.done (body := step plan1) (charge := entryCharge plan1) (state := st')
          (value := (st'.1, st'.2.1)) (by simpa [step] using hdone)))
  have hcont2 : Trace (step plan1) (copyCharge plan1) (tbl0, resvFull, 0#usize)
      (ok (st'.1, st'.2.1)) (copyCharge plan1 (tbl0, resvFull, 0#usize) + 2 * 0) :=
    Trace.cont (body := step plan1) (charge := copyCharge plan1)
      (state := (tbl0, resvFull, 0#usize)) (next := st')
      (by simpa only [hst1, hst2] using hstep)
      (by simpa only [hcharge2] using
        (Trace.done (body := step plan1) (charge := copyCharge plan1) (state := st')
          (value := (st'.1, st'.2.1)) (by simpa [step] using hdone)))
  have ht1 : Trace (step plan1) (entryCharge plan1) (tbl0, resvFull, 0#usize)
      (ok (st'.1, st'.2.1)) 1 := by
    simpa only [hst1, hst2, hcharge1₀] using hcont1
  have ht2 : Trace (step plan1) (copyCharge plan1) (tbl0, resvFull, 0#usize)
      (ok (st'.1, st'.2.1)) 2 := by
    simpa only [hst1, hst2, hcharge2₀] using hcont2
  refine ⟨st'.1, st'.2.1, ?_, ht1, ht2⟩
  rw [root_forwards, relocate_all_is_loop_at_zero, relocate_all_loop_eq]
  exact LoopTrace.projection ht1

/-- **A reachable refusal witness.** On the same plan with a reserved storage whose destination
    slot is missing, the traversal refuses on its first entry and moves nothing: one refusal
    branch observation at the concrete types above. -/
theorem refusal_witness :
    step plan1 (tbl0, resvEmpty, 0#usize) = fail Error.arrayOutOfBounds ∧
      Trace (step plan1) (entryCharge plan1) (tbl0, resvEmpty, 0#usize)
        (fail Error.arrayOutOfBounds) 1 ∧
      Trace (step plan1) (copyCharge plan1) (tbl0, resvEmpty, 0#usize)
        (fail Error.arrayOutOfBounds) 2 := by
  have hguard : (0#usize).val < planLen plan1 := by rw [planLen_plan1]; simp
  have hfail := relocate_refusal plan1 (tbl0, resvEmpty, 0#usize) Error.arrayOutOfBounds hguard
    relocate_entry_refuses
  have hcharge1 : entryCharge plan1 (tbl0, resvEmpty, 0#usize) = 1 := by
    simp [entryCharge, planLen_plan1]
  have hcharge2 : copyCharge plan1 (tbl0, resvEmpty, 0#usize) = 2 := by
    simp [copyCharge, planLen_plan1]
  refine ⟨hfail, ?_, ?_⟩
  · simpa only [hcharge1] using
      (Trace.failure (body := step plan1) (charge := entryCharge plan1)
        (state := (tbl0, resvEmpty, 0#usize)) (error := Error.arrayOutOfBounds)
        (by simpa [step] using hfail))
  · simpa only [hcharge2] using
      (Trace.failure (body := step plan1) (charge := copyCharge plan1)
        (state := (tbl0, resvEmpty, 0#usize)) (error := Error.arrayOutOfBounds)
        (by simpa [step] using hfail))

end StoredRelocateAllResource

open Lean Elab Command in
elab "#resource_audit " id:ident : command => do
  let cs ← liftCoreM <| realizeGlobalConstWithInfos id
  let allowed : Lean.NameSet :=
    ({} : Lean.NameSet) |>.insert `propext |>.insert `Classical.choice |>.insert `Quot.sound
  for c in cs do
    let axioms ← liftTermElabM <| Lean.collectAxioms c
    let bad := axioms.filter (fun a => !allowed.contains a)
    unless bad.isEmpty do
      throwError m!"{c}: forbidden axioms {bad.toList}"
    logInfo m!"{c}: axioms {axioms.toList}"

