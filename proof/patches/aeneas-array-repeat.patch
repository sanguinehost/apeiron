+(** Find the declaration id of [core::array::repeat], if it is present in the
+    crate. Used to lower a native [Repeat] (which carries no [Copy]/[Clone]
+    proof) to the [core::array::repeat] builtin. *)
+let find_core_array_repeat (span : Meta.span) (ctx : eval_ctx) : FunDeclId.id =
+  let found = ref None in
+  FunDeclId.Map.iter
+    (fun id (def : fun_decl) ->
+      if !found = None then
+        match def.item_meta.name with
+        | [ PeIdent ("core", _); PeIdent ("array", _); PeIdent ("repeat", _) ] ->
+            found := Some id
+        | _ -> ())
+    ctx.crate.fun_decls;
+  match !found with
+  | Some id -> id
+  | None -> [%craise] span "Could not find `core::array::repeat` in the crate"
+
