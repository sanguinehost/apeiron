@@ -1,13 +1,22 @@
 import Aeneas.Std.Scalar.Core
+import Aeneas.Std.Scalar.Casts
 
 namespace Aeneas.Std
 
+open Result
+
 inductive Mutability where
 | Mut | Const
 
--- We don't really use raw pointers for now
+/-- MODEL: a raw pointer is a window into the byte buffer of one allocation: the buffer's
+contents as `U8` lanes and a byte offset into it. The only buffers the model builds are those of
+`[u8]` and `[u64]` slices (`core.slice.Slice.as_ptr`); `T` is a phantom that records the pointee type the Rust
+source names, so `cast` changes `T` and keeps the window. A pointer made from a slice of any other
+element type has an empty buffer, so every dereference of it fails (`undef`): the model does not
+define reads through such pointers. -/
 structure RawPtr (T : Type) (M : Mutability) where
-  v : T
+  bytes : List U8
+  off : Nat
 
 abbrev MutRawPtr (T : Type) := RawPtr T .Mut
 abbrev ConstRawPtr (T : Type) := RawPtr T .Const
@@ -30,4 +39,182 @@
   Result (RawPtr T' M') :=
   .fail .undef
 
+/-- MODEL: `<*const T>::cast::<U>`. Pure retyping; the window is unchanged. -/
+@[rust_fun "core::ptr::const_ptr::{*const @T}::cast"]
+def core.ptr.const_ptr.RawPtrConstT.cast {T : Type} (U : Type) (p : ConstRawPtr T) :
+    Result (ConstRawPtr U) :=
+  ok ⟨ p.bytes, p.off ⟩
+
+open Classical in
+/-- MODEL: the byte width of a pointee. `1` for `u8`, `8` for `u64`; every other `T` has no modelled
+buffer (see `RawPtr`), so its width is not read. -/
+noncomputable def ptrElemSize (T : Type) : Nat :=
+  if T = U8 then 1 else if T = U64 then 8 else 1
+
+/-- MODEL: the eight little-endian bytes of a `u64`, byte `k` the bits `8k..8k+7`. -/
+def U64.leBytes (x : U64) : List U8 :=
+  (List.range 8).map (fun k => (⟨ BitVec.ofNat 8 (x.val / 2 ^ (8 * k)) ⟩ : U8))
+
+/-- MODEL: the `u64` whose little-endian bytes are `bs[off .. off+8]` (a missing byte reads `0`). -/
+def U64.ofLeBytes (bs : List U8) (off : Nat) : U64 :=
+  ⟨ BitVec.ofNat 64 ((List.range 8).foldl
+    (fun acc j => acc + (bs.getD (off + j) (⟨ BitVec.ofNat 8 0 ⟩ : U8)).val * 2 ^ (8 * j)) 0) ⟩
+
+/-- MODEL: `<*const T>::add`. Rust requires the result to stay inside the allocation or one past its
+end, and the call is undefined behaviour otherwise; the model fails (`undef`) there, a refinement on
+the defined domain. The offset is in bytes, so the count scales by the pointee width (`ptrElemSize`). -/
+@[rust_fun "core::ptr::const_ptr::{*const @T}::add"]
+noncomputable def core.ptr.const_ptr.RawPtrConstT.add {T : Type} (p : ConstRawPtr T) (n : Usize) :
+    Result (ConstRawPtr T) :=
+  if p.off + n.val * ptrElemSize T ≤ p.bytes.length then
+    ok ⟨ p.bytes, p.off + n.val * ptrElemSize T ⟩
+  else fail .undef
+
+/-- MODEL: `core::mem::needs_drop::<T>()`. Exact for the scalar types and `bool`/`()`, which have no
+drop glue; `true` for every other type, which is the conservative answer (the drop path is a no-op
+for the integer carriers the proofs instantiate, so a spurious `true` takes a branch that exists in
+the source). -/
+def NoDropGlue (T : Type) : Prop :=
+  (∃ ty, T = UScalar ty) ∨ (∃ ty, T = IScalar ty) ∨ T = Bool ∨ T = Unit
+
+open Classical in
+@[rust_fun "core::mem::needs_drop"]
+noncomputable def core.mem.needs_drop (T : Type) : Result Bool :=
+  ok (if NoDropGlue T then false else true)
+
+/-- MODEL: `MaybeUninit<T>` is `Option T`: `new` is `some`, `uninit` is `none`. Reading or dropping
+an uninitialised value is undefined behaviour in Rust; the model fails (`undef`). -/
+@[reducible, rust_type "core::mem::maybe_uninit::MaybeUninit"]
+def core.mem.maybe_uninit.MaybeUninit (T : Type) : Type := Option T
+
+@[rust_fun "core::mem::maybe_uninit::{core::mem::maybe_uninit::MaybeUninit<@T>}::new"]
+def core.mem.maybe_uninit.MaybeUninit.new {T : Type} (x : T) :
+    Result (core.mem.maybe_uninit.MaybeUninit T) :=
+  ok (some x)
+
+@[rust_fun "core::mem::maybe_uninit::{core::mem::maybe_uninit::MaybeUninit<@T>}::uninit"]
+def core.mem.maybe_uninit.MaybeUninit.uninit (T : Type) :
+    Result (core.mem.maybe_uninit.MaybeUninit T) :=
+  ok none
+
+@[rust_fun "core::mem::maybe_uninit::{core::mem::maybe_uninit::MaybeUninit<@T>}::assume_init_read"]
+def core.mem.maybe_uninit.MaybeUninit.assume_init_read {T : Type}
+    (m : core.mem.maybe_uninit.MaybeUninit T) : Result T :=
+  match m with
+  | some x => ok x
+  | none => fail .undef
+
+/-- MODEL: after `assume_init_drop` the slot is logically uninitialised. -/
+@[rust_fun "core::mem::maybe_uninit::{core::mem::maybe_uninit::MaybeUninit<@T>}::assume_init_drop"]
+def core.mem.maybe_uninit.MaybeUninit.assume_init_drop {T : Type}
+    (m : core.mem.maybe_uninit.MaybeUninit T) :
+    Result (core.mem.maybe_uninit.MaybeUninit T) :=
+  match m with
+  | some _ => ok none
+  | none => fail .undef
+
+set_option linter.style.nameCheck false in
+/-- MODEL: `core::arch::x86::__m128i`, sixteen byte lanes, lane `k` the byte at address offset `k`
+(little-endian lane order, as `_mm_loadu_si128` and `_mm_movemask_epi8` define it). -/
+@[rust_type "core::core_arch::x86::__m128i"]
+structure core.core_arch.x86.__m128i where
+  lane : Fin 16 → U8
+
+/-- MODEL: `_mm_set1_epi8`, every lane the byte with the bit pattern of `x`. -/
+@[rust_fun "core::core_arch::x86::sse2::_mm_set1_epi8"]
+def core.core_arch.x86.sse2._mm_set1_epi8 (x : I8) : Result core.core_arch.x86.__m128i :=
+  ok ⟨ fun _ => IScalar.hcast .U8 x ⟩
+
+/-- MODEL: `_mm_loadu_si128`, an unaligned 16-byte read. Reading outside the buffer is undefined
+behaviour in Rust; the model fails (`undef`). -/
+@[rust_fun "core::core_arch::x86::sse2::_mm_loadu_si128"]
+def core.core_arch.x86.sse2._mm_loadu_si128 (p : ConstRawPtr core.core_arch.x86.__m128i) :
+    Result core.core_arch.x86.__m128i :=
+  if p.off + 16 ≤ p.bytes.length then ok ⟨ fun k => p.bytes.getD (p.off + k.val) (⟨ BitVec.ofNat 8 0 ⟩ : U8) ⟩
+  else fail .undef
+
+/-- MODEL: `_mm_cmpeq_epi8`, lane `k` is `0xFF` when the operands' lane `k` are equal, else `0`. -/
+@[rust_fun "core::core_arch::x86::sse2::_mm_cmpeq_epi8"]
+def core.core_arch.x86.sse2._mm_cmpeq_epi8 (a b : core.core_arch.x86.__m128i) :
+    Result core.core_arch.x86.__m128i :=
+  ok ⟨ fun k => if (a.lane k).val = (b.lane k).val then (⟨ BitVec.ofNat 8 255 ⟩ : U8) else (⟨ BitVec.ofNat 8 0 ⟩ : U8) ⟩
+
+/-- MODEL: `_mm_movemask_epi8`, bit `k` of the result is the top bit of lane `k`; bits 16..31 are
+zero. -/
+@[rust_fun "core::core_arch::x86::sse2::_mm_movemask_epi8"]
+def core.core_arch.x86.sse2._mm_movemask_epi8 (a : core.core_arch.x86.__m128i) : Result I32 :=
+  ok ⟨ BitVec.ofNat 32 ((List.range 16).foldl
+    (fun acc k => if h : k < 16 then (if 128 ≤ (a.lane ⟨ k, h ⟩).val then acc + 2 ^ k else acc)
+      else acc) 0) ⟩
+
+set_option linter.style.nameCheck false in
+/-- MODEL: `core::arch::x86::__m256i` as four 64-bit lanes, lane `k` the little-endian `u64` at byte
+offset `8k` (the lane view `_mm256_loadu_si256`, `_mm256_set1_epi64x`, `_mm256_cmpeq_epi64` use). -/
+@[rust_type "core::core_arch::x86::__m256i"]
+structure core.core_arch.x86.__m256i where
+  lane : Fin 4 → U64
+
+set_option linter.style.nameCheck false in
+/-- MODEL: `core::arch::x86::__m256d`, four 64-bit lanes holding the bit patterns of the doubles. -/
+@[rust_type "core::core_arch::x86::__m256d"]
+structure core.core_arch.x86.__m256d where
+  lane : Fin 4 → U64
+
+/-- MODEL: `_mm256_loadu_si256`, an unaligned 32-byte read. Reading outside the buffer is undefined
+behaviour in Rust; the model fails (`undef`). -/
+@[rust_fun "core::core_arch::x86::avx::_mm256_loadu_si256"]
+def core.core_arch.x86.avx._mm256_loadu_si256 (p : ConstRawPtr core.core_arch.x86.__m256i) :
+    Result core.core_arch.x86.__m256i :=
+  if p.off + 32 ≤ p.bytes.length then ok ⟨ fun k => U64.ofLeBytes p.bytes (p.off + 8 * k.val) ⟩
+  else fail .undef
+
+/-- MODEL: `_mm256_set1_epi64x`, every lane the bit pattern of `x`. -/
+@[rust_fun "core::core_arch::x86::avx::_mm256_set1_epi64x"]
+def core.core_arch.x86.avx._mm256_set1_epi64x (x : I64) : Result core.core_arch.x86.__m256i :=
+  ok ⟨ fun _ => IScalar.hcast .U64 x ⟩
+
+/-- MODEL: `_mm256_cmpeq_epi64`, lane `k` all ones when the operands' lane `k` are equal, else `0`. -/
+@[rust_fun "core::core_arch::x86::avx2::_mm256_cmpeq_epi64"]
+def core.core_arch.x86.avx2._mm256_cmpeq_epi64 (a b : core.core_arch.x86.__m256i) :
+    Result core.core_arch.x86.__m256i :=
+  ok ⟨ fun k => if (a.lane k).val = (b.lane k).val
+    then (⟨ BitVec.ofNat 64 (2 ^ 64 - 1) ⟩ : U64) else (⟨ BitVec.ofNat 64 0 ⟩ : U64) ⟩
+
+/-- MODEL: `_mm256_castsi256_pd`, a bit-preserving reinterpretation. -/
+@[rust_fun "core::core_arch::x86::avx::_mm256_castsi256_pd"]
+def core.core_arch.x86.avx._mm256_castsi256_pd (a : core.core_arch.x86.__m256i) :
+    Result core.core_arch.x86.__m256d :=
+  ok ⟨ a.lane ⟩
+
+/-- MODEL: `_mm256_movemask_pd`, bit `k` of the result is the sign bit (bit 63) of lane `k`; bits
+4..31 are zero. -/
+@[rust_fun "core::core_arch::x86::avx::_mm256_movemask_pd"]
+def core.core_arch.x86.avx._mm256_movemask_pd (a : core.core_arch.x86.__m256d) : Result I32 :=
+  ok ⟨ BitVec.ofNat 32 ((List.range 4).foldl
+    (fun acc k => if h : k < 4 then (if 2 ^ 63 ≤ (a.lane ⟨ k, h ⟩).val then acc + 2 ^ k else acc)
+      else acc) 0) ⟩
+
+/-- MODEL: the CPU's AVX2 capability as the Rust runtime probe reports it. Opaque: the value is
+unconstrained, so a proof about an extracted body that branches on it covers both branches. -/
+opaque std_detect.detect.arch.x86.avx2_probe : Bool
+
+set_option linter.style.nameCheck false in
+/-- MODEL: `is_x86_feature_detected!("avx2")`, the opaque probe `avx2_probe` (neither branch picked). -/
+@[rust_fun "std_detect::detect::arch::x86::__is_feature_detected::avx2"]
+def std_detect.detect.arch.x86.__is_feature_detected.avx2 : Result Bool :=
+  ok std_detect.detect.arch.x86.avx2_probe
+
+/-- MODEL: `MaybeUninit::assume_init_ref`, a read of the initialised value (the reference is the
+value). Undefined behaviour on an uninitialised slot; the model fails (`undef`). -/
+@[rust_fun "core::mem::maybe_uninit::{core::mem::maybe_uninit::MaybeUninit<@T>}::assume_init_ref"]
+def core.mem.maybe_uninit.MaybeUninit.assume_init_ref {T : Type}
+    (m : core.mem.maybe_uninit.MaybeUninit T) : Result T :=
+  match m with
+  | some x => ok x
+  | none => fail .undef
+
+/-- MODEL: `core::mem::drop`, consumes the value. -/
+@[rust_fun "core::mem::drop"]
+def core.mem.drop {T : Type} (_x : T) : Result Unit := ok ()
+
