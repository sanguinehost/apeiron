diff --color -ruN a/Aeneas/Std/Simd.lean b/Aeneas/Std/Simd.lean
--- a/Aeneas/Std/Simd.lean	1970-01-01 10:00:00.000000000 +1000
+++ b/Aeneas/Std/Simd.lean	2026-10-16 11:43:42.038142037 +1100
@@ -0,0 +1,1056 @@
+import Aeneas.Std.Scalar
+import Aeneas.Std.Slice
+import Aeneas.Std.RawPtr
+
+/-!
+# MODEL: x86 integer SIMD intrinsics (`core::core_arch::x86`)
+
+Lane-wise model of the SSE2/AVX/AVX2 integer intrinsics that the extraction axiomatises and that
+`Aeneas.Std.RawPtr` does not already model.  The vector types `__m128i` / `__m256i` keep the
+structures `RawPtr` declares (16 byte lanes / 4 `u64` lanes); every intrinsic here is the lane-wise
+definition from the Intel Intrinsics Guide, stated on the `BitVec` view `toBV` / `ofBV`, and the
+`#guard` rows below pin the edge-case behaviour (wrapping, saturation, high-bit controls, shift
+counts) to hand-derived values.
+-/
+
+namespace Aeneas.Std
+
+open Result
+
+set_option linter.style.nameCheck false
+
+/-- MODEL: lane `i` (bits `w*i .. w*i+w-1`) of a `w*k`-bit vector, little-endian. -/
+def lanes (w k : Nat) (v : BitVec (w * k)) (i : Fin k) : BitVec w :=
+  v.extractLsb' (w * i.val) w
+
+/-- MODEL: reassemble lanes `f` little-endian into a `w*k`-bit vector (inverse of `lanes`). -/
+def ofLanes (w k : Nat) (f : Fin k → BitVec w) : BitVec (w * k) :=
+  (BitVec.ofBoolListLE (List.ofFn (fun t : Fin (w * k) =>
+    (f ⟨t.val / w, Nat.div_lt_of_lt_mul t.isLt⟩).getLsbD (t.val % w)))).cast
+    (List.length_ofFn)
+
+/-- MODEL: `ofLanes` inverts `lanes`. -/
+theorem lanes_ofLanes {w k : Nat} (f : Fin k → BitVec w) (i : Fin k) :
+    lanes w k (ofLanes w k f) i = f i := by
+  apply BitVec.eq_of_getLsbD_eq
+  intro j hj
+  rcases Nat.eq_zero_or_pos w with hw | hw
+  · subst hw; exact absurd hj (Nat.not_lt_zero _)
+  · simp only [lanes, ofLanes, BitVec.getLsbD_extractLsb', BitVec.getLsbD_cast,
+      BitVec.getLsbD_ofBoolListLE]
+    simp only [hj, decide_true, Bool.true_and]
+    have hlt : w * (i : Nat) + j < w * k := by
+      have h1 : w * (i : Nat) + j < w * ((i : Nat) + 1) := by
+        rw [Nat.mul_add, Nat.mul_one]; omega
+      exact lt_of_lt_of_le h1 (Nat.mul_le_mul_left w (by have := i.isLt; omega))
+    rw [List.getD_eq_getElem _ false (by rw [List.length_ofFn]; exact hlt)]
+    rw [List.getElem_ofFn]
+    have hdiv : (w * (i : Nat) + j) / w = (i : Nat) := by
+      rw [Nat.mul_add_div hw, Nat.div_eq_of_lt hj, Nat.add_zero]
+    have hmod : (w * (i : Nat) + j) % w = j := by
+      rw [Nat.mul_add_mod, Nat.mod_eq_of_lt hj]
+    rw [show (⟨(w * (i : Nat) + j) / w, by rw [hdiv]; exact i.isLt⟩ : Fin k) = i from
+      Fin.ext hdiv]
+    rw [hmod]
+
+/-- MODEL: `lanes` inverts `ofLanes`. -/
+theorem ofLanes_lanes {w k : Nat} (v : BitVec (w * k)) :
+    ofLanes w k (fun i => lanes w k v i) = v := by
+  apply BitVec.eq_of_getLsbD_eq
+  intro j hj
+  rcases Nat.eq_zero_or_pos w with hw | hw
+  · subst hw; omega
+  · simp only [ofLanes, BitVec.getLsbD_cast, BitVec.getLsbD_ofBoolListLE]
+    rw [List.getD_eq_getElem _ false (by rw [List.length_ofFn]; exact hj)]
+    rw [List.getElem_ofFn]
+    simp only [lanes, BitVec.getLsbD_extractLsb', Nat.mod_lt _ hw, decide_true, Bool.true_and]
+    rw [Nat.mul_comm w (j / w), Nat.div_add_mod' j w]
+
+/-- MODEL: lane `i` of a `8*k`-bit vector, as a byte. -/
+def lanes8 (k : Nat) (v : BitVec (8 * k)) (i : Fin k) : BitVec 8 := lanes 8 k v i
+/-- MODEL: lane `i` of a `16*k`-bit vector, as a `u16`. -/
+def lanes16 (k : Nat) (v : BitVec (16 * k)) (i : Fin k) : BitVec 16 := lanes 16 k v i
+/-- MODEL: lane `i` of a `32*k`-bit vector, as a `u32`. -/
+def lanes32 (k : Nat) (v : BitVec (32 * k)) (i : Fin k) : BitVec 32 := lanes 32 k v i
+/-- MODEL: lane `i` of a `64*k`-bit vector, as a `u64`. -/
+def lanes64 (k : Nat) (v : BitVec (64 * k)) (i : Fin k) : BitVec 64 := lanes 64 k v i
+/-- MODEL: `k` byte lanes assembled little-endian. -/
+def ofLanes8 (k : Nat) (f : Fin k → BitVec 8) : BitVec (8 * k) := ofLanes 8 k f
+/-- MODEL: `k` `u16` lanes assembled little-endian. -/
+def ofLanes16 (k : Nat) (f : Fin k → BitVec 16) : BitVec (16 * k) := ofLanes 16 k f
+/-- MODEL: `k` `u32` lanes assembled little-endian. -/
+def ofLanes32 (k : Nat) (f : Fin k → BitVec 32) : BitVec (32 * k) := ofLanes 32 k f
+/-- MODEL: `k` `u64` lanes assembled little-endian. -/
+def ofLanes64 (k : Nat) (f : Fin k → BitVec 64) : BitVec (64 * k) := ofLanes 64 k f
+
+/-- MODEL: the byte view of `__m128i`: byte lane `k` is bits `8k..8k+7`. -/
+def core.core_arch.x86.__m128i.toBV (x : core.core_arch.x86.__m128i) : BitVec 128 :=
+  ofLanes8 16 (fun i => (x.lane i).bv)
+
+/-- MODEL: the `__m128i` whose byte lane `k` is bits `8k..8k+7` of `v`. -/
+def core.core_arch.x86.__m128i.ofBV (v : BitVec 128) : core.core_arch.x86.__m128i :=
+  ⟨ fun i => ⟨ lanes8 16 v i ⟩ ⟩
+
+/-- MODEL: the `u64`-lane view of `__m256i`: lane `k` is bits `64k..64k+63`. -/
+def core.core_arch.x86.__m256i.toBV (x : core.core_arch.x86.__m256i) : BitVec 256 :=
+  ofLanes64 4 (fun i => (x.lane i).bv)
+
+/-- MODEL: the `__m256i` whose `u64` lane `k` is bits `64k..64k+63` of `v`. -/
+def core.core_arch.x86.__m256i.ofBV (v : BitVec 256) : core.core_arch.x86.__m256i :=
+  ⟨ fun i => ⟨ lanes64 4 v i ⟩ ⟩
+
+theorem core.core_arch.x86.__m128i.ofBV_toBV (x : core.core_arch.x86.__m128i) :
+    core.core_arch.x86.__m128i.ofBV (core.core_arch.x86.__m128i.toBV x) = x := by
+  cases x with
+  | mk lane =>
+    simp only [core.core_arch.x86.__m128i.ofBV, core.core_arch.x86.__m128i.toBV]
+    congr 1
+    funext i
+    simp [lanes8, ofLanes8, lanes_ofLanes]
+
+theorem core.core_arch.x86.__m128i.toBV_ofBV (v : BitVec 128) :
+    core.core_arch.x86.__m128i.toBV (core.core_arch.x86.__m128i.ofBV v) = v := by
+  simp [core.core_arch.x86.__m128i.ofBV, core.core_arch.x86.__m128i.toBV, lanes8, ofLanes8,
+    ofLanes_lanes]
+
+theorem core.core_arch.x86.__m256i.ofBV_toBV (x : core.core_arch.x86.__m256i) :
+    core.core_arch.x86.__m256i.ofBV (core.core_arch.x86.__m256i.toBV x) = x := by
+  cases x with
+  | mk lane =>
+    simp only [core.core_arch.x86.__m256i.ofBV, core.core_arch.x86.__m256i.toBV]
+    congr 1
+    funext i
+    simp [lanes64, ofLanes64, lanes_ofLanes]
+
+theorem core.core_arch.x86.__m256i.toBV_ofBV (v : BitVec 256) :
+    core.core_arch.x86.__m256i.toBV (core.core_arch.x86.__m256i.ofBV v) = v := by
+  simp [core.core_arch.x86.__m256i.ofBV, core.core_arch.x86.__m256i.toBV, lanes64, ofLanes64,
+    ofLanes_lanes]
+
+namespace simd
+
+
+/-- MODEL: the `BitVec 256` view of an `__m256i`. -/
+abbrev toB256 (x : core.core_arch.x86.__m256i) : BitVec 256 := x.toBV
+/-- MODEL: the `__m256i` with the `BitVec 256` view `v`. -/
+abbrev ofB256 (v : BitVec 256) : core.core_arch.x86.__m256i := core.core_arch.x86.__m256i.ofBV v
+/-- MODEL: the `BitVec 128` view of an `__m128i`. -/
+abbrev toB128 (x : core.core_arch.x86.__m128i) : BitVec 128 := x.toBV
+/-- MODEL: the `__m128i` with the `BitVec 128` view `v`. -/
+abbrev ofB128 (v : BitVec 128) : core.core_arch.x86.__m128i := core.core_arch.x86.__m128i.ofBV v
+
+/-- MODEL: map a byte function over the 32 byte lanes of a 256-bit vector. -/
+def map1_8_256 (f : BitVec 8 → BitVec 8) (v : BitVec 256) : BitVec 256 :=
+  ofLanes8 32 (fun i => f (lanes8 32 v i))
+/-- MODEL: map a two-byte function over the 32 byte lanes of two 256-bit vectors. -/
+def map2_8_256 (f : BitVec 8 → BitVec 8 → BitVec 8) (u v : BitVec 256) : BitVec 256 :=
+  ofLanes8 32 (fun i => f (lanes8 32 u i) (lanes8 32 v i))
+/-- MODEL: map a three-byte function over the 32 byte lanes of three 256-bit vectors. -/
+def map3_8_256 (f : BitVec 8 → BitVec 8 → BitVec 8 → BitVec 8) (u v w : BitVec 256) :
+    BitVec 256 := ofLanes8 32 (fun i => f (lanes8 32 u i) (lanes8 32 v i) (lanes8 32 w i))
+/-- MODEL: map a `u16` function over the 16 `u16` lanes of a 256-bit vector. -/
+def map1_16_256 (f : BitVec 16 → BitVec 16) (v : BitVec 256) : BitVec 256 :=
+  ofLanes16 16 (fun i => f (lanes16 16 v i))
+/-- MODEL: map a two-`u16` function over the 16 `u16` lanes of two 256-bit vectors. -/
+def map2_16_256 (f : BitVec 16 → BitVec 16 → BitVec 16) (u v : BitVec 256) : BitVec 256 :=
+  ofLanes16 16 (fun i => f (lanes16 16 u i) (lanes16 16 v i))
+/-- MODEL: map a `u32` function over the 8 `u32` lanes of a 256-bit vector. -/
+def map1_32_256 (f : BitVec 32 → BitVec 32) (v : BitVec 256) : BitVec 256 :=
+  ofLanes32 8 (fun i => f (lanes32 8 v i))
+/-- MODEL: map a two-`u32` function over the 8 `u32` lanes of two 256-bit vectors. -/
+def map2_32_256 (f : BitVec 32 → BitVec 32 → BitVec 32) (u v : BitVec 256) : BitVec 256 :=
+  ofLanes32 8 (fun i => f (lanes32 8 u i) (lanes32 8 v i))
+/-- MODEL: map a `u64` function over the 4 `u64` lanes of a 256-bit vector. -/
+def map1_64_256 (f : BitVec 64 → BitVec 64) (v : BitVec 256) : BitVec 256 :=
+  ofLanes64 4 (fun i => f (lanes64 4 v i))
+/-- MODEL: map a two-`u64` function over the 4 `u64` lanes of two 256-bit vectors. -/
+def map2_64_256 (f : BitVec 64 → BitVec 64 → BitVec 64) (u v : BitVec 256) : BitVec 256 :=
+  ofLanes64 4 (fun i => f (lanes64 4 u i) (lanes64 4 v i))
+
+/-- MODEL: map a byte function over the 16 byte lanes of a 128-bit vector. -/
+def map1_8_128 (f : BitVec 8 → BitVec 8) (v : BitVec 128) : BitVec 128 :=
+  ofLanes8 16 (fun i => f (lanes8 16 v i))
+/-- MODEL: map a `u16` function over the 8 `u16` lanes of a 128-bit vector. -/
+def map1_16_128 (f : BitVec 16 → BitVec 16) (v : BitVec 128) : BitVec 128 :=
+  ofLanes16 8 (fun i => f (lanes16 8 v i))
+/-- MODEL: map a `u32` function over the 4 `u32` lanes of a 128-bit vector. -/
+def map1_32_128 (f : BitVec 32 → BitVec 32) (v : BitVec 128) : BitVec 128 :=
+  ofLanes32 4 (fun i => f (lanes32 4 v i))
+/-- MODEL: map a two-`u32` function over the 4 `u32` lanes of two 128-bit vectors. -/
+def map2_32_128 (f : BitVec 32 → BitVec 32 → BitVec 32) (u v : BitVec 128) : BitVec 128 :=
+  ofLanes32 4 (fun i => f (lanes32 4 u i) (lanes32 4 v i))
+/-- MODEL: map a `u64` function over the 2 `u64` lanes of a 128-bit vector. -/
+def map1_64_128 (f : BitVec 64 → BitVec 64) (v : BitVec 128) : BitVec 128 :=
+  ofLanes64 2 (fun i => f (lanes64 2 v i))
+/-- MODEL: map a two-`u64` function over the 2 `u64` lanes of two 128-bit vectors. -/
+def map2_64_128 (f : BitVec 64 → BitVec 64 → BitVec 64) (u v : BitVec 128) : BitVec 128 :=
+  ofLanes64 2 (fun i => f (lanes64 2 u i) (lanes64 2 v i))
+
+/-- MODEL: the low 128 bits. -/
+def lo128 (x : BitVec 256) : BitVec 128 := x.extractLsb' 0 128
+/-- MODEL: the high 128 bits. -/
+def hi128 (x : BitVec 256) : BitVec 128 := x.extractLsb' 128 128
+/-- MODEL: `hi` in the high 128 bits, `lo` in the low 128 bits. -/
+def join128 (hi lo : BitVec 128) : BitVec 256 := hi ++ lo
+
+/-- MODEL: `_mm_abs_epi8` per byte. `dst[i] := |a[i]|` on the signed byte; `-128` maps to `-128`. -/
+def abs8 (x : BitVec 8) : BitVec 8 := if x.getLsbD 7 then -x else x
+/-- MODEL: `_mm_sign_epi8` per byte. `c = 0` gives `0`; `c < 0` negates `a`; `c > 0` keeps `a`. -/
+def sign8 (x c : BitVec 8) : BitVec 8 := if c = 0 then 0 else if c.getLsbD 7 then -x else x
+
+/-- MODEL: `_mm_maddubs_epi16` on one `u16` group of two `u8` from `x` and two `i8` from `y`:
+`saturate_i16 (x0*y0 + x1*y1)`. -/
+def maddubs (x y : BitVec 16) : BitVec 16 :=
+  BitVec.ofInt 16 (max (-32768) (min 32767
+    ((BitVec.setWidth 8 x).toNat * (BitVec.setWidth 8 y).toInt
+     + (x.extractLsb' 8 8).toNat * (y.extractLsb' 8 8).toInt)))
+
+/-- MODEL: `_mm_madd_epi16` on one `u32` group of two `i16` from `x` and two `i16` from `y`:
+`x0*y0 + x1*y1` modulo `2^32`. -/
+def madd16 (x y : BitVec 32) : BitVec 32 :=
+  BitVec.signExtend 32 (BitVec.setWidth 16 x) * BitVec.signExtend 32 (BitVec.setWidth 16 y)
+    + BitVec.signExtend 32 (x.extractLsb' 16 16) * BitVec.signExtend 32 (y.extractLsb' 16 16)
+
+/-- MODEL: the absolute difference of two bytes. -/
+def babs8 (a b : BitVec 8) : Nat :=
+  if a.toNat ≤ b.toNat then b.toNat - a.toNat else a.toNat - b.toNat
+
+/-- MODEL: `_mm_sad_epu8` on one `u64` group: the sum of the eight absolute byte differences. -/
+def sad8 (x y : BitVec 64) : BitVec 64 :=
+  BitVec.ofNat 64 ((List.ofFn (fun i : Fin 8 => babs8 (lanes8 8 x i) (lanes8 8 y i))).foldl
+    (fun a b => a + b) 0)
+
+/-- MODEL: `_mm_shuffle_epi8` within one 128-bit lane: a control byte with its top bit set gives
+`0`, otherwise the byte of `a` at the control's low nibble. -/
+def shuffle8_128 (a b : BitVec 128) : BitVec 128 :=
+  ofLanes8 16 (fun i =>
+    if (lanes8 16 b i).getLsbD 7 then 0
+    else lanes8 16 a ⟨ (lanes8 16 b i).toNat % 16, Nat.mod_lt _ (by norm_num) ⟩)
+
+/-- MODEL: `_mm_unpacklo_epi8` within one 128-bit lane: the low 8 bytes interleaved. -/
+def unpacklo8_128 (a b : BitVec 128) : BitVec 128 :=
+  ofLanes8 16 (fun i =>
+    if i.val % 2 = 0 then lanes8 16 a ⟨ i.val / 2, by have := i.isLt; omega ⟩
+    else lanes8 16 b ⟨ i.val / 2, by have := i.isLt; omega ⟩)
+
+/-- MODEL: `_mm_unpackhi_epi8` within one 128-bit lane: the high 8 bytes interleaved. -/
+def unpackhi8_128 (a b : BitVec 128) : BitVec 128 :=
+  ofLanes8 16 (fun i =>
+    if i.val % 2 = 0 then lanes8 16 a ⟨ i.val / 2 + 8, by have := i.isLt; omega ⟩
+    else lanes8 16 b ⟨ i.val / 2 + 8, by have := i.isLt; omega ⟩)
+
+/-- MODEL: `_mm_unpacklo_epi64` within one 128-bit lane. -/
+def unpacklo64_128 (a b : BitVec 128) : BitVec 128 :=
+  (BitVec.setWidth 64 b) ++ (BitVec.setWidth 64 a)
+/-- MODEL: `_mm_unpackhi_epi64` within one 128-bit lane. -/
+def unpackhi64_128 (a b : BitVec 128) : BitVec 128 :=
+  (b.extractLsb' 64 64) ++ (a.extractLsb' 64 64)
+
+/-- MODEL: `_mm_hadd_epi32` within one 128-bit lane: `a`'s two adjacent pairs then `b`'s two. -/
+def hadd32_128 (a b : BitVec 128) : BitVec 128 :=
+  ofLanes32 4 ![lanes32 4 a 0 + lanes32 4 a 1, lanes32 4 a 2 + lanes32 4 a 3,
+    lanes32 4 b 0 + lanes32 4 b 1, lanes32 4 b 2 + lanes32 4 b 3]
+
+/-- MODEL: `_mm256_cvtepi16_epi32`: eight `i16` sign-extended to `i32`. -/
+def cvtepi16_epi32 (a : BitVec 128) : BitVec 256 :=
+  ofLanes32 8 (fun i => BitVec.signExtend 32 (lanes16 8 a i))
+/-- MODEL: `_mm256_cvtepi32_epi64`: four `i32` sign-extended to `i64`. -/
+def cvtepi32_epi64 (a : BitVec 128) : BitVec 256 :=
+  ofLanes64 4 (fun i => BitVec.signExtend 64 (lanes32 4 a i))
+/-- MODEL: `_mm256_cvtepu32_epi64`: four `u32` zero-extended to `u64`. -/
+def cvtepu32_epi64 (a : BitVec 128) : BitVec 256 :=
+  ofLanes64 4 (fun i => BitVec.setWidth 64 (lanes32 4 a i))
+/-- MODEL: `_mm256_cvtepu8_epi16`: sixteen `u8` zero-extended to `u16`. -/
+def cvtepu8_epi16 (a : BitVec 128) : BitVec 256 :=
+  ofLanes16 16 (fun i => BitVec.setWidth 16 (lanes8 16 a i))
+
+/-- MODEL: `_mm256_set1_epi8`, every byte lane `v`. -/
+def set1_8_256 (v : BitVec 8) : BitVec 256 := ofLanes8 32 (fun _ => v)
+/-- MODEL: `_mm256_set1_epi16`, every `u16` lane `v`. -/
+def set1_16_256 (v : BitVec 16) : BitVec 256 := ofLanes16 16 (fun _ => v)
+/-- MODEL: `_mm256_set1_epi32`, every `u32` lane `v`. -/
+def set1_32_256 (v : BitVec 32) : BitVec 256 := ofLanes32 8 (fun _ => v)
+/-- MODEL: `_mm256_setr_epi8` on the bit patterns of the 32 arguments. -/
+def setr8_256 (e : Fin 32 → BitVec 8) : BitVec 256 := ofLanes8 32 e
+/-- MODEL: `_mm256_setr_epi8` on 32 `i8` arguments, in increasing byte-lane order. -/
+def setr8_256i (e : Fin 32 → I8) : BitVec 256 := ofLanes8 32 (fun i => (e i).bv)
+/-- MODEL: `_mm256_setzero_si256`. -/
+def setzero256 : BitVec 256 := 0
+/-- MODEL: `Clone::clone`. -/
+def clone256 (v : BitVec 256) : BitVec 256 := v
+
+/-- MODEL: `_mm256_testc_si256`: returns CF, `1` iff `(~a) & b` is zero over all 256 bits. -/
+def testc256 (a b : BitVec 256) : BitVec 32 :=
+  if (~~~a) &&& b = 0 then 1 else 0
+
+/-- MODEL: `_mm256_extracti128_si256`, half `imm % 2` (low for even). -/
+def extract128_256 (imm : Nat) (v : BitVec 256) : BitVec 128 :=
+  if imm % 2 = 0 then lo128 v else hi128 v
+/-- MODEL: `_mm256_set_m128i`: `lo` in the low 128 bits, `hi` in the high 128 bits. -/
+def set_m128i_256 (hi lo : BitVec 128) : BitVec 256 := hi ++ lo
+/-- MODEL: `_mm256_broadcastsi128_si256`: the 128-bit lane duplicated. -/
+def broadcast128_256 (a : BitVec 128) : BitVec 256 := a ++ a
+
+/-- MODEL: `_mm_shuffle_epi32`: lane `i` of the result selects lane `(imm >> 2i) % 4`. -/
+def shuffle32_128 (imm : Nat) (v : BitVec 128) : BitVec 128 :=
+  ofLanes32 4 (fun i => lanes32 4 v ⟨ (imm >>> (2 * i.val)) % 4, Nat.mod_lt _ (by norm_num) ⟩)
+/-- MODEL: `_mm_extract_epi64`: `u64` lane `imm % 2`. -/
+def extract64_128 (imm : Nat) (v : BitVec 128) : BitVec 64 := v.extractLsb' (64 * (imm % 2)) 64
+/-- MODEL: `_mm_cvtsi128_si32`: the low 32 bits. -/
+def cvtsi32_128 (v : BitVec 128) : BitVec 32 := BitVec.setWidth 32 v
+/-- MODEL: `_mm_cvtsi128_si64`: the low 64 bits. -/
+def cvtsi64_128 (v : BitVec 128) : BitVec 64 := BitVec.setWidth 64 v
+
+/-- MODEL: `_mm256_storeu_si256` window test: a 32-byte write fits in the buffer. -/
+def storeu256_ok (off len : Nat) : Bool := off + 32 ≤ len
+/-- MODEL: `_mm_storeu_si128` window test: a 16-byte write fits in the buffer. -/
+def storeu128_ok (off len : Nat) : Bool := off + 16 ≤ len
