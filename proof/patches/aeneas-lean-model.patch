+/-- SPIKE model: `usize::div_ceil`. The quotient rounded towards positive infinity; a zero
+divisor refuses through the same `divisionByZero` as `/`, and the `+1` cannot overflow because
+it is only taken when there is a nonzero remainder, so the quotient is strictly below the
+dividend. -/
+@[rust_fun "core::num::{usize}::div_ceil"]
+def core.num.Usize.div_ceil (x y : Usize) : Result Usize := do
+  let q ← UScalar.div x y
+  let r ← UScalar.rem x y
+  if r.val = 0 then ok q else UScalar.add q (UScalar.one : Usize)
