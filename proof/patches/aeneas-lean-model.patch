diff --color -ruN a/Aeneas/Std/Num2.lean b/Aeneas/Std/Num2.lean
--- a/Aeneas/Std/Num2.lean	1970-01-01 10:00:00.000000000 +1000
+++ b/Aeneas/Std/Num2.lean	2026-10-16 12:07:55.921801504 +1100
@@ -0,0 +1,249 @@
+import Aeneas.Std.Scalar
+import Aeneas.Std.Core
+import Aeneas.Std.RawPtr
+import Aeneas.Std.Slice
+import Aeneas.Std.Range
+
+open Aeneas Aeneas.Std Result
+
+namespace Aeneas.Std
+
+/-!
+# Models for the `core::num` integer builtins (`i64`/`u64`)
+
+The extraction in `proof/ApeironWord.lean` leaves eight `core::num`/`core::ops::range`
+functions as axioms.  This file gives each a model with the same name and type, together
+with a value lemma (`_val`) and edge-case checks.  The bit-level references are `Nat`
+functions on `BitVec` so that the `_val` statements are closed computations.
+-/
+
+/-! ## Bit-level references over `BitVec`/`Nat` -/
+
+/-- Number of set bits of a `w`-bit word: the number of positions `i < w` that are `1`. -/
+def numGap_popCount {w : Nat} (x : BitVec w) : Nat :=
+  ((List.range w).filter (fun i => x.getLsbD i)).length
+
+/-- The popcount of a `w`-bit word is at most `w`. -/
+theorem numGap_popCount_le {w : Nat} (x : BitVec w) : numGap_popCount x ≤ w := by
+  unfold numGap_popCount
+  calc ((List.range w).filter (fun i => x.getLsbD i)).length
+      ≤ (List.range w).length := List.length_filter_le _ _
+    _ = w := List.length_range
+
+/-- Number of low zero bits.  A zero word has `w` trailing zeros, matching Rust's
+`trailing_zeros` (which returns the word width for zero). -/
+def numGap_trailingZeros {w : Nat} (x : BitVec w) : Nat :=
+  numGap_tzAux x w 0
+where
+  numGap_tzAux {w : Nat} (x : BitVec w) : Nat → Nat → Nat
+    | 0, acc => acc
+    | fuel + 1, acc => if x.getLsbD acc then acc else numGap_tzAux x fuel (acc + 1)
+
+/-- `⌈x / y⌉` over `Nat` (only meaningful when `y ≥ 1`; `Nat` division by zero is `0`). -/
+def numGap_divCeil (x y : Nat) : Nat := (x + y - 1) / y
+
+/-! ## `i64::count_ones` -/
+
+/-- MODEL: `i64::count_ones`, the number of set bits of the two's-complement word. -/
+@[rust_fun "core::num::{i64}::count_ones"]
+def core.num.I64.count_ones (x : I64) : Result U32 :=
+  ok ⟨ BitVec.ofNat 32 (numGap_popCount x.bv) ⟩
+
+theorem core.num.I64.count_ones_val (x : I64) :
+    core.num.I64.count_ones x = ok ⟨ BitVec.ofNat 32 (numGap_popCount x.bv) ⟩ := rfl
+
+/-- The returned `u32` value is the popcount of the word. -/
+theorem core.num.I64.count_ones_valNat (x : I64) (r : U32)
+    (h : core.num.I64.count_ones x = ok r) : r.val = numGap_popCount x.bv := by
+  simp only [core.num.I64.count_ones, Result.ok.injEq] at h
+  rw [← h]
+  simp only [UScalar.val]
+  rw [BitVec.toNat_ofNat (numGap_popCount x.bv) 32,
+      Nat.mod_eq_of_lt (Nat.lt_of_le_of_lt (numGap_popCount_le x.bv) (by norm_num))]
+
+/-! ## `i64::trailing_zeros` -/
+
+/-- MODEL: `i64::trailing_zeros`; `64` for the zero word. -/
+@[rust_fun "core::num::{i64}::trailing_zeros"]
+def core.num.I64.trailing_zeros (x : I64) : Result U32 :=
+  ok ⟨ BitVec.ofNat 32 (numGap_trailingZeros x.bv) ⟩
+
+theorem core.num.I64.trailing_zeros_val (x : I64) :
+    core.num.I64.trailing_zeros x = ok ⟨ BitVec.ofNat 32 (numGap_trailingZeros x.bv) ⟩ := rfl
+
+/-! ## `i64::unsigned_abs` -/
+
+/-- MODEL: `i64::unsigned_abs`, the magnitude of the two's-complement value as a `u64`.
+Total: `i64::MIN` maps to `2^63`. -/
+@[rust_fun "core::num::{i64}::unsigned_abs"]
+def core.num.I64.unsigned_abs (x : I64) : Result U64 :=
+  ok ⟨ BitVec.ofNat 64 x.val.natAbs ⟩
+
+theorem core.num.I64.unsigned_abs_val (x : I64) :
+    core.num.I64.unsigned_abs x = ok ⟨ BitVec.ofNat 64 x.val.natAbs ⟩ := rfl
+
+/-! ## `i64::abs` -/
+
+/-- MODEL: `i64::abs`.  `i64::MIN` overflows: Rust panics in a debug build and wraps in
+release; the model fails (`integerOverflow`), so a proof that it never fails covers both. -/
+@[rust_fun "core::num::{i64}::abs"]
+def core.num.I64.abs (x : I64) : Result I64 :=
+  if x.val = I64.min then fail .integerOverflow else ok ⟨ BitVec.ofInt 64 x.val.natAbs ⟩
+
+theorem core.num.I64.abs_val (x : I64) :
+    core.num.I64.abs x =
+      (if x.val = I64.min then fail .integerOverflow
+       else ok ⟨ BitVec.ofInt 64 x.val.natAbs ⟩) := rfl
+
+/-! ## `u64::trailing_zeros` -/
+
+/-- MODEL: `u64::trailing_zeros`; `64` for the zero word. -/
+@[rust_fun "core::num::{u64}::trailing_zeros"]
+def core.num.U64.trailing_zeros (x : U64) : Result U32 :=
+  ok ⟨ BitVec.ofNat 32 (numGap_trailingZeros x.bv) ⟩
+
+theorem core.num.U64.trailing_zeros_val (x : U64) :
+    core.num.U64.trailing_zeros x = ok ⟨ BitVec.ofNat 32 (numGap_trailingZeros x.bv) ⟩ := rfl
+
+/-! ## `u64::div_ceil` -/
+
+/-- MODEL: `u64::div_ceil`, the quotient rounded towards positive infinity.  A zero divisor
+refuses through the same `divisionByZero` as `/`. -/
+@[rust_fun "core::num::{u64}::div_ceil"]
+def core.num.U64.div_ceil (x y : U64) : Result U64 :=
+  if y.val = 0 then fail .divisionByZero
+  else ok ⟨ BitVec.ofNat 64 (numGap_divCeil x.val y.val) ⟩
+
+theorem core.num.U64.div_ceil_val (x y : U64) :
+    core.num.U64.div_ceil x y =
+      (if y.val = 0 then fail .divisionByZero
+       else ok ⟨ BitVec.ofNat 64 (numGap_divCeil x.val y.val) ⟩) := rfl
+
+/-! ## `u64::is_power_of_two` -/
+
+/-- MODEL: `u64::is_power_of_two`, true exactly when the value is `2^k` for some `k`. -/
+@[rust_fun "core::num::{u64}::is_power_of_two"]
+def core.num.U64.is_power_of_two (x : U64) : Result Bool :=
+  ok (decide x.val.isPowerOfTwo)
+
+theorem core.num.U64.is_power_of_two_val (x : U64) :
+    core.num.U64.is_power_of_two x = ok (decide x.val.isPowerOfTwo) := rfl
+
+/-! ## `RangeInclusive::contains` -/
+
+/-- MODEL: `RangeInclusive::contains`: `start <= x && x <= end`, using the `PartialOrd`
+instances the extraction threads through (`Idx : PartialOrd<U>` for the lower bound and
+`U : PartialOrd<Idx>` for the upper one).  The `exhausted` flag is ignored, as in Rust's
+`RangeBounds::contains`. -/
+@[rust_fun
+  "core::ops::range::{core::ops::range::RangeInclusive<@Idx>}::contains"]
+def core.ops.range.RangeInclusive.contains
+    {Idx : Type} {U : Type} (cmpPartialOrdInst : core.cmp.PartialOrd Idx Idx)
+    (cmpPartialOrdInst1 : core.cmp.PartialOrd Idx U) (cmpPartialOrdInst2 : core.cmp.PartialOrd U Idx) :
+    core.ops.range.RangeInclusive Idx → U → Result Bool :=
+  fun self x => do
+    let b1 ← cmpPartialOrdInst1.le self.start x
+    let b2 ← cmpPartialOrdInst2.le x self.«end»
+    ok (b1 && b2)
+
+theorem core.ops.range.RangeInclusive.contains_val {Idx U : Type}
+    (i0 : core.cmp.PartialOrd Idx Idx) (i1 : core.cmp.PartialOrd Idx U)
+    (i2 : core.cmp.PartialOrd U Idx) (self : core.ops.range.RangeInclusive Idx) (x : U) :
+    core.ops.range.RangeInclusive.contains i0 i1 i2 self x =
+      (do let b1 ← i1.le self.start x
+          let b2 ← i2.le x self.«end»
+          ok (b1 && b2)) := rfl
+
+/-- The result is the conjunction of the two comparisons. -/
+theorem core.ops.range.RangeInclusive.contains_spec {Idx U : Type}
+    (i0 : core.cmp.PartialOrd Idx Idx) (i1 : core.cmp.PartialOrd Idx U)
+    (i2 : core.cmp.PartialOrd U Idx) (self : core.ops.range.RangeInclusive Idx) (x : U)
+    (b1 b2 : Bool) (h1 : i1.le self.start x = ok b1) (h2 : i2.le x self.«end» = ok b2) :
+    core.ops.range.RangeInclusive.contains i0 i1 i2 self x = ok (b1 && b2) := by
+  simp [core.ops.range.RangeInclusive.contains, h1, h2]
+
+/-! ## Concrete scalars and value facts used by the edge checks -/
+
+/-- The `I64` with the bit pattern of `n`. -/
+abbrev numGap_i64 (n : Nat) : I64 := ⟨ BitVec.ofNat 64 n ⟩
+/-- The `U64` with the bit pattern of `n`. -/
+abbrev numGap_u64 (n : Nat) : U64 := ⟨ BitVec.ofNat 64 n ⟩
+/-- `i64::MIN` as a `Std.I64`. -/
+abbrev numGap_i64min : I64 := ⟨ BitVec.ofInt 64 I64.min ⟩
+
+theorem numGap_I64_min_val : numGap_i64min.val = I64.min := by
+  show (⟨ BitVec.ofInt 64 I64.min ⟩ : I64).val = I64.min
+  simp only [IScalar.val, BitVec.toInt_ofInt, I64.min, I64.numBits, IScalarTy.numBits]
+  norm_num [Int.bmod]
+
+theorem numGap_I64_min_natAbs : I64.min.natAbs = 2 ^ 63 := by
+  simp only [I64.min, I64.numBits, IScalarTy.numBits]
+  norm_num
+
+theorem numGap_I64_5_val : (numGap_i64 5).val = 5 := by decide
+
+theorem numGap_I64_5_ne_min : (numGap_i64 5).val ≠ I64.min := by
+  rw [numGap_I64_5_val]
+  norm_num [I64.min, I64.numBits, IScalarTy.numBits]
+
+theorem numGap_u64_zero_val : (numGap_u64 0).val = 0 := by
+  simp [UScalar.val, BitVec.toNat_ofNat]
+
+/-! ## Edge-case checks -/
+
+-- count_ones: 0, 1, 0xFF, -1
+#guard (core.num.I64.count_ones (numGap_i64 0)).reducesTo (⟨ BitVec.ofNat 32 0 ⟩ : U32)
+#guard (core.num.I64.count_ones (numGap_i64 1)).reducesTo (⟨ BitVec.ofNat 32 1 ⟩ : U32)
+#guard (core.num.I64.count_ones (numGap_i64 255)).reducesTo (⟨ BitVec.ofNat 32 8 ⟩ : U32)
+#guard (core.num.I64.count_ones (⟨ BitVec.allOnes 64 ⟩ : I64)).reducesTo
+        (⟨ BitVec.ofNat 32 64 ⟩ : U32)
+#guard numGap_popCount (BitVec.ofNat 64 0) = 0
+#guard numGap_popCount (BitVec.allOnes 64) = 64
+
+-- trailing_zeros: 0 -> 64, 1 -> 0, 8 -> 3
+#guard (core.num.I64.trailing_zeros (numGap_i64 0)).reducesTo (⟨ BitVec.ofNat 32 64 ⟩ : U32)
+#guard (core.num.I64.trailing_zeros (numGap_i64 1)).reducesTo (⟨ BitVec.ofNat 32 0 ⟩ : U32)
+#guard (core.num.I64.trailing_zeros (numGap_i64 8)).reducesTo (⟨ BitVec.ofNat 32 3 ⟩ : U32)
+#guard (core.num.U64.trailing_zeros (numGap_u64 0)).reducesTo (⟨ BitVec.ofNat 32 64 ⟩ : U32)
+#guard (core.num.U64.trailing_zeros (numGap_u64 8)).reducesTo (⟨ BitVec.ofNat 32 3 ⟩ : U32)
+#guard numGap_trailingZeros (BitVec.ofNat 64 0) = 64
+#guard numGap_trailingZeros (BitVec.ofNat 64 8) = 3
+#guard numGap_trailingZeros (BitVec.allOnes 64) = 0
+
+-- unsigned_abs: total, MIN -> 2^63
+#guard (core.num.I64.unsigned_abs (numGap_i64 0)).reducesTo (numGap_u64 0)
+example : core.num.I64.unsigned_abs numGap_i64min = ok (numGap_u64 (2 ^ 63)) := by
+  rw [core.num.I64.unsigned_abs_val, numGap_I64_min_val, numGap_I64_min_natAbs]
+
+-- abs: MIN fails; non-MIN witnesses
+example : core.num.I64.abs numGap_i64min = Result.fail .integerOverflow := by
+  rw [core.num.I64.abs_val, if_pos numGap_I64_min_val]
+example : core.num.I64.abs (numGap_i64 5) = ok ⟨ BitVec.ofInt 64 5 ⟩ := by
+  rw [core.num.I64.abs_val, if_neg numGap_I64_5_ne_min, numGap_I64_5_val]
+  norm_num
+
+-- div_ceil: zero divisor fails; otherwise the ceiling
+example : core.num.U64.div_ceil (numGap_u64 7) (numGap_u64 0) = Result.fail .divisionByZero := by
+  rw [core.num.U64.div_ceil_val, if_pos numGap_u64_zero_val]
+#guard (core.num.U64.div_ceil (numGap_u64 7) (numGap_u64 2)).reducesTo (numGap_u64 4)
+#guard (core.num.U64.div_ceil (numGap_u64 8) (numGap_u64 2)).reducesTo (numGap_u64 4)
+#guard (core.num.U64.div_ceil (numGap_u64 0) (numGap_u64 5)).reducesTo (numGap_u64 0)
+#guard numGap_divCeil 7 2 = 4
+#guard numGap_divCeil 8 2 = 4
+#guard numGap_divCeil 0 5 = 0
+
+-- is_power_of_two: 0, 1, 64 (2^6), 3
+#guard (core.num.U64.is_power_of_two (numGap_u64 0)).reducesTo false
+#guard (core.num.U64.is_power_of_two (numGap_u64 1)).reducesTo true
+#guard (core.num.U64.is_power_of_two (numGap_u64 64)).reducesTo true
+#guard (core.num.U64.is_power_of_two (numGap_u64 3)).reducesTo false
+
+-- contains: [2,5] contains 3, not 7; reversed [5,2] contains nothing
+#guard (core.ops.range.RangeInclusive.contains core.cmp.PartialOrdU64 core.cmp.PartialOrdU64
+        core.cmp.PartialOrdU64 ⟨ numGap_u64 2, numGap_u64 5, false ⟩ (numGap_u64 3)).reducesTo true
+#guard (core.ops.range.RangeInclusive.contains core.cmp.PartialOrdU64 core.cmp.PartialOrdU64
+        core.cmp.PartialOrdU64 ⟨ numGap_u64 2, numGap_u64 5, false ⟩ (numGap_u64 7)).reducesTo false
+#guard (core.ops.range.RangeInclusive.contains core.cmp.PartialOrdU64 core.cmp.PartialOrdU64
+        core.cmp.PartialOrdU64 ⟨ numGap_u64 5, numGap_u64 2, false ⟩ (numGap_u64 3)).reducesTo false
+
+end Aeneas.Std
diff --color -ruN a/Aeneas/Std/RawPtr.lean b/Aeneas/Std/RawPtr.lean
