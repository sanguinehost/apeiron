 import Aeneas.Std.Scalar.Ops.Neg
 import Aeneas.Std.Scalar.Ops.Rem
 import Aeneas.Std.Scalar.Ops.Sub
+
+namespace Aeneas.Std
+
+open Result
+
+/-- SPIKE model: `usize::div_ceil`. The quotient rounded towards positive infinity; a zero
+divisor refuses through the same `divisionByZero` as `/`, and the `+1` cannot overflow because
+it is only taken when there is a nonzero remainder, so the quotient is strictly below the
+dividend. -/
+@[rust_fun "core::num::{usize}::div_ceil"]
+def core.num.Usize.div_ceil (x y : Usize) : Result Usize := do
+  let q ← UScalar.div x y
+  let r ← UScalar.rem x y
+  if r.val = 0 then ok q else UScalar.add q (UScalar.one : Usize)
+
+/-- SPIKE model: `usize::trailing_zeros`, the number of low zero bits of a word. A zero word has
+`w` trailing zeros, matching Rust's `trailing_zeros`, which returns the bit width for zero. The
+`Flat`/`Flat::reserve` lane count is a power of two, so this is the `log2` those bodies read.
+Aeneas emits an unmodeled scalar external as the monadic `Result` form, so the model returns
+`Result U32`, as `usize::div_ceil` above does. -/
+def BitVec.trailingZeros {w : Nat} (x : BitVec w) : Nat :=
+  go x w 0
+where
+  go {w : Nat} (x : BitVec w) : Nat → Nat → Nat
+    | 0, acc => acc
+    | fuel + 1, acc => if x.getLsbD acc then acc else go x fuel (acc + 1)
+
+@[rust_fun "core::num::{usize}::trailing_zeros"]
+def core.num.Usize.trailing_zeros (x : Usize) : Result U32 :=
