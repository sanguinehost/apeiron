+`Result U32`, as `usize::div_ceil` above does. -/
+def BitVec.trailingZeros {w : Nat} (x : BitVec w) : Nat :=
+  go x w 0
+where
+  go {w : Nat} (x : BitVec w) : Nat → Nat → Nat
+    | 0, acc => acc
+    | fuel + 1, acc => if x.getLsbD acc then acc else go x fuel (acc + 1)
