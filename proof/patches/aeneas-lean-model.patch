+  ok ⟨ BitVec.trailingZeros x.bv ⟩
+
+/-- MODEL: `u32::trailing_zeros`; `32` for a zero word, as Rust defines it. -/
+@[rust_fun "core::num::{u32}::trailing_zeros"]
+def core.num.U32.trailing_zeros (x : U32) : Result U32 :=
