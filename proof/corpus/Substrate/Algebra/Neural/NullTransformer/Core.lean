noncomputable section

namespace Sanguine
namespace RopeRelative

open AttentionSpinor

/-- The inner product on a rotation-pair `(x, y) ∈ ℝ²` — one 2-D block of a head's key/query. -/
def rdot (p q : ℝ × ℝ) : ℝ := p.1 * q.1 + p.2 * q.2

/-- **The RoPE score is relative (headline).** -/
theorem rope_score_is_relative (a b : ℝ) (q k : ℝ × ℝ) :
    rdot (rotor a q.1 q.2) (rotor b k.1 k.2) = rdot q (rotor (b - a) k.1 k.2) := by
  simp only [rdot, rotor, Real.cos_sub, Real.sin_sub]
  ring

/-- **The absolute position drops out (shift invariance).** -/
theorem rope_score_shift_invariant (a b s : ℝ) (q k : ℝ × ℝ) :
    rdot (rotor (a + s) q.1 q.2) (rotor (b + s) k.1 k.2)
      = rdot (rotor a q.1 q.2) (rotor b k.1 k.2) := by
  rw [rope_score_is_relative (a + s) (b + s) q k, rope_score_is_relative a b q k]
  ring_nf

end RopeRelative
end Sanguine

