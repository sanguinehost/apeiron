-- ═══════════════════════════════════════════════════════════════════
-- §1. THE CELL GIVES THE NONLINEARITY — the boost, and its two ratios
-- ═══════════════════════════════════════════════════════════════════

/-- The `+` lightcone coordinate `L₊(a + bj) = a + b` — the component along the boost
    idempotent `e₊`. -/
def lPlus (z : NCell) : ℝ := z.1 + z.2

/-- The `−` lightcone coordinate `L₋(a + bj) = a − b` — the component along `e₋`. -/
def lMinus (z : NCell) : ℝ := z.1 - z.2

/-- **The cell diagonalizes: `L₊` is multiplicative.** In the boost-idempotent basis the null
    cell's product is coordinatewise — the `+` channel of a product is the product of the `+`
    channels. (`e₊ · e₋ = 0`, `NullCell.e_orthogonal`, read on coordinates.) -/
theorem lPlus_nmul (z w : NCell) : lPlus (nmul z w) = lPlus z * lPlus w := by
  simp only [lPlus, nmul]; ring

/-- **`L₋` is multiplicative** — the second, independent channel. -/
theorem lMinus_nmul (z w : NCell) : lMinus (nmul z w) = lMinus z * lMinus w := by
  simp only [lMinus, nmul]; ring

/-- **The split norm is the product of the two channels** — `N(z) = L₊(z)·L₋(z)`. The indefinite
    metric IS the pairing of the two independent lanes, and the null cone is exactly "one lane is
    zero". -/
theorem nNorm_eq_lPlus_mul_lMinus (z : NCell) : nNorm z = lPlus z * lMinus z := by
  simp only [nNorm, lPlus, lMinus]; ring

/-- **The boost** `e^{jφ} = cosh φ + j·sinh φ` — the null cell's own exponential, the
    one-parameter subgroup generated by `j` (where the Being cell's is the rotor `e^{iθ}`). -/
def nExp (φ : ℝ) : NCell := (Real.cosh φ, Real.sinh φ)

/-- **The boost's `+` channel IS `e^{φ}`.** This is where the transformer's `exp` comes from:
    not an activation chosen by hand, but the `+`-lightcone reading of the cell's own group. -/
theorem lPlus_nExp (φ : ℝ) : lPlus (nExp φ) = Real.exp φ := by
  simp only [lPlus, nExp, Real.cosh_eq, Real.sinh_eq]; ring

/-- **The boost's `−` channel is `e^{−φ}`** — the mirror lane. -/
theorem lMinus_nExp (φ : ℝ) : lMinus (nExp φ) = Real.exp (-φ) := by
  simp only [lMinus, nExp, Real.cosh_eq, Real.sinh_eq]; ring

/-- **The boost is the one-parameter group** — `e^{j(φ+ψ)} = e^{jφ}·e^{jψ}` under the cell's own
    multiplication. Addition of scores is multiplication of boosts: the reason logits add. -/
theorem nExp_add (φ ψ : ℝ) : nExp (φ + ψ) = nmul (nExp φ) (nExp ψ) := by
  have h : ∀ x : ℝ, Real.cosh x = (Real.exp x + Real.exp (-x)) / 2 := Real.cosh_eq
  have h' : ∀ x : ℝ, Real.sinh x = (Real.exp x - Real.exp (-x)) / 2 := Real.sinh_eq
  simp only [nExp, nmul, h, h', Prod.ext_iff, neg_add, Real.exp_add, Real.exp_neg]
  constructor <;> field_simp <;> ring

/-- **The boost rides the unit hyperbola** — `N(e^{jφ}) = 1`. It never leaves the norm-one orbit,
    so the `+`/`−` channels are exact reciprocals: the scale the softmax quotient cancels. -/
theorem nNorm_nExp (φ : ℝ) : nNorm (nExp φ) = 1 := by
  rw [nNorm_eq_lPlus_mul_lMinus, lPlus_nExp, lMinus_nExp, ← Real.exp_add]
  simp

/-- Softmax over a finite index set — the boundary `e^{sᵢ}` over the drag `Σ e^{sⱼ}`
    (definitionally `MLPrimitivesBridge.softmax` / `AttentionSpinor.softmax`). -/
def softmax {ι : Type} [Fintype ι] (s : ι → ℝ) (i : ι) : ℝ :=
  Real.exp (s i) / ∑ j, Real.exp (s j)

/-- **Softmax IS `B/U` on the boost's `+` channel (headline).** Every `exp` in a transformer's
    attention is the `+`-lightcone coordinate of the null cell's boost `e^{js}`, and the softmax
    is that channel over the summed channels — the bulk ratio `x = B/U` with the drag
    `U = Σ L₊(e^{jsⱼ})`. The activation is not chosen; it is the cell's group, divided. -/
theorem softmax_is_boost_channel {ι : Type} [Fintype ι] (s : ι → ℝ) (i : ι) :
    softmax s i = lPlus (nExp (s i)) / ∑ j, lPlus (nExp (s j)) := by
  simp only [softmax, lPlus_nExp]

/-- The logistic sigmoid `σ(x) = 1/(1+e^{−x})` — the gate inside SiLU/SwiGLU. -/
def sigmoid (x : ℝ) : ℝ := 1 / (1 + Real.exp (-x))

/-- **The sigmoid is the SAME ratio, inside ONE cell (headline).** For the half-angle boost
    `z = e^{j(x/2)}`, `σ(x) = L₊(z) / (L₊(z) + L₋(z))` — the `+` channel over the cell's own
    total. Attention's softmax and the MLP's gate are one operation at two index sets: the
    boost's channel over its drag. -/
theorem sigmoid_is_cell_ratio (x : ℝ) :
    sigmoid x = lPlus (nExp (x / 2)) / (lPlus (nExp (x / 2)) + lMinus (nExp (x / 2))) := by
  rw [lPlus_nExp, lMinus_nExp]
  have hb : Real.exp (-x) = Real.exp (-(x / 2)) * Real.exp (-(x / 2)) := by
    rw [← Real.exp_add]; ring_nf
  have hab : Real.exp (x / 2) * Real.exp (-(x / 2)) = 1 := by rw [← Real.exp_add]; simp
  unfold sigmoid
  rw [hb, div_eq_div_iff (by positivity) (by positivity)]
  linear_combination (-Real.exp (-(x / 2))) * hab

/-- **The sigmoid is the two-point softmax** — `σ(2x) = softmax ![x, −x] 0`. The gate is
    attention over a two-element context: the same `B/U`, the same boost, one cell instead of a
    sequence. -/
theorem sigmoid_is_two_point_softmax (x : ℝ) :
    sigmoid (2 * x) = softmax ![x, -x] 0 := by
  have hb : Real.exp (-(2 * x)) = Real.exp (-x) * Real.exp (-x) := by
    rw [← Real.exp_add]; ring_nf
  have hab : Real.exp x * Real.exp (-x) = 1 := by rw [← Real.exp_add]; simp
  simp only [sigmoid, softmax, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [hb, div_eq_div_iff (by positivity) (by positivity)]
  linear_combination (-Real.exp (-x)) * hab

-- ═══════════════════════════════════════════════════════════════════
-- §1c. WHY THIS WEIGHT AND NO OTHER — the exponential is forced
-- ═══════════════════════════════════════════════════════════════════
-- §1 showed softmax IS the null cell's boost channel over its drag. That says what softmax is,
-- not why it is the one. This says why: fix the one property a weighting must have and the
-- exponential is the only continuous solution, with the temperature as the sole remaining
-- freedom. Softmax is not a design choice among many; it is what the composition law leaves.

/-- **The composition law.** Scores ADD — a dot product accumulates over dimensions and the
    residual stream accumulates over layers — and the weight of two independent pieces of
    evidence must MULTIPLY, which is what makes the normalized read a likelihood rather than a
    vote. A weighting is `Composing` when it is continuous, strictly positive, and carries that
    addition to that multiplication. `nExp_add` says the null cell's boost obeys it. -/
def Composing (w : ℝ → ℝ) : Prop :=
  Continuous w ∧ (∀ a, 0 < w a) ∧ ∀ a b, w (a + b) = w a * w b

/-- **The exponential is the only composing weight (headline).** Any continuous positive `w`
    carrying score-addition to weight-multiplication is `w a = e^{c·a}` with `c = log (w 1)` —
    Cauchy's equation, closed by continuity. So the boost of §1 is not one option: it is the
    solution set. Everything a weighting is free to choose collapses to the single number `c`,
    the temperature, which the architecture already spends as the `1/√d_head` in `score`. -/
theorem composing_weight_is_the_boost {w : ℝ → ℝ} (hw : Composing w) (a : ℝ) :
    w a = Real.exp (Real.log (w 1) * a) := by
  obtain ⟨hcont, hpos, hhom⟩ := hw
  have hw0 : w 0 = 1 := by
    have h := hhom 0 0
    rw [add_zero] at h
    have h1 : (1 : ℝ) * w 0 = w 0 * w 0 := by rw [one_mul]; exact h
    exact (mul_right_cancel₀ (ne_of_gt (hpos 0)) h1).symm
  let f : ℝ →+ ℝ :=
    { toFun := fun x => Real.log (w x)
      map_zero' := by simp [hw0]
      map_add' := fun x y => by
        simp only [hhom x y]
        exact Real.log_mul (ne_of_gt (hpos x)) (ne_of_gt (hpos y)) }
  have hfc : Continuous (fun x => Real.log (w x)) := by
    rw [continuous_iff_continuousAt]
    intro x
    exact (Real.continuousAt_log (ne_of_gt (hpos x))).comp hcont.continuousAt
  have hcoe : ∀ x : ℝ, (AddMonoidHom.toRealLinearMap f hfc) x = Real.log (w x) := fun _ => rfl
  have key : Real.log (w a) = Real.log (w 1) * a := by
    have hsm := (AddMonoidHom.toRealLinearMap f hfc).map_smul a (1 : ℝ)
    rw [hcoe, hcoe] at hsm
    simp only [smul_eq_mul, mul_one] at hsm
    rw [hsm]; ring
  rw [← Real.exp_log (hpos a), key]

/-- **Softmax is the only composing attention (headline).** Normalize ANY composing weight over
    any finite key set and you have written softmax — at temperature `c = log (w 1)`, over the
    same scores. There is no second family. The freedom in "how should attention weight its
    keys" is exactly one real number, and the architecture already spends it.

    This is the answer to "why this shape": not that softmax was found to work, but that the
    composition law admits nothing else. What is ASSUMED is `Composing` — that evidence adds and
    weights multiply. That is a modelling commitment, stated here and not proved; what is proved
    is that the commitment has one solution. -/
theorem softmax_is_the_only_composing_weight {ι : Type} [Fintype ι] {w : ℝ → ℝ}
    (hw : Composing w) (s : ι → ℝ) (i : ι) :
    w (s i) / ∑ j, w (s j) = softmax (fun j => Real.log (w 1) * s j) i := by
  unfold softmax
  rw [composing_weight_is_the_boost hw (s i)]
  congr 1
  exact Finset.sum_congr rfl fun j _ => composing_weight_is_the_boost hw (s j)

/-- The null cell's boost IS composing — the solution set is inhabited by the object §1 named. -/
theorem nExp_channel_is_composing :
    Composing (fun a => lPlus (nExp a)) := by
  refine ⟨?_, ?_, ?_⟩
  · simp only [lPlus_nExp]; exact Real.continuous_exp
  · intro a; simp only [lPlus_nExp]; exact Real.exp_pos a
  · intro a b; simp only [lPlus_nExp]; exact Real.exp_add a b

-- ═══════════════════════════════════════════════════════════════════
-- §1b. THE REMAINING OPS ARE THE SAME CELL — the MAC, and the two drags
-- ═══════════════════════════════════════════════════════════════════
-- §1 discharged the two nonlinearities. The rest of a transformer is the contraction, the
-- norm and the residual `+`. All three are the cell too, and the two DRAGS come from the two
-- cells: the softmax's drag is a sum of NULL-cell boost channels, the RMSNorm's drag is a sum
-- of BEING-cell norms. One object, two breaks.

/-- `L₊` is additive — the accumulator lives in the channel. -/
theorem lPlus_add (z w : NCell) : lPlus (z + w) = lPlus z + lPlus w := by
  simp only [lPlus, Prod.fst_add, Prod.snd_add]; ring

/-- The real line sits in the cell along the shared unit: `a ↦ a·1 = (a, 0)`. -/
def ofReal (a : ℝ) : NCell := (a, 0)

/-- **The contraction IS the cell's multiply-accumulate.** Every GEMM entry — every projection,
    every attention score, every MLP row — is `L₊` of a sum of cell products of the embedded
    reals. The dot product is not a separate primitive: it is `nmul` accumulated and read in the
    `+` channel. -/
theorem contraction_is_cell_mac {n : ℕ} (a b : Fin n → ℝ) :
    ∑ i, a i * b i = lPlus (∑ i, nmul (ofReal (a i)) (ofReal (b i))) := by
  classical
  induction (Finset.univ : Finset (Fin n)) using Finset.induction_on with
  | empty => simp [lPlus]
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, lPlus_add, ← ih]; simp [lPlus, nmul, ofReal]

/-- **The RMSNorm drag is the BEING cells' norm.** The model dimension is `H·dp` two-planes, and
    the sum of squares that RMSNorm divides by is exactly the sum of those planes' phase-cell
    norms `a²+b²` — the definite twin of §1's indefinite `nNorm`. Two drags, two cells: softmax
    normalizes by a sum of null-cell boost channels, RMSNorm by a sum of Being-cell norms. -/
theorem rms_drag_is_being_cell_norm {H dp : ℕ} (x : Fin H × Fin dp × Bool → ℝ) :
    ∑ i, (x i) ^ 2
      = ∑ c : Fin H × Fin dp, Complex.normSq ⟨x (c.1, c.2, false), x (c.1, c.2, true)⟩ := by
  simp only [Fintype.sum_prod_type, Fintype.sum_bool, Complex.normSq_mk]
  exact Finset.sum_congr rfl fun h _ => Finset.sum_congr rfl fun p _ => by ring

/-- **Every op of the block is one face of the cell (headline).** The contraction is the cell's
    multiply-accumulate (`contraction_is_cell_mac`); the attention weight is the null cell's boost
    channel over its drag (`softmax_is_boost_channel`); the MLP gate is that same ratio inside one
    cell (`sigmoid_is_cell_ratio`); the RMSNorm drag is the Being cells' norm
    (`rms_drag_is_being_cell_norm`); RoPE is the Being cell's rotor (`rope`, whose isometry and
    group law are `AttentionSpinor.rotor_isometry` / `rotor_compose`); and the residual is `+`.
    Nothing else is used below. -/
theorem every_op_is_the_cell {n H dp : ℕ} (a b : Fin n → ℝ) (x : Fin H × Fin dp × Bool → ℝ)
    {ι : Type} [Fintype ι] (sc : ι → ℝ) (i : ι) (u : ℝ) :
    (∑ j, a j * b j = lPlus (∑ j, nmul (ofReal (a j)) (ofReal (b j))))
      ∧ (softmax sc i = lPlus (nExp (sc i)) / ∑ j, lPlus (nExp (sc j)))
      ∧ (sigmoid u = lPlus (nExp (u / 2)) / (lPlus (nExp (u / 2)) + lMinus (nExp (u / 2))))
      ∧ (∑ j, (x j) ^ 2
          = ∑ c : Fin H × Fin dp, Complex.normSq ⟨x (c.1, c.2, false), x (c.1, c.2, true)⟩) :=
  ⟨contraction_is_cell_mac a b, softmax_is_boost_channel sc i, sigmoid_is_cell_ratio u,
   rms_drag_is_being_cell_norm x⟩

-- ═══════════════════════════════════════════════════════════════════
-- §2. THE GRAPH — a node is a scalar as a function of the parameter vector
-- ═══════════════════════════════════════════════════════════════════
-- Autograd's data structure, typed: a "tensor entry" is a function of the flat parameter
-- vector θ, an op is a combinator on those functions, and each op carries its own
-- differentiability lemma. Composing the ops composes the lemmas — that is backprop's
-- existence, and §5 is nothing but the assembly.

/-- A node of the computation graph: one scalar, as a function of the flat parameter vector. -/
abbrev Node (P : ℕ) : Type := (Fin P → ℝ) → ℝ

/-- An activation: a `ι`-indexed family of nodes. -/
abbrev Act (P : ℕ) (ι : Type) : Type := ι → Node P

/-- An activation is differentiable when every one of its coordinates is. -/
def DiffAct {P : ℕ} {ι : Type} (x : Act P ι) : Prop := ∀ i, Differentiable ℝ (x i)

/-- **The leaf: a parameter.** Slot `i` of the flat vector, read as a node. -/
def prm {P : ℕ} (i : Fin P) : Node P := fun θ => θ i

theorem prm_differentiable {P : ℕ} (i : Fin P) : Differentiable ℝ (prm (P := P) i) := by
  unfold prm; fun_prop

/-- Division of nodes — the domain is a parameter *space*, not a field, so Mathlib's
    field-domain `Differentiable.div` does not apply; this is it, via the inverse. -/
theorem differentiable_div {P : ℕ} {f g : Node P} (hf : Differentiable ℝ f)
    (hg : Differentiable ℝ g) (h : ∀ θ, g θ ≠ 0) :
    Differentiable ℝ (fun θ => f θ / g θ) := by
  have : (fun θ => f θ / g θ) = f * g⁻¹ := by
    ext θ
    simp [div_eq_mul_inv, Pi.inv_apply]
  rw [this]
  exact hf.mul (Differentiable.inv hg h)

/-- Division of a node by a constant (a scale factor, `1/√d_head`, `1/T`). -/
theorem differentiable_div_const {P : ℕ} {f : Node P} (hf : Differentiable ℝ f) (c : ℝ) :
    Differentiable ℝ (fun θ => f θ / c) := by
  have : (fun θ => f θ / c) = f * fun _ => c⁻¹ := by
    ext θ
    simp [div_eq_mul_inv]
  rw [this]
  exact hf.mul (differentiable_const c⁻¹)

/-- A weight block: the index map `κ → ι → Fin P` read as nodes. Weights ARE slots of θ. -/
def wt {P : ℕ} {ι κ : Type} (W : κ → ι → Fin P) : κ → ι → Node P := fun k i => prm (W k i)

/-- **The contraction** — `(W·x)ₖ = Σᵢ Wₖᵢ·xᵢ`, the `B/U` accumulator fold
    (`MLPrimitivesBridge.contraction_is_fold`) at the graph level. -/
def lin {P : ℕ} {ι κ : Type} [Fintype ι] (W : κ → ι → Node P) (x : Act P ι) : Act P κ :=
  fun k θ => ∑ i, W k i θ * x i θ

theorem lin_differentiable {P : ℕ} {ι κ : Type} [Fintype ι] {W : κ → ι → Node P} {x : Act P ι}
    (hW : ∀ k i, Differentiable ℝ (W k i)) (hx : DiffAct x) : DiffAct (lin W x) := by
  intro k; unfold lin
  exact Differentiable.fun_sum fun i _ => (hW k i).mul (hx i)

-- ═══════════════════════════════════════════════════════════════════
-- §2b. THE CONTRACTION IS *THE* INSTRUCTION — `mv`, and the five laws
-- ═══════════════════════════════════════════════════════════════════
-- Every parameter in the network is consumed by `lin` and by nothing else (§3: seven per
-- block — Q,K,V,O,gate,up,down — plus the two norm gains and the two tables). So the machine
-- has exactly one arithmetic instruction, and what it is licensed to do with it is exactly
-- these five laws. Everything downstream — fusing QKV into one pass, collapsing QKVO into two
-- circuits (§3b), split-K tiling, warp scheduling — is one of them applied.

/-- **The instruction.** One contraction `(A·x)ₖ = Σᵢ Aₖᵢ·xᵢ`: the `B/U` accumulator fold
    (`MLPrimitivesBridge.contraction_is_fold`), which §1b already read as the null cell's own
    multiply-accumulate (`contraction_is_cell_mac`). -/
def mv {ι κ : Type} [Fintype ι] (A : κ → ι → ℝ) (x : ι → ℝ) : κ → ℝ :=
  fun k => ∑ i, A k i * x i

/-- The same instruction read against a covector: `⟪y, A·x⟫`. A score is this; a logit is this;
    a loss term is this. There is no second shape. -/
def bil {ι κ : Type} [Fintype ι] [Fintype κ] (A : κ → ι → ℝ) (y : κ → ℝ) (x : ι → ℝ) : ℝ :=
  ∑ k, y k * mv A x k

/-- **The graph's `lin` IS the instruction**, at each parameter point — definitionally. The
    node-level combinator adds nothing but the θ-dependence. -/
theorem lin_eq_mv {P : ℕ} {ι κ : Type} [Fintype ι] (W : κ → ι → Node P) (x : Act P ι)
    (k : κ) (θ : Fin P → ℝ) :
    lin W x k θ = mv (fun k i => W k i θ) (fun i => x i θ) k := rfl

/-- The matrix product — the composite of two contractions, written as one weight. -/
def matmul {ι κ μ : Type} [Fintype ι] (A : κ → ι → ℝ) (B : ι → μ → ℝ) : κ → μ → ℝ :=
  fun k j => ∑ i, A k i * B i j

/-- **LAW 1 — two contractions compose to ONE.** `A·(B·x) = (A·B)·x`. Back-to-back projections
    are never two instructions' worth of *semantics*: the pair is one weight. This is what
    licenses every fusion in §3b, and it is the whole reason a four-matrix attention has two
    circuits. -/
theorem mv_comp {ι κ μ : Type} [Fintype ι] [Fintype μ] (A : κ → ι → ℝ) (B : ι → μ → ℝ)
    (x : μ → ℝ) : mv A (mv B x) = mv (matmul A B) x := by
  funext k
  simp only [mv, matmul, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => by ring

/-- Stacking two weight blocks that read the SAME input, output-index by output-index. -/
def stackRows {ι κ₁ κ₂ : Type} (A : κ₁ → ι → ℝ) (B : κ₂ → ι → ℝ) : (κ₁ ⊕ κ₂) → ι → ℝ :=
  Sum.elim A B

/-- **LAW 2 — projections of the same input are ONE contraction.** Two (hence any number of)
    weight blocks applied to the same vector are the single contraction of the stacked weight.
    Q, K and V all read the post-norm residual, so they are one instruction over one pass of the
    input — `qkv_is_one_contraction` below is this law at the block. -/
theorem mv_stack {ι κ₁ κ₂ : Type} [Fintype ι] (A : κ₁ → ι → ℝ) (B : κ₂ → ι → ℝ) (x : ι → ℝ) :
    mv (stackRows A B) x = Sum.elim (mv A x) (mv B x) := by
  funext k; cases k <;> rfl

/-- **LAW 3 — split-K.** The reduction splits over any subset and its complement, exactly. Two
    partial accumulators added is the accumulator: tiling, split-K, and the multi-pass reduction
    are all this one identity (`SplitReduce.gemv_kernel_licensed` is its index-arithmetic form on
    the emitted kernel bounds). -/
theorem mv_split {ι κ : Type} [Fintype ι] [DecidableEq ι] (A : κ → ι → ℝ) (x : ι → ℝ)
    (s : Finset ι) (k : κ) :
    mv A x k = (∑ i ∈ s, A k i * x i) + ∑ i ∈ sᶜ, A k i * x i :=
  (Finset.sum_add_sum_compl s _).symm

/-- **The instruction in the emitted kernel's coordinate.** `mv` over `Fin K` is the `range K`
    sum `SplitReduce` speaks in, so LAW 3 and LAW 4 are the algebra behind that file's address
    results (`colmajor_unit_stride`, `colmajor_reads_once`, `gemv_kernel_licensed`). This is an
    INDEXING bridge only — no cost, traffic or bandwidth claim crosses it. -/
theorem mv_eq_range_sum {κ : Type} (K : ℕ) (a b : ℕ → ℝ) (k : κ) :
    mv (fun (_ : κ) (i : Fin K) => a i) (fun i : Fin K => b i) k
      = ∑ i ∈ Finset.range K, a i * b i :=
  Fin.sum_univ_eq_sum_range (fun i => a i * b i) K

/-- **LAW 4 — the schedule is not information.** Relabelling the reduction index by any bijection
    leaves the result identical: no order of accumulation is privileged, so a warp may consume the
    K axis in whatever order the memory system prefers. (`ScheduleRedundancy.schedule_is_the_lower_half`
    is the cost-side reading of the same fact.) -/
theorem mv_reindex {ι ι' κ : Type} [Fintype ι] [Fintype ι'] (e : ι' ≃ ι) (A : κ → ι → ℝ)
    (x : ι → ℝ) (k : κ) :
    mv (fun k i' => A k (e i')) (fun i' => x (e i')) k = mv A x k :=
  e.sum_comp (fun i => A k i * x i)

/-- **LAW 5 — linearity in the activation.** The instruction is linear in what it reads, so a
    residual stream may be split and recombined around it at will. -/
theorem mv_add {ι κ : Type} [Fintype ι] (A : κ → ι → ℝ) (x y : ι → ℝ) (k : κ) :
    mv A (fun i => x i + y i) k = mv A x k + mv A y k := by
  simp only [mv, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun i _ => by ring

theorem mv_smul {ι κ : Type} [Fintype ι] (A : κ → ι → ℝ) (c : ℝ) (x : ι → ℝ) (k : κ) :
    mv A (fun i => c * x i) k = c * mv A x k := by
  simp only [mv, Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by ring

/-- **The bilinear expansion.** A sum, over any outer index, of the product of two contractions
    of the same pair of inputs is ONE double contraction against the outer-summed matrix. This
    is the engine of §3b: it is exactly how a per-head sum of (query-projection · key-projection)
    becomes a single `d×d` circuit. -/
theorem bilinear_expand {ι κ σ : Type} [Fintype ι] [Fintype κ] [Fintype σ]
    (a : σ → ι → ℝ) (b : σ → κ → ℝ) (xt : ι → ℝ) (xu : κ → ℝ) :
    (∑ s, (∑ i, a s i * xt i) * (∑ j, b s j * xu j))
      = ∑ i, ∑ j, (∑ s, a s i * b s j) * (xt i * xu j) := by
  symm
  calc ∑ i, ∑ j, (∑ s, a s i * b s j) * (xt i * xu j)
      = ∑ i, ∑ j, ∑ s, (a s i * xt i) * (b s j * xu j) := by
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun s _ => by ring
    _ = ∑ i, ∑ s, ∑ j, (a s i * xt i) * (b s j * xu j) :=
        Finset.sum_congr rfl fun i _ => Finset.sum_comm
    _ = ∑ s, ∑ i, ∑ j, (a s i * xt i) * (b s j * xu j) := Finset.sum_comm
    _ = ∑ s, (∑ i, a s i * xt i) * (∑ j, b s j * xu j) :=
        Finset.sum_congr rfl fun s _ => (Finset.sum_mul_sum _ _ _ _).symm

/-- Square root of a node that is everywhere positive — differentiable (the only place a
    transformer meets `√`, and `ε > 0` is exactly what keeps it off the cone). -/
theorem differentiable_sqrt_pos {P : ℕ} {f : Node P} (hf : Differentiable ℝ f)
    (hpos : ∀ θ, 0 < f θ) : Differentiable ℝ (fun θ => Real.sqrt (f θ)) :=
  fun θ => ((Real.hasDerivAt_sqrt (ne_of_gt (hpos θ))).differentiableAt).comp θ (hf θ)

/-- **RMSNorm** — `xᵢ ↦ gᵢ·xᵢ / √(mean(x²) + ε)`, the definite norm's own `B/U`: the boundary is
    the gained coordinate, the drag is the vector's root-mean-square. -/
def rms {P : ℕ} {ι : Type} [Fintype ι] (ε : ℝ) (g x : Act P ι) : Act P ι :=
  fun i θ => g i θ * x i θ / Real.sqrt ((∑ k, (x k θ) ^ 2) / (Fintype.card ι : ℝ) + ε)

theorem rms_denom_pos {P : ℕ} {ι : Type} [Fintype ι] {ε : ℝ} (hε : 0 < ε) (x : Act P ι)
    (θ : Fin P → ℝ) : 0 < (∑ k, (x k θ) ^ 2) / (Fintype.card ι : ℝ) + ε := by
  have h : 0 ≤ (∑ k, (x k θ) ^ 2) / (Fintype.card ι : ℝ) := by positivity
  linarith

theorem rms_differentiable {P : ℕ} {ι : Type} [Fintype ι] {ε : ℝ} (hε : 0 < ε) {g x : Act P ι}
    (hg : DiffAct g) (hx : DiffAct x) : DiffAct (rms ε g x) := by
  intro i
  unfold rms
  have hs : Differentiable ℝ (fun θ => (∑ k, (x k θ) ^ 2) / (Fintype.card ι : ℝ) + ε) :=
    (differentiable_div_const (Differentiable.fun_sum fun k _ => (hx k).pow 2) _).add
      (differentiable_const ε)
  exact differentiable_div ((hg i).mul (hx i))
    (differentiable_sqrt_pos hs (rms_denom_pos hε x))
    (fun θ => Real.sqrt_ne_zero'.mpr (rms_denom_pos hε x θ))

/-- The sigmoid as a node. -/
def sigN {P : ℕ} (u : Node P) : Node P := fun θ => sigmoid (u θ)

theorem sigN_differentiable {P : ℕ} {u : Node P} (hu : Differentiable ℝ u) :
    Differentiable ℝ (sigN u) := by
  unfold sigN sigmoid
  exact differentiable_div (differentiable_const 1)
    ((Differentiable.exp hu.neg).const_add 1) (fun θ => by positivity)

/-- **SiLU** — `x·σ(x)`, the gate of §1 applied to the value it gates. -/
def silu {P : ℕ} (u : Node P) : Node P := fun θ => u θ * sigN u θ

theorem silu_differentiable {P : ℕ} {u : Node P} (hu : Differentiable ℝ u) :
    Differentiable ℝ (silu u) := hu.mul (sigN_differentiable hu)

/-- **SwiGLU** — `SiLU(gate) ⊙ up`, the gated MLP nonlinearity. -/
def swiglu {P : ℕ} {ι : Type} (gate up : Act P ι) : Act P ι :=
  fun i θ => silu (gate i) θ * up i θ

theorem swiglu_differentiable {P : ℕ} {ι : Type} {gate up : Act P ι}
    (hg : DiffAct gate) (hu : DiffAct up) : DiffAct (swiglu gate up) :=
  fun i => (silu_differentiable (hg i)).mul (hu i)

/-- Pointwise sum — the residual stream's `+`. -/
def addAct {P : ℕ} {ι : Type} (x y : Act P ι) : Act P ι := fun i θ => x i θ + y i θ

theorem addAct_differentiable {P : ℕ} {ι : Type} {x y : Act P ι}
    (hx : DiffAct x) (hy : DiffAct y) : DiffAct (addAct x y) := fun i => (hx i).add (hy i)

-- ═══════════════════════════════════════════════════════════════════
-- §3. THE NETWORK — pre-norm blocks, causal attention, SwiGLU, residuals
-- ═══════════════════════════════════════════════════════════════════
-- The model dimension is `Fin H × Fin dp × Bool`: H heads, each carrying `dp` Being cells,
-- each cell a 2-plane (the `Bool` lanes). That is not decoration — it is what makes RoPE the
-- Being cell's rotor acting on its own cell, `AttentionSpinor.rotor` at every coordinate pair.

/-- The model dimension: `H` heads × `dp` cells × 2 lanes. `d_model = 2·H·dp`. -/
abbrev Dim (H dp : ℕ) : Type := Fin H × Fin dp × Bool

/-- One head's dimension: `dp` cells × 2 lanes. `d_head = 2·dp`. -/
abbrev HeadDim (dp : ℕ) : Type := Fin dp × Bool

/-- One transformer block's parameters: index maps into the flat vector θ, plus the fixed RoPE
    frequencies (not learned — the rotor's angular velocity per cell). -/
structure Block (P H dp dff : ℕ) where
  /-- RMSNorm gain before attention. -/
  gAttn : Dim H dp → Fin P
  /-- Query projection. -/
  wQ : Dim H dp → Dim H dp → Fin P
  /-- Key projection. -/
  wK : Dim H dp → Dim H dp → Fin P
  /-- Value projection. -/
  wV : Dim H dp → Dim H dp → Fin P
  /-- Output projection. -/
  wO : Dim H dp → Dim H dp → Fin P
  /-- RMSNorm gain before the MLP. -/
  gMlp : Dim H dp → Fin P
  /-- SwiGLU gate projection. -/
  wGate : Fin dff → Dim H dp → Fin P
  /-- SwiGLU up projection. -/
  wUp : Fin dff → Dim H dp → Fin P
  /-- SwiGLU down projection. -/
  wDown : Dim H dp → Fin dff → Fin P
  /-- RoPE angular frequency per cell. -/
  freq : Fin dp → ℝ

/-- The whole network: token embedding, a list of blocks (its length is the depth), the final
    norm gain, and the unembedding. -/
structure Net (P H dp dff V : ℕ) where
  /-- Token embedding table. -/
  emb : Fin V → Dim H dp → Fin P
  /-- The blocks, in order. -/
  blocks : List (Block P H dp dff)
  /-- Final RMSNorm gain. -/
  gFinal : Dim H dp → Fin P
  /-- Unembedding (the readout head). -/
  unemb : Fin V → Dim H dp → Fin P

variable {P H dp dff V T : ℕ}

/-- **The embedding is the dictionary GET** — token `toks t` selects its row of the table, and
    each entry is a slot of θ. -/
def embed (net : Net P H dp dff V) (toks : Fin T → Fin V) : Fin T → Act P (Dim H dp) :=
  fun t i => prm (net.emb (toks t) i)

theorem embed_differentiable (net : Net P H dp dff V) (toks : Fin T → Fin V) (t : Fin T) :
    DiffAct (embed net toks t) := fun _ => prm_differentiable _

/-- **RoPE — the Being cell's rotor at position `t`.** Each cell `p` of each head is a 2-plane,
    and position enters as a rotation of that plane by `t·ω_p`. This is `AttentionSpinor.rotor`
    applied coordinate-pair by coordinate-pair: the phase (Being) cell where §1's boost was the
    null cell. -/
def rope (b : Block P H dp dff) (t : ℕ) (x : Act P (Dim H dp)) : Act P (Dim H dp) :=
  fun i θ =>
    let c := Real.cos ((t : ℝ) * b.freq i.2.1)
    let s := Real.sin ((t : ℝ) * b.freq i.2.1)
    if i.2.2 then s * x (i.1, i.2.1, false) θ + c * x (i.1, i.2.1, true) θ
    else c * x (i.1, i.2.1, false) θ - s * x (i.1, i.2.1, true) θ

theorem rope_differentiable (b : Block P H dp dff) (t : ℕ) {x : Act P (Dim H dp)}
    (hx : DiffAct x) : DiffAct (rope b t x) := by
  intro i
  unfold rope
  by_cases h : i.2.2
  · simp only [h, if_true]
    exact ((hx _).const_mul _).add ((hx _).const_mul _)
  · simp only [h]
    exact ((hx _).const_mul _).sub ((hx _).const_mul _)

/-- The causal prefix of position `t`: every position at or before it. Causality is the index
    set, not a `−∞` mask — nothing is ever added and then annihilated. -/
def pre (t : Fin T) : Finset (Fin T) := Finset.univ.filter (fun u => u.val ≤ t.val)

theorem mem_pre_self (t : Fin T) : t ∈ pre t := by
  simp [pre]

theorem pre_nonempty (t : Fin T) : (pre t).Nonempty := ⟨t, mem_pre_self t⟩

/-- The attention score of query `t` against key `u` in head `h`: the scaled dot product over
    that head's own cells. -/
def score (dp : ℕ) (q k : Fin T → Act P (Dim H dp)) (h : Fin H) (t u : Fin T) : Node P :=
  fun θ => (∑ pl : HeadDim dp, q t (h, pl) θ * k u (h, pl) θ)
    / Real.sqrt (2 * (dp : ℝ))

theorem score_differentiable {q k : Fin T → Act P (Dim H dp)}
    (hq : ∀ t, DiffAct (q t)) (hk : ∀ t, DiffAct (k t)) (h : Fin H) (t u : Fin T) :
    Differentiable ℝ (score dp q k h t u) := by
  unfold score
  exact differentiable_div_const (Differentiable.fun_sum fun pl _ => (hq t _).mul (hk u _)) _

/-- **The attention read — `B/U` on the boost's channel.** At position `t`, head `h`, lane
    `(p, l)`: the exp-score-weighted value sum over the causal prefix, over the summed
    exp-scores. Written as the single ratio (`softmax_attention_ratio`), which is what the
    machine computes: one division per output, not one per key. -/
def attnOut (dp : ℕ) (q k v : Fin T → Act P (Dim H dp)) : Fin T → Act P (Dim H dp) :=
  fun t i θ =>
    (∑ u ∈ pre t, Real.exp (score dp q k i.1 t u θ) * v u i θ)
      / (∑ u ∈ pre t, Real.exp (score dp q k i.1 t u θ))

theorem attn_denom_pos (dp : ℕ) (q k : Fin T → Act P (Dim H dp)) (h : Fin H) (t : Fin T)
    (θ : Fin P → ℝ) : 0 < ∑ u ∈ pre t, Real.exp (score dp q k h t u θ) :=
  Finset.sum_pos (fun _ _ => Real.exp_pos _) (pre_nonempty t)

theorem attnOut_differentiable {q k v : Fin T → Act P (Dim H dp)}
    (hq : ∀ t, DiffAct (q t)) (hk : ∀ t, DiffAct (k t)) (hv : ∀ t, DiffAct (v t)) (t : Fin T) :
    DiffAct (attnOut dp q k v t) := by
  intro i
  unfold attnOut
  refine differentiable_div ?_ ?_ (fun θ => ne_of_gt (attn_denom_pos dp q k i.1 t θ))
  · exact Differentiable.fun_sum fun u _ =>
      ((score_differentiable hq hk i.1 t u).exp).mul (hv u i)
  · exact Differentiable.fun_sum fun u _ =>
      Differentiable.exp (score_differentiable hq hk i.1 t u)

/-- **The attention read is one bulk ratio** — the softmax-weighted value sum collapses to
    `(Σ e^{sc}·v)/(Σ e^{sc})`: one division per output, the drag pulled out. -/
theorem attnOut_is_bulk_ratio (dp : ℕ) (q k v : Fin T → Act P (Dim H dp))
    (t : Fin T) (i : Dim H dp) (θ : Fin P → ℝ) :
    attnOut dp q k v t i θ
      = (∑ u ∈ pre t, Real.exp (score dp q k i.1 t u θ) * v u i θ)
        / (∑ u ∈ pre t, Real.exp (score dp q k i.1 t u θ)) := rfl

/-- **The read equals the softmax-weighted sum** — the ratio form and the per-key-weight form
    agree, over the causal prefix. (`MLPrimitivesBridge.softmax`'s shape, restricted to `pre t`.) -/
theorem attnOut_eq_softmax_weighted (dp : ℕ) (q k v : Fin T → Act P (Dim H dp))
    (t : Fin T) (i : Dim H dp) (θ : Fin P → ℝ) :
    attnOut dp q k v t i θ
      = ∑ u ∈ pre t, (Real.exp (score dp q k i.1 t u θ)
          / ∑ u' ∈ pre t, Real.exp (score dp q k i.1 t u' θ)) * v u i θ := by
  rw [attnOut_is_bulk_ratio, Finset.sum_div]
  exact Finset.sum_congr rfl fun u _ => by rw [div_mul_eq_mul_div]

/-- One block's forward pass: pre-norm causal attention with a residual, then pre-norm SwiGLU
    with a residual. The Llama/Qwen shape. -/
def blockFwd (ε : ℝ) (b : Block P H dp dff) (x : Fin T → Act P (Dim H dp)) :
    Fin T → Act P (Dim H dp) :=
  let n1 : Fin T → Act P (Dim H dp) := fun t => rms ε (fun i => prm (b.gAttn i)) (x t)
  let q : Fin T → Act P (Dim H dp) := fun t => rope b t.val (lin (wt b.wQ) (n1 t))
  let k : Fin T → Act P (Dim H dp) := fun t => rope b t.val (lin (wt b.wK) (n1 t))
  let v : Fin T → Act P (Dim H dp) := fun t => lin (wt b.wV) (n1 t)
  let a : Fin T → Act P (Dim H dp) := attnOut dp q k v
  let y : Fin T → Act P (Dim H dp) := fun t => addAct (x t) (lin (wt b.wO) (a t))
  let n2 : Fin T → Act P (Dim H dp) := fun t => rms ε (fun i => prm (b.gMlp i)) (y t)
  fun t => addAct (y t)
    (lin (wt b.wDown) (swiglu (lin (wt b.wGate) (n2 t)) (lin (wt b.wUp) (n2 t))))

theorem blockFwd_differentiable {ε : ℝ} (hε : 0 < ε) (b : Block P H dp dff)
    {x : Fin T → Act P (Dim H dp)} (hx : ∀ t, DiffAct (x t)) :
    ∀ t, DiffAct (blockFwd ε b x t) := by
  have hw : ∀ {ι κ : Type} (W : κ → ι → Fin P), ∀ k i, Differentiable ℝ (wt W k i) :=
    fun W k i => prm_differentiable _
  have hn1 : ∀ t, DiffAct (rms ε (fun i => prm (b.gAttn i)) (x t)) :=
    fun t => rms_differentiable hε (fun i => prm_differentiable _) (hx t)
  have hq : ∀ t, DiffAct (rope b t.val (lin (wt b.wQ) (rms ε (fun i => prm (b.gAttn i)) (x t)))) :=
    fun t => rope_differentiable _ _ (lin_differentiable (hw b.wQ) (hn1 t))
  have hk : ∀ t, DiffAct (rope b t.val (lin (wt b.wK) (rms ε (fun i => prm (b.gAttn i)) (x t)))) :=
    fun t => rope_differentiable _ _ (lin_differentiable (hw b.wK) (hn1 t))
  have hv : ∀ t, DiffAct (lin (wt b.wV) (rms ε (fun i => prm (b.gAttn i)) (x t))) :=
    fun t => lin_differentiable (hw b.wV) (hn1 t)
  have hy : ∀ t, DiffAct (addAct (x t) (lin (wt b.wO) (attnOut dp _ _ _ t))) :=
    fun t => addAct_differentiable (hx t)
      (lin_differentiable (hw b.wO) (attnOut_differentiable hq hk hv t))
  intro t
  refine addAct_differentiable (hy t) (lin_differentiable (hw b.wDown) ?_)
  have hn2 : DiffAct (rms ε (fun i => prm (b.gMlp i))
      (addAct (x t) (lin (wt b.wO) (attnOut dp _ _ _ t)))) :=
    rms_differentiable hε (fun i => prm_differentiable _) (hy t)
  exact swiglu_differentiable (lin_differentiable (hw b.wGate) hn2)
    (lin_differentiable (hw b.wUp) hn2)

/-- The stack: fold the blocks over the residual stream, in order. Depth is the list's length —
    the theorem below holds at every depth by list induction. -/
def stack (ε : ℝ) : List (Block P H dp dff) → (Fin T → Act P (Dim H dp)) →
    (Fin T → Act P (Dim H dp))
  | [], x => x
  | b :: bs, x => stack ε bs (blockFwd ε b x)

theorem stack_differentiable {ε : ℝ} (hε : 0 < ε) :
    ∀ (bs : List (Block P H dp dff)) {x : Fin T → Act P (Dim H dp)},
      (∀ t, DiffAct (x t)) → ∀ t, DiffAct (stack ε bs x t)
  | [], _, hx => hx
  | b :: bs, _, hx => stack_differentiable hε bs (blockFwd_differentiable hε b hx)

/-- **The logits.** Embed, run the stack, final RMSNorm, read out against the unembedding row of
    each vocabulary item. -/
def netLogits (ε : ℝ) (net : Net P H dp dff V) (toks : Fin T → Fin V) :
    Fin T → Fin V → Node P :=
  fun t w θ =>
    ∑ i, prm (net.unemb w i) θ *
      rms ε (fun i => prm (net.gFinal i)) (stack ε net.blocks (embed net toks) t) i θ

theorem netLogits_differentiable {ε : ℝ} (hε : 0 < ε) (net : Net P H dp dff V)
    (toks : Fin T → Fin V) (t : Fin T) (w : Fin V) :
    Differentiable ℝ (netLogits ε net toks t w) := by
  have hs : ∀ t, DiffAct (stack ε net.blocks (embed net toks) t) :=
    stack_differentiable hε net.blocks (embed_differentiable net toks)
  have hf : DiffAct (rms ε (fun i => prm (net.gFinal i))
      (stack ε net.blocks (embed net toks) t)) :=
    rms_differentiable hε (fun i => prm_differentiable _) (hs t)
  unfold netLogits
  exact Differentiable.fun_sum fun i _ => (prm_differentiable _).mul (hf i)


