namespace AlgebraSha256d

open Apeiron.Crypto.Sha2 (Word State Block H0 rotr shrx sigma0 sigma1 Sigma0 Sigma1
  lengthByte lengthBlock pad)
open Apeiron.Trichotomy.AnyRing (RingCell ringMul ringMul_comm ringMul_distrib_sub)
open apeiron_word (vec_getD_eq)

/-! ## Section 1: SHA-256d as `H o H` over the canonical object

`Sha2.hash : List (BitVec 8) -> State` is the canonical FIPS 180-4 section 6.2.1 map.
SHA-256d applies it twice, and the second application needs the first one's `State` as a
*message*. The bridge is the big-endian 32-byte store, which is the corpus's own store
convention: `Crypto/Sha256Certificate.lean:144` reads a digest as
`H[i] = out[4i]*2^24 + out[4i+1]*2^16 + out[4i+2]*2^8 + out[4i+3]`, and
`Crypto/Sha2.lean:125` reads the length field's byte `i` as `(bits >>> 8*(7-i)) % 256`.
Both directions are re-declared here in that shape and `wordsOf32_stateToBytes` pins the round
trip, so `sha256d` below is not a vacuous `rfl` against a lossy encoding. -/

/-- Byte `j` (counting from the most significant) of a `Sha2.Word`, in the style of the
corpus's own `Sha2.lengthByte`, returned as a `Nat`. The single cast to `BitVec 8` sits at the
`List.ofFn` site in `stateToBytes`, so `wordsOf32_stateToBytes` stays in `Nat` arithmetic. O(1). -/
def wordByte (w : Word) (j : Nat) : Nat :=
  (w.toNat / 2 ^ (8 * (3 - j))) % 256

/-- The 32-byte big-endian flattening of a chaining state: `H[i]` contributes
`H[i][4i] | H[i][4i+1] | H[i][4i+2] | H[i][4i+3]`. This is the store `sha256`'s last loop
performs, read in the message direction. O(32). -/
def stateToBytes (s : State) : List (BitVec 8) :=
  List.ofFn fun k : Fin 32 => (wordByte (s.getD (k / 4) 0) (k % 4) : BitVec 8)

/-- The regrouping read in the state direction: eight big-endian words from a byte list.
Same shape as the corpus's `private def Sha2.paddedBlock` (`Crypto/Sha2.lean:139`), with the
per-step `|||` and `% 2^32` replaced by `+` and a single trailing `% 2^32` read at `Nat`, cast once
by `BitVec.ofNat 32`; the accumulated value is below `2^32` at every step, so the two agree, and
`padBlock32_eq_paddedBlock` is named as an open obligation for the corpus side. -/
def wordsOf32 (b : List (BitVec 8)) : State :=
  Vector.ofFn fun i : Fin 8 =>
    BitVec.ofNat 32 (((List.range 4).foldl
      (fun (acc : Nat) j => acc * 256 + (b.getD (4 * i.val + j) 0).toNat) 0) % 4294967296)

private theorem vec_ofFn_getD' {α : Type} {n : Nat} [Inhabited α] (f : Fin n → α)
    (d : α) (i : Nat) (hi : i < n) : (Vector.ofFn f).getD i d = f ⟨i, hi⟩ := by
  simp [Vector.getD, hi]

private theorem list_ofFn_getD {α : Type} [Inhabited α] {n : Nat} (f : Fin n → α)
    (d : α) (i : Nat) (hi : i < n) : (List.ofFn f).getD i d = f ⟨i, hi⟩ := by
  simp [List.getD, List.getElem?_ofFn, hi]

private theorem natCast8_toNat (n : Nat) : ((n : Nat) : BitVec 8).toNat = n % 256 := by rfl

private theorem be4_read (w : Nat) (hw : w < 4294967296) :
    (((w / 16777216 % 256) * 256 + (w / 65536 % 256)) * 256 + (w / 256 % 256)) * 256
        + w % 256 = w := by
  omega

/-- **The re-encoding loses nothing.** Eight words through the 32-byte store and back are the
words that went in. Canonical-side `Nat`/`List` algebra, no hypothesis. This is what makes
`sha256d` a statement about a composition rather than about an encoding artefact. -/
theorem wordsOf32_stateToBytes (s : State) : wordsOf32 (stateToBytes s) = s := by
  refine vec_getD_eq (wordsOf32 (stateToBytes s)) s 0 fun i hi => ?_
  have hw : (s.getD i 0).toNat < 4294967296 := by
    have h2 := BitVec.toNat_lt_twoPow_of_le (m := 32) (n := 32) (le_refl 32)
      (x := s.getD i 0)
    rw [show (2 : Nat) ^ 32 = 4294967296 by norm_num] at h2
    exact h2
  have hread : ∀ j : Nat, j < 4 → ((stateToBytes s).getD (4 * i + j) 0).toNat
      = ((s.getD i 0).toNat / 2 ^ (8 * (3 - j))) % 256 := by
    intro j hj
    have hlt : 4 * i + j < 32 := by omega
    have h1 : (stateToBytes s).getD (4 * i + j) 0 =
        (wordByte (s.getD ((4 * i + j) / 4) 0) ((4 * i + j) % 4) : BitVec 8) := by
      rw [stateToBytes]
      exact list_ofFn_getD _ 0 (4 * i + j) hlt
    have hq : (4 * i + j) / 4 = i := by omega
    have hr : (4 * i + j) % 4 = j := by omega
    rw [h1, hq, hr, natCast8_toNat, wordByte]
    exact Nat.mod_mod _ _
  have hfold : (List.range 4).foldl
      (fun (acc : Nat) j => acc * 256 + ((stateToBytes s).getD (4 * i + j) 0).toNat) 0
      = (s.getD i 0).toNat := by
    have hr : List.range 4 = [0, 1, 2, 3] := rfl
    rw [hr]
    simp only [List.foldl_cons, List.foldl_nil]
    rw [hread 0 (by omega : 0 < 4), hread 1 (by omega : 1 < 4),
      hread 2 (by omega : 2 < 4), hread 3 (by omega : 3 < 4)]
    have hb := be4_read (s.getD i 0).toNat hw
    norm_num at hb ⊢
    exact hb
  rw [wordsOf32, vec_ofFn_getD' _ 0 i hi]
  rw [hfold]
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_ofNat, show (2 : Nat) ^ 32 = 4294967296 by norm_num]
  simp only [Nat.mod_eq_of_lt hw]

/-- The flattening is exactly thirty-two bytes, for every state. -/
theorem stateToBytes_length (s : State) : (stateToBytes s).length = 32 := by
  simp [stateToBytes, List.length_ofFn]

/-- **SHA-256d is the canonical `Sha2.hash` composed with itself**, across the big-endian 32-byte
store. Canonical-side: the composition, whose content is `wordsOf32_stateToBytes` (no information
is lost in the re-encoding) together with the block arithmetic below. -/
def sha256d (m : List (BitVec 8)) : State :=
  Apeiron.Crypto.Sha2.hash (stateToBytes (Apeiron.Crypto.Sha2.hash m))

/-- The composed map spelled out, so the two applications are visible in the log. -/
theorem sha256d_is_composition (m : List (BitVec 8)) :
    sha256d m = Apeiron.Crypto.Sha2.hash (stateToBytes (Apeiron.Crypto.Sha2.hash m)) := rfl

/-! ### Padding arithmetic, `Nat` only -/

/-- `Sha2.pad`'s padded length is `|m| + 9` rounded up to the next multiple of 64.
Canonical-side, no hypothesis. -/
theorem lengthBlock_length (n : Nat) : (lengthBlock n).length = 8 := by
  simp [lengthBlock]

theorem pad_len (m : List (BitVec 8)) :
    (pad m).length = m.length + 9 + (64 - (m.length + 9) % 64) % 64 := by
  have hz : pad m = m ++ [0x80] ++ List.replicate
      ((if (m.length + 9) % 64 = 0 then m.length + 9
        else m.length + 9 + (64 - (m.length + 9) % 64)) - m.length - 9) 0
      ++ lengthBlock m.length := rfl
  rw [hz]
  simp only [List.length_append, List.length_cons, List.length_nil, List.length_replicate,
    lengthBlock_length]
  by_cases h : (m.length + 9) % 64 = 0
  · simp only [h, if_true]
    omega
  · simp only [h, if_false]
    omega

/-- `Sha2.pad` produces a whole number of 64-byte blocks. -/
theorem pad_len_mod (m : List (BitVec 8)) : (pad m).length % 64 = 0 := by
  have h := pad_len m
  omega

/-- `Sha2.pad` adds at least the nine mandatory bytes. -/
theorem pad_len_ge (m : List (BitVec 8)) : m.length + 9 ≤ (pad m).length := by
  have h := pad_len m
  omega

/-- `Sha2.pad` adds at most seventy-two bytes. -/
theorem pad_len_le (m : List (BitVec 8)) : (pad m).length ≤ m.length + 72 := by
  have h := pad_len m
  omega

/-- **The second application is exactly one 64-byte block.** A 32-byte message plus the nine
mandatory padding bytes is 41, which rounds up to a single block. This is the padding arithmetic
that fixes the shape of the composition, and it is where the double construction differs from a
generic two-fold: the inner digest is always a single block, for every message and every length. -/
theorem pad_stateToBytes_length (s : State) : (pad (stateToBytes s)).length = 64 := by
  have h := pad_len (stateToBytes s)
  rw [stateToBytes_length] at h
  omega

/-- A padded message determines its message: the message is the length-many leading bytes. This is
the fact the outer application reads, since it is fed a 32-byte list of known length. -/
theorem pad_take (m : List (BitVec 8)) : (pad m).take m.length = m := by
  simp [pad]

/-- The block read of `Sha2.pad`: the corpus's `Sha2.paddedBlock` body (`Crypto/Sha2.lean:139`)
re-declared for a single block. The corpus's is `private`, so this is a re-declaration and
`padBlock32_eq_paddedBlock` is named as an open obligation. -/
def padBlock32 (p : List (BitVec 8)) : Block :=
  Vector.ofFn fun i : Fin 16 =>
    ((List.range 4).foldl
      (fun (acc : Nat) j => acc * 256 + (p.getD (4 * i.val + j) 0).toNat) 0) % 4294967296

/-- **The outer application is exactly one compression.** The 32-byte digest pads to exactly one
64-byte block, so `Sha2.hash` of it performs one compression and no more, for every state. This is
the whole outer half of the composition, arithmetically. The companion statement naming the
compression itself, `hash m = compress H0 (paddedBlock (pad m) 0)` for a one-block `m`, is
`hash_one_block_eq_compress_H0` below and is open: `Sha2.paddedBlock` is `private`
(`Crypto/Sha2.lean:139`), so its body cannot be read from outside the module. -/
theorem outer_compression_count (s : State) : (pad (stateToBytes s)).length / 64 = 1 := by
  rw [pad_stateToBytes_length]

/-! ## Section 2: domain, premises and exclusions inherited by the composition

The canonical object carries **no** `Nat.Prime`-style premise and no validity hypothesis:
`Sha2.pad` and `Sha2.hash` are closed on all `Nat` lengths, and every theorem of section 1 is
stated with no hypothesis. The `#check` lines below record the two types. What *is* inherited is
the 2^61-byte limit on the length field, which is arithmetic and is checked here. -/

#check @Apeiron.Crypto.Sha2.pad
#check @Apeiron.Crypto.Sha2.hash
#check @Apeiron.Crypto.Sha2.sha256
#check @Apeiron.Crypto.Sha2.lengthBlock

/-- The eight length bytes of a message of `0` bytes are zero. Canonical-side, `Nat` only, no
hypothesis. -/
theorem lengthBlock_zero : lengthBlock 0 = [0, 0, 0, 0, 0, 0, 0, 0] := by
  decide

/-- **The padding-domain limit, as a checked counterexample.** A message of `2^61` bytes and a
message of `0` bytes have the *same* eight length bytes. `8 * 2^61 = 2^64`, and
`Sha2.lengthByte` reads byte `i` as `(bits / 2^(8*(7-i))) % 256`, which is the base-256 digit of
`8n` read modulo `2^64`. So the length encoding is not injective on all `Nat`: the two
implementations agree on the *encoding* for every length, and neither represents the true bit length
at or above `2^61` bytes. Below that limit the encoding is faithful, and that is the domain a FIPS
180-4 certificate may claim. Canonical-side. -/
theorem lengthBlock_collapse : lengthBlock 2305843009213693952 = [0, 0, 0, 0, 0, 0, 0, 0] := by
  decide

/-- The two are literally the same canonical list, so the collapse is an equality of values and not
a statement about an encoding. -/
theorem lengthBlock_collapse_eq : lengthBlock 2305843009213693952 = lengthBlock 0 :=
  lengthBlock_collapse.trans lengthBlock_zero.symm

/-! ## Section 3: the `Cell`-expressible class, and why no sigma face escapes it

`Apeiron.Trichotomy.AnyRing.RingCell R = R * R` with
`ringMul sigma (a,b) (c,d) = (a*c + sigma*b*d, a*d + b*c)` (`AnyRing.lean:98-110`). Write
`CTerm sigma` for the expressions built from constant points, `+` and `ringMul sigma`.

The property used is one no ring polynomial over `ZMod (2^w)` can fail: preservation of the
congruence read at the ideal generated by `2^j`. Addition and multiplication both carry that ideal
into itself, so *any* expression, of any size, preserves it. `sigma` does not appear in that
argument. -/

variable {R : Type*} [CommRing R]
variable {σ : R}

/-- The congruence on `RingCell R` read at the ideal generated by `2^j`. -/
def Ccong (j : Nat) (u v : RingCell R) : Prop :=
  ∃ c : RingCell R, u - v = ((2 ^ j : Nat) : R) • c

/-- `f` preserves the `2^j`-congruence. -/
def CongPres (j : Nat) (f : RingCell R → RingCell R) : Prop :=
  ∀ (u v : RingCell R), Ccong j u v → Ccong j (f u) (f v)

/-- Adding the same point to a congruent pair stays congruent. -/
theorem Ccong_add_right (j : Nat) {u v w : RingCell R} (h : Ccong j u v) :
    Ccong j (u + w) (v + w) := by
  obtain ⟨c, hc⟩ := h
  refine ⟨c, ?_⟩
  have key : u + w - (v + w) = u - v := by
    apply Prod.ext <;> simp
  rw [key]
  exact hc

/-- Adding two congruent pairs stays congruent, with different offsets. The ideal is closed under
addition, so the two `2^j`-multiples add to one. -/
theorem Ccong_add (j : Nat) {a b c d : RingCell R} (h1 : Ccong j a b) (h2 : Ccong j c d) :
    Ccong j (a + c) (b + d) := by
  obtain ⟨x, hx⟩ := h1
  obtain ⟨y, hy⟩ := h2
  refine ⟨x + y, ?_⟩
  have key : (a + c) - (b + d) = (a - b) + (c - d) := by abel
  have sadd : (((2 ^ j : Nat) : R) • x) + (((2 ^ j : Nat) : R) • y)
      = ((2 ^ j : Nat) : R) • (x + y) := by
    apply Prod.ext
    · simp only [Prod.smul_fst, Prod.fst_add]
      ring
    · simp only [Prod.smul_snd, Prod.snd_add]
      ring
  rw [key, hx, hy, sadd]

/-- `Ccong` is transitive: the two witnessing multiples of `2^j` add, and the sum is again a
`2^j`-multiple, so the ideal generated by `2^j` is closed under addition. -/
theorem Ccong_trans {j : Nat} {a b c : RingCell R} (h1 : Ccong j a b) (h2 : Ccong j b c) :
    Ccong j a c := by
  obtain ⟨x, hx⟩ := h1
  obtain ⟨y, hy⟩ := h2
  refine ⟨x + y, ?_⟩
  have key : a - c = (a - b) + (b - c) := by abel
  rw [key, hx, hy]
  apply Prod.ext
  · simp only [Prod.smul_fst, Prod.fst_add]
    ring
  · simp only [Prod.smul_snd, Prod.snd_add]
    ring

/-- Multiplying a congruent pair by the same point stays congruent. `sigma` enters the first slot of
`ringMul` and cancels out of the argument. -/
theorem Ccong_mul_left (j : Nat) (w : RingCell R) {u v : RingCell R} (h : Ccong j u v) :
    Ccong j (ringMul σ u w) (ringMul σ v w) := by
  obtain ⟨c, hc⟩ := h
  obtain ⟨c1, c2⟩ := c
  refine ⟨ringMul σ ⟨c1, c2⟩ w, ?_⟩
  have hsub : ringMul σ u w - ringMul σ v w = ringMul σ (u - v) w := by
    calc ringMul σ u w - ringMul σ v w = ringMul σ w u - ringMul σ w v := by
          rw [ringMul_comm σ u w, ringMul_comm σ v w]
      _ = ringMul σ w (u - v) := (ringMul_distrib_sub _ _ _ _).symm
      _ = ringMul σ (u - v) w := ringMul_comm _ _ _
  rw [hsub, hc]
  simp only [ringMul, Prod.smul_def, Prod.fst_mul, Prod.snd_mul, Prod.fst_add, Prod.snd_add]
  apply Prod.ext <;> ring

/-- Expressions over constant points, `+` and `ringMul sigma`. -/
inductive CTerm (R : Type*) [CommRing R] (σ : R) : Type _ where
  /-- a constant point -/
  | pt : RingCell R → CTerm R σ
  /-- the algebra's addition -/
  | add : CTerm R σ → CTerm R σ → CTerm R σ
  /-- the algebra's multiplication -/
  | mul : CTerm R σ → CTerm R σ → CTerm R σ

/-- `CTerm.eval` reads an expression at a point. O(size). -/
def CTerm.eval : CTerm R σ → RingCell R → RingCell R
  | .pt z, _ => z
  | .add t u, x => t.eval x + u.eval x
  | .mul t u, x => ringMul σ (t.eval x) (u.eval x)

/-- **The class-level obstruction.** Every `Cell`-expressible map over `RingCell R` preserves the
`2^j`-congruence, for every `j`, at every `sigma`. By induction on the expression, so no bound on
size, depth or degree is used and no hypothesis on `R` or `sigma` appears. -/
theorem CTerm.cong_preserves : ∀ (t : CTerm R σ) (j : Nat),
    CongPres j (fun x => t.eval x) := by
  intro t j
  induction t with
  | pt z =>
      intro u v h
      obtain ⟨c, hc⟩ := h
      exact ⟨0, by simp [CTerm.eval]⟩
  | add t u iht ihu =>
      intro v w h
      exact Ccong_add j (iht v w h) (ihu v w h)
  | mul t u iht ihu =>
      intro v w h
      show Ccong j (ringMul σ (t.eval v) (u.eval v)) (ringMul σ (t.eval w) (u.eval w))
      have h1 : Ccong j (ringMul σ (t.eval v) (u.eval v))
          (ringMul σ (t.eval v) (u.eval w)) := by
        have hc : Ccong j (ringMul σ (u.eval v) (t.eval v))
            (ringMul σ (u.eval w) (t.eval v)) :=
          Ccong_mul_left j (t.eval v) (ihu v w h)
        rwa [ringMul_comm σ (u.eval v) (t.eval v),
          ringMul_comm σ (u.eval w) (t.eval v)] at hc
      exact Ccong_trans h1 (Ccong_mul_left j (u.eval w) (iht v w h))

/-- The class is closed under composition, at any height. -/
theorem CongPres_comp {j : Nat} {f g : RingCell R → RingCell R}
    (hf : CongPres j f) (hg : CongPres j g) : CongPres j (f ∘ g) :=
  fun u v h => hf (g u) (g v) (hg u v h)

/-- **No map that is `Cell`-expressible can break the `2^j`-congruence, however it is written and
however often it is composed.** The contrapositive is the form the primitives are refuted in: any
map that breaks the congruence is outside the class, so no number of `ringMul` and `+` steps
reaches it. -/
theorem no_cell_expr_congruence_violation (f : RingCell R → RingCell R)
    (hbad : ¬ CongPres 1 f) : ¬ ∃ (t : CTerm R σ), ∀ x, t.eval x = f x := by
  rintro ⟨t, ht⟩
  apply hbad
  intro u v huv
  obtain ⟨c, hc⟩ := t.cong_preserves 1 u v huv
  refine ⟨c, ?_⟩
  have key : f u - f v = t.eval u - t.eval v := by rw [ht u, ht v]
  rw [key, hc]

/-! ## Section 4: the obstruction is sigma-independent, at the three named faces

`WordRefinement.lean:35` denotes the executing dial as `denoteSigma : cell.Sigma -> ZMod (2^64)`
and `:29` maps `Elliptic |-> -1`, `Parabolic |-> 0`, `Hyperbolic |-> 1`. The obstruction of
section 3 is stated for every `sigma`, so each face is an instance of it; these three rows make
"under any named sigma face" checkable without re-deriving the argument. -/

theorem denoteSigma_elliptic_face :
    apeiron_word.denoteSigma apeiron_word.cell.Sigma.Elliptic = (-1 : ZMod (2 ^ 64)) := by
  rfl

theorem denoteSigma_parabolic_face :
    apeiron_word.denoteSigma apeiron_word.cell.Sigma.Parabolic = (0 : ZMod (2 ^ 64)) := by
  rfl

theorem denoteSigma_hyperbolic_face :
    apeiron_word.denoteSigma apeiron_word.cell.Sigma.Hyperbolic = (1 : ZMod (2 ^ 64)) := by
  rfl

/-- **At the elliptic face (`sigma = -1` over `ZMod (2^64)`), every `Cell`-expressible map preserves
the `2^j`-congruence, for every `j`.** -/
theorem cell_expr_cong_preserves_elliptic (t : CTerm (ZMod (2 ^ 64)) (-1)) (j : Nat) :
    CongPres j (fun x => t.eval x) := t.cong_preserves j

/-- At the parabolic face (`sigma = 0`), likewise. -/
theorem cell_expr_cong_preserves_parabolic (t : CTerm (ZMod (2 ^ 64)) 0) (j : Nat) :
    CongPres j (fun x => t.eval x) := t.cong_preserves j

/-- At the hyperbolic face (`sigma = 1`), likewise. -/
theorem cell_expr_cong_preserves_hyperbolic (t : CTerm (ZMod (2 ^ 64)) 1) (j : Nat) :
    CongPres j (fun x => t.eval x) := t.cong_preserves j

/-! ## Section 5: where the obstruction lives, at the canonical 32-bit width

`Cmod1 u v` says `u` and `v` agree in bit 1, that is, they are congruent modulo `2`. It is stated
on the natural reading of a word, so it is decidable on numerals at every width. `Sha2.Word` is
`BitVec 32` (`Crypto/Sha2.lean:22`), so `rotr`, `shrx`, `sigma0`, `sigma1`, `Sigma0` and `Sigma1`
below are the corpus's own definitions. -/

/-- `u` and `v` agree in bit 1, that is, they are congruent modulo `2`. `abbrev`, so that the
`Decidable` instance a numeral witness needs is found. -/
abbrev Cmod1 {w : Nat} (u v : BitVec w) : Prop := (u.toNat ^^^ v.toNat) % 2 = 0

/-- **`ROTR` is not congruence-preserving.** At `n = 2` the rotation of `0` is `0` and the rotation of
`4 = 2^2` is `1`, which differ in bit 1 while `0` and `4` agree in it. -/
theorem rot_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (rotr u 2) (rotr v 2)) :=
  fun h => absurd (h (0 : Word) 4 (by decide)) (by decide)

/-- **`SHR` is not congruence-preserving.** At `n = 1`, `0` shifts to `0` and `2 = 2^1` shifts to
`1`. -/
theorem shr_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (shrx u 1) (shrx v 1)) :=
  fun h => absurd (h (0 : Word) 2 (by decide)) (by decide)

/-! ### The four FIPS 180-4 `Sigma`/`sigma` primitives, one application each -/

/-- `Sigma0(0) = 0` and `Sigma0(4 = 2^2) = 0x00201001`, whose bit 1 is set while `0` and `4` agree
in it: `Sigma0` is not congruence-preserving. -/
theorem Sigma0_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (Sigma0 u) (Sigma0 v)) :=
  fun h => absurd (h (0 : Word) 4 (by decide)) (by decide)

/-- `Sigma1` likewise: `Sigma1(0) = 0` and `Sigma1(64 = 2^6) = 0x08002001`. -/
theorem Sigma1_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (Sigma1 u) (Sigma1 v)) :=
  fun h => absurd (h (0 : Word) 64 (by decide)) (by decide)

/-- The message schedule's `sigma0`: `sigma0(0) = 0` and `sigma0(8 = 2^3) = 0x10020001`. -/
theorem sigma0_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (sigma0 u) (sigma0 v)) :=
  fun h => absurd (h (0 : Word) 8 (by decide)) (by decide)

/-- The message schedule's `sigma1`: `sigma1(0) = 0` and `sigma1(1024 = 2^10) = 0x02800001`. -/
theorem sigma1_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (sigma1 u) (sigma1 v)) :=
  fun h => absurd (h (0 : Word) 1024 (by decide)) (by decide)

/-! ### The bitwise-local primitives carry no bit-1 obstruction

The corpus's `Sha2.rotr`, `Sha2.shrx`, `Sha2.choose` and `Sha2.majority` are stated at `Word`, so the
four rows below re-declare those bodies at an arbitrary width `w`, exactly as `AlgebraChi` does for
`Crypto.Keccak.Round.theta`/`chi`, and check them exhaustively by `decide` at `BitVec 3`, where bit
1 is a middle bit and all three bit positions are present. These are **small-width checks, not
width-32 general theorems**; the general form of each is named as an open obligation in
`AlgebraSha256d.md`. Their content is the localisation: the congruence obstruction of section 5 is
carried entirely by the two bit-*moving* primitives `rotr` and `shrx`, not by the bitwise-local
ones. The XOR obstruction carried by the ops map (`AlgebraRotate.xor_not_affine_ZMod16`) is a
*non-affinity* obstruction in `ZMod (2^16)`, a different property, which these rows do not touch. -/

/-- The corpus's `Sha2.rotr` body at an arbitrary width. O(1). -/
def rotrW {w : Nat} (x : BitVec w) (n : Nat) : BitVec w :=
  (x >>> (n % 32)) ||| (x <<< ((32 - n) % 32))

/-- The corpus's `Sha2.shrx` body at an arbitrary width. O(1). -/
def shrxW {w : Nat} (x : BitVec w) (n : Nat) : BitVec w := x >>> (n % 32)

/-- The corpus's `Sha2.choose` body at an arbitrary width. O(1). -/
def chooseW {w : Nat} (x y z : BitVec w) : BitVec w := (x &&& y) ^^^ (~~~x &&& z)

/-- The corpus's `Sha2.majority` body at an arbitrary width. O(1). -/
def majorityW {w : Nat} (x y z : BitVec w) : BitVec w := (x &&& y) ^^^ (x &&& z) ^^^ (y &&& z)

theorem xor_no_obstruction_w3 :
    ∀ (u v y : BitVec 3), Cmod1 u v → Cmod1 (u ^^^ y) (v ^^^ y) := by decide

theorem and_no_obstruction_w3 :
    ∀ (u v y : BitVec 3), Cmod1 u v → Cmod1 (u &&& y) (v &&& y) := by decide

theorem choose_no_obstruction_w3 :
    ∀ (u v f g : BitVec 3), Cmod1 u v → Cmod1 (chooseW u f g) (chooseW v f g) := by decide

theorem majority_no_obstruction_w3 :
    ∀ (u v b c : BitVec 3), Cmod1 u v → Cmod1 (majorityW u b c) (majorityW v b c) := by decide

theorem rot_not_cong_pres_w3 :
    ¬ (∀ (u v : BitVec 3), Cmod1 u v → Cmod1 (rotrW u 2) (rotrW v 2)) := by decide

theorem shr_not_cong_pres_w3 :
    ¬ (∀ (u v : BitVec 3), Cmod1 u v → Cmod1 (shrxW u 1) (shrxW v 1)) := by decide

/-! ## Section 6: the iteration verdict

The question the wave poses: does applying the map twice make the algebraic obstruction better or
worse? Three answers, all kernel-checked.

**(a) In the algebra-native language, twice is no better than once, at any height.**
`CongPres_comp` is composition-closed and `CTerm.cong_preserves` is by induction on the expression,
so a tower of any height is still congruence-preserving and still cannot be a rotation or a shift.
Iteration adds no expressive power to the class.

**(b) On the concrete maps, doubling does not repair the witness.** Each of the four FIPS 180-4
`Sigma`/`sigma` primitives keeps a bit-1 witness under its own square, at width 32, with the
specification's own offsets. These are the numerals. -/

/-- **The `Sigma0` obstruction survives its own square.** `Sigma0(Sigma0(16 = 2^4)) = 0x01000401`,
whose bit 1 is set, and `0` and `16` agree in bit 1. So `(u,v) = (0,16)` witnesses that
`Sigma0 o Sigma0` is not congruence-preserving: doubling the application does not cancel the
rotation offset, at the real width and the real offsets. -/
theorem Sigma0_double_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (Sigma0 (Sigma0 u)) (Sigma0 (Sigma0 v))) :=
  fun h => absurd (h (0 : Word) 16 (by decide)) (by decide)

/-- **The `Sigma1` obstruction survives its own square**:
`Sigma1(Sigma1(4096 = 2^12)) = 0x04400001`. -/
theorem Sigma1_double_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (Sigma1 (Sigma1 u)) (Sigma1 (Sigma1 v))) :=
  fun h => absurd (h (0 : Word) 4096 (by decide)) (by decide)

/-- **The message schedule's `sigma0` obstruction survives its own square**:
`sigma0(sigma0(16 = 2^4)) = 0x00400001`. -/
theorem sigma0_double_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (sigma0 (sigma0 u)) (sigma0 (sigma0 v))) :=
  fun h => absurd (h (0 : Word) 16 (by decide)) (by decide)

/-- **The message schedule's `sigma1` obstruction survives its own square**:
`sigma1(sigma1(4 = 2^2)) = 0x100000a1`. -/
theorem sigma1_double_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (sigma1 (sigma1 u)) (sigma1 (sigma1 v))) :=
  fun h => absurd (h (0 : Word) 4 (by decide)) (by decide)

/-! **(c) A checked small-width counterexample: iteration *can* repair a bit-moving obstruction, and
the reason it does not do so for SHA-2 is the offsets, not the depth. -/

/-- The *width-scaled* rotation, `ROTR` as FIPS 180-4 intends it: both shift amounts are read
modulo `w`, not modulo 32. This is not the corpus's `Sha2.rotr` body, which reads them modulo 32 and
therefore degenerates at any width other than 32; that difference is what row
`rot4_corpus_body_degenerates` records. O(1). -/
def rotrS (w : Nat) (x : BitVec w) (n : Nat) : BitVec w :=
  (x >>> (n % w)) ||| (x <<< ((w - n) % w))

/-- **Rotation by two at width 4 *is* repaired by doubling.** `(x >>> 2 | x <<< 2)` composed with
itself is `x >>> 0 | x <<< 0`, the identity on `BitVec 4`, because `2 + 2` vanishes modulo the
width. This is the checked small-width counterexample showing that iteration *can* repair a
bit-moving obstruction, against the four `double_not_cong_pres` rows above showing it does not for
SHA-2. -/
theorem rotS4_double_is_id : ∀ x : BitVec 4, rotrS 4 (rotrS 4 x 2) 2 = x := by decide

/-- **The corpus's `Sha2.rotr` body does not degenerate, at width 32.** Doubling a rotation by two is
a rotation by four, which is not the identity: `rotrW (rotrW 16 2) 2 = 1`, whose low bit is set while
`0` and `16 = 2^4` agree in it. So at the width the corpus's body is defined for, doubling does not
repair the rotation obstruction either. -/
theorem rot32_double_not_cong_pres :
    ¬ (∀ (u v : Word), Cmod1 u v → Cmod1 (rotrW (rotrW u 2) 2) (rotrW (rotrW v 2) 2)) :=
  fun h => absurd (h (0 : Word) 16 (by decide)) (by decide)

/-- **`SHR` by one at width 4 is *not* repaired by doubling.** `(x >>> 1) >>> 1 = x >>> 2`, and `3` and
`7` agree in bit 0 while `3 >>> 2 = 0` and `7 >>> 2 = 1` do not, so `(u,v) = (3,7)` is the witness.
Same width as the rotation row above, opposite verdict. The row is `by decide` over the sixteen
4-bit words, so the decider, not this prose, is what fixes the witness. -/
theorem shr4_double_not_cong_pres :
    ¬ (∀ (u v : BitVec 4), Cmod1 u v → Cmod1 (shrxW (shrxW u 1) 1) (shrxW (shrxW v 1) 1)) := by decide

