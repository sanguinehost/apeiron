import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Tactic

/-!
# The RoPE orbit: the per-position cos/sin table is generated by the group law

Rotary position embedding evaluates the pair `ρ(θ) = (cos θ, sin θ)` at every position. This module
proves the group structure that lets a run generate that table instead of evaluating a
transcendental at each position: one `rhoMul` per step, `O(1)` work, after the single evaluation of
`rho θ`.

The object is the unit circle `T = {(c, s) | c² + s² = 1}` with complex multiplication restricted
to it, `rhoMul a b = (a.1 b.1 − a.2 b.2, a.1 b.2 + a.2 b.1)`. The map `rho : ℝ → T`,
`θ ↦ (cos θ, sin θ)` is a homomorphism from the additive group of angles:

* `rho_add`: `ρ(m + n) = ρ(m) ρ(n)`.
* `rho_nat`: `ρ(k · θ) = ρ(θ)^k`, where `rhoPow k z` is `z` multiplied by itself `k` times. So the
  table of positions `0, 1, …, k` is the orbit of the single point `rho θ` under `rhoMul`.
* `rho_sub` and `rho_relative`: the rotation by `nθ` after the inverse rotation by `mθ` is the
  rotation by `(n − m)θ`. In matrix form `rotMat_relative`: `R_mᵀ R_n = R_{n−m}`, so the attention
  score `⟨R_m u, R_n v⟩ = uᵀ R_mᵀ R_n v` depends only on the position difference `n − m`.

Topologically the statement is that `ρ` is a one-parameter subgroup: the homomorphism
`ℤ → T`, `k ↦ ρ(kθ)`, generated by the single element `rho θ` (the circle `T` is the compact
one-parameter group, Euler's `e^{iθ} = cos θ + i sin θ`; the real and imaginary parts are the two
coordinates used here).

The rotor element `rho` is defined here rather than reusing `Substrate.Algebra.Neural.AttentionSpinor.rotor`:
that `rotor` has type `ℝ → ℝ → ℝ → ℝ × ℝ` (it acts on a vector), so it does not fit the element type
`ℝ → ℝ × ℝ`. Left multiplication by `rho θ` under `rhoMul` is that action.

## Trust boundary

The statements are about the real-valued reference `ℝ`. They do not reach `rustc`/LLVM, the kernel
ABI, or the fixed-point extraction: the constant cost per step is a counting statement, not a
measurement (`AGENTS.md` §10).
-/

noncomputable section

open scoped Matrix

namespace Nous.Model

/-- The RoPE rotor element `ρ(θ) = (cos θ, sin θ)`, a point of the unit circle.

    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
def rho (θ : ℝ) : ℝ × ℝ := (Real.cos θ, Real.sin θ)

/-- The angle-addition product `rhoMul a b = (a.1 b.1 − a.2 b.2, a.1 b.2 + a.2 b.1)`: complex
    multiplication restricted to the unit circle.

    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
def rhoMul (z w : ℝ × ℝ) : ℝ × ℝ :=
  (z.1 * w.1 - z.2 * w.2, z.1 * w.2 + z.2 * w.1)

/-- The `k`-fold `rhoMul` product of `z` with itself, from the unit `(1, 0)`: the orbit point
    `z^k`.

    ℕ   [the counting numbers 0, 1, 2, 3, and so on]
    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
def rhoPow : ℕ → ℝ × ℝ → ℝ × ℝ
  | 0, _ => (1, 0)
  | k + 1, z => rhoMul (rhoPow k z) z

/-- One power unfolds: `rhoPow (k + 1) z = rhoMul (rhoPow k z) z`.

    ℕ   [the counting numbers 0, 1, 2, 3, and so on]
    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
theorem rhoPow_succ (k : ℕ) (z : ℝ × ℝ) : rhoPow (k + 1) z = rhoMul (rhoPow k z) z := rfl

/-- **The homomorphism law**: `ρ(m + n) = ρ(m) ρ(n)`; the angles add under `rhoMul`.

    ℝ   [the real numbers: every number on the number line] -/
theorem rho_add (θ φ : ℝ) : rho (θ + φ) = rhoMul (rho θ) (rho φ) := by
  apply Prod.ext
  · simp only [rho, rhoMul, Real.cos_add]
  · simp only [rho, rhoMul, Real.sin_add]; ring

/-- **The orbit-power form**: `ρ(k · θ) = ρ(θ)^k`; the table over positions is the orbit of the
    single point `rho θ` under `rhoMul`.

    ℝ   [the real numbers: every number on the number line]
    ℕ   [the counting numbers 0, 1, 2, 3, and so on] -/
theorem rho_nat (θ : ℝ) (k : ℕ) : rho ((k : ℝ) * θ) = rhoPow k (rho θ) := by
  induction k with
  | zero => simp [rho, rhoPow]
  | succ k ih =>
    have h : ((k + 1 : ℕ) : ℝ) * θ = (k : ℝ) * θ + θ := by push_cast; ring
    rw [h, rho_add, ih, rhoPow_succ]

/-- `rhoMul` is associative: the angle-addition product is complex multiplication.

    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
theorem rhoMul_assoc (a b c : ℝ × ℝ) :
    rhoMul (rhoMul a b) c = rhoMul a (rhoMul b c) := by
  apply Prod.ext <;> simp only [rhoMul] <;> ring

/-- The inverse: `rhoMul (rho θ) (rho (-θ))` is the identity `(1, 0)`.

    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
theorem rhoMul_rho_neg (θ : ℝ) : rhoMul (rho θ) (rho (-θ)) = (1, 0) := by
  rw [← rho_add]
  simp [rho]

/-- **`rho_sub`**: the rotation by `θ − φ` is multiplication by `rho θ` and the inverse
    `rho (-φ)`, `rhoMul (rho θ) (rho (-φ))`.

    ℝ   [the real numbers: every number on the number line] -/
theorem rho_sub (θ φ : ℝ) : rho (θ - φ) = rhoMul (rho θ) (rho (-φ)) := by
  rw [sub_eq_add_neg, rho_add]

/-- **The relative-position corollary**: the rotation by `nθ` applied after the inverse rotation
    by `mθ` is the rotation by `(n − m)θ`, so it depends only on the difference.

    ℝ   [the real numbers: every number on the number line]
    ℕ   [the counting numbers 0, 1, 2, 3, and so on] -/
theorem rho_relative (m n : ℕ) (θ : ℝ) :
    rhoMul (rho (-((m : ℝ) * θ))) (rho ((n : ℝ) * θ)) = rho (((n : ℝ) - (m : ℝ)) * θ) := by
  rw [← rho_add]
  congr 1
  ring

/-- The rotation of a vector `(x, y)` by the angle `θ`: left multiplication by `rho θ` under
    `rhoMul`, matching `Substrate.Algebra.Neural.AttentionSpinor.rotor` on the coordinates.

    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
def rhoAct (θ : ℝ) (z : ℝ × ℝ) : ℝ × ℝ := rhoMul (rho θ) z

/-- The inner product `rhoDot z w = z.1 w.1 + z.2 w.2` of two plane vectors.

    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
def rhoDot (z w : ℝ × ℝ) : ℝ := z.1 * w.1 + z.2 * w.2

/-- Rotations compose: `rhoAct θ (rhoAct φ z) = rhoAct (θ + φ) z`.

    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
theorem rhoAct_add (θ φ : ℝ) (z : ℝ × ℝ) :
    rhoAct θ (rhoAct φ z) = rhoAct (θ + φ) z := by
  simp only [rhoAct]
  rw [← rhoMul_assoc, rho_add]

/-- The rotation is an isometry of the inner product: `rhoDot (rhoAct θ z) (rhoAct θ w) =
    rhoDot z w`.

    ℝ   [the real numbers: every number on the number line]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
theorem rhoDot_act (θ : ℝ) (z w : ℝ × ℝ) :
    rhoDot (rhoAct θ z) (rhoAct θ w) = rhoDot z w := by
  have h : Real.cos θ ^ 2 + Real.sin θ ^ 2 = 1 := Real.cos_sq_add_sin_sq θ
  simp only [rhoAct, rhoMul, rho, rhoDot]
  linear_combination (z.1 * w.1 + z.2 * w.2) * h

/-- **Why the attention score depends only on the position difference**: with query at position
    `m` and key at position `n`, the score `⟨R_m u, R_n v⟩` equals `⟨u, R_{n−m} v⟩`.

    ℝ   [the real numbers: every number on the number line]
    ℕ   [the counting numbers 0, 1, 2, 3, and so on]
    ×   [paired with, so ℝ × ℝ means two real numbers side by side] -/
theorem rho_relative_score (m n : ℕ) (θ : ℝ) (u v : ℝ × ℝ) :
    rhoDot (rhoAct ((m : ℝ) * θ) u) (rhoAct ((n : ℝ) * θ) v)
      = rhoDot u (rhoAct (((n : ℝ) - (m : ℝ)) * θ) v) := by
  have hcomp : rhoAct ((n : ℝ) * θ) v
      = rhoAct ((m : ℝ) * θ) (rhoAct (((n : ℝ) - (m : ℝ)) * θ) v) := by
    rw [rhoAct_add]
    congr 1
    ring
  rw [hcomp, rhoDot_act]

/-- The rotation matrix `R(θ)` acting on column vectors.

    ℝ   [the real numbers: every number on the number line] -/
def rotMat (θ : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  !![Real.cos θ, -Real.sin θ; Real.sin θ, Real.cos θ]

/-- The rotation matrices compose: `R(θ) R(φ) = R(θ + φ)`.

    ℝ   [the real numbers: every number on the number line] -/
theorem rotMat_mul (θ φ : ℝ) : rotMat θ * rotMat φ = rotMat (θ + φ) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [rotMat, Matrix.mul_apply, Fin.sum_univ_two] <;>
    (first | rw [Real.cos_add] | rw [Real.sin_add]) <;> ring

/-- The transpose of a rotation is the inverse rotation: `R(θ)ᵀ = R(−θ)`.

    ℝ   [the real numbers: every number on the number line] -/
theorem rotMat_transpose (θ : ℝ) : (rotMat θ)ᵀ = rotMat (-θ) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [rotMat, Matrix.transpose_apply]

/-- **The `R_mᵀ R_n` relative-position form**: the transpose of the rotation by `mθ` times the
    rotation by `nθ` is the rotation by `(n − m)θ`; the attention score `⟨R_m u, R_n v⟩` therefore
    depends only on the position difference `n − m`.

    ℝ   [the real numbers: every number on the number line]
    ℕ   [the counting numbers 0, 1, 2, 3, and so on] -/
theorem rotMat_relative (m n : ℕ) (θ : ℝ) :
    (rotMat ((m : ℝ) * θ))ᵀ * rotMat ((n : ℝ) * θ) = rotMat (((n : ℝ) - (m : ℝ)) * θ) := by
  rw [rotMat_transpose, rotMat_mul]
  congr 1
  ring

/-- **The RoPE generation law**: the homomorphism law and the orbit-power form together. One
    evaluation of `rho θ` fixes the whole per-position table; each further position is one
    `O(1)` `rhoMul` step.

    ℝ   [the real numbers: every number on the number line]
    ℕ   [the counting numbers 0, 1, 2, 3, and so on]
    ∧   [both are true] -/
theorem rope_orbit (θ φ : ℝ) (k : ℕ) :
    rho (θ + φ) = rhoMul (rho θ) (rho φ) ∧ rho ((k : ℝ) * θ) = rhoPow k (rho θ) :=
  ⟨rho_add θ φ, rho_nat θ k⟩

end Nous.Model

end
