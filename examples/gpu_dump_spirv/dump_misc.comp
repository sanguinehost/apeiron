#version 460

// Elementwise kernels of the GPU forward dump (examples/gpu_dump.rs), selected at compile time:
//   -DOP=0 rmsnorm   Y[t][i] = X[t][i] * (1 / sqrt(mean(X[t]^2) + eps)) * gain[i]; one workgroup a row,
//                    f32 tree sum of squares over 256 lanes. params: 0 d, 1 eps (float bits), 2 gain_off, 3 rows
//                    bindings: 1 X, 2 gain (the bias/gain buffer), 3 Y.   Dispatch (rows, 1, 1).
//   -DOP=1 rope      half-split rotary on `rows` rows of `heads` heads of width 2 half: for pair j,
//                    D[r][h][j] = x0 c - x1 s, D[r][h][j+half] = x1 c + x0 s, (c, s) = CS[cs_row0 + r][j]
//                    (f32 pairs rounded from the f64 table); D rows start at dst_row0.
//                    params: 0 rows, 1 heads, 2 half, 3 cs_row0, 4 dst_row0
//                    bindings: 1 CS, 2 S (source), 3 D (destination).   Dispatch (ceil(rows heads half / 256), 1, 1).
//   -DOP=2 silu*up   G[i] = G[i] / (1 + exp(-G[i])) * U[i] over n vec4 words. params: 0 n4
//                    bindings: 1 G (read/write), 2 U.   Dispatch (ceil(n4 / 256), 1, 1).

#ifndef OP
#define OP 0
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer P_ { uint p[]; };

#if OP == 0
layout(set = 0, binding = 1, std430) readonly buffer X_ { float x[]; };
layout(set = 0, binding = 2, std430) readonly buffer G_ { float gain[]; };
layout(set = 0, binding = 3, std430) writeonly buffer Y_ { float y[]; };
shared float red[256];
void main() {
    const uint d = p[0], tid = gl_LocalInvocationIndex;
    const uint base = gl_WorkGroupID.x * d;
    float s = 0.0;
    for (uint i = tid; i < d; i += 256u) {
        const float v = x[base + i];
        s = fma(v, v, s);
    }
    red[tid] = s;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1) {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    const float r = 1.0 / sqrt(red[0] / float(d) + uintBitsToFloat(p[1]));
    for (uint i = tid; i < d; i += 256u) y[base + i] = x[base + i] * r * gain[p[2] + i];
}
#elif OP == 1
layout(set = 0, binding = 1, std430) readonly buffer C_ { vec2 cs[]; };
layout(set = 0, binding = 2, std430) readonly buffer S_ { float s[]; };
layout(set = 0, binding = 3, std430) writeonly buffer D_ { float d[]; };
void main() {
    const uint rows = p[0], heads = p[1], half_ = p[2];
    const uint g = gl_GlobalInvocationID.x;
    if (g >= rows * heads * half_) return;
    const uint j = g % half_;
    const uint h = (g / half_) % heads;
    const uint r = g / (half_ * heads);
    const vec2 c = cs[(p[3] + r) * half_ + j];
    const uint sb = (r * heads + h) * 2u * half_ + j;
    const uint db = ((p[4] + r) * heads + h) * 2u * half_ + j;
    const float x0 = s[sb], x1 = s[sb + half_];
    d[db] = x0 * c.x - x1 * c.y;
    d[db + half_] = x1 * c.x + x0 * c.y;
}
#else
layout(set = 0, binding = 1, std430) buffer G_ { vec4 g[]; };
layout(set = 0, binding = 2, std430) readonly buffer U_ { vec4 u[]; };
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p[0]) return;
    const vec4 a = g[i];
    g[i] = a / (1.0 + exp(-a)) * u[i];
}
#endif
