#version 450
// The placement of `engine::kern::limb::Layout::placement` and the shift table of
// `gpu::limb::LimbGemm::run` on the device, from the block exponents `limb_plane.comp` leaves in
// E_A and E_B. Consumer: `src/gpu/limb.rs`, which owns the contract this file computes.
//
// One workgroup per pair group g; its 64 invocations stride over the group's (segment, block)
// entries. Segment k holds pc pairs of one level s + t, so one placement exponent per (k, block):
//   T = e_a[b] + e_b[b] − 7·(s + t + 2);  T > 91 sets RANGE;  live iff T ≥ 8.
// tmin_g is the least live T of the group (0, every shift DEAD, when none is live). A live entry's
// shift is T − tmin_g, a dead one's DEAD. The host's 64-bit accumulator bound
// Σ pc·2^(17 + sh) < 2^63 is Σ pc·2^sh < 2^46: a shift above 45 fails it alone, so FALLBACK is set
// there or when the group's sum reaches 2^46. Partial sums saturate at 2^46, which keeps the
// comparison exact and the 64-invocation tree sum below 2^52.
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer EA { uint ea[]; };
layout(std430, binding = 1) readonly buffer EB { uint eb[]; };
// META: [blocks, limbs, mp, pp, off_groups, off_segs, off_pairs, off_shift], then the groups
// (first segment, end segment), the segments (first pair, pair count), the pairs (s, t) and the
// shift table [segment][block], which this kernel writes.
layout(std430, binding = 2) buffer M { uint meta[]; };
// OUT: [RANGE, FALLBACK, tmin per group]; the host zeroes the two flags.
layout(std430, binding = 3) buffer O { uint range; uint fallback; uint tmin[]; };

const uint DEAD = 0xFFFFFFFFu;
const int NONE = 0x7FFFFFFF;
const uint64_t CAP = uint64_t(1) << 46u;

shared int smin[64];
shared uint64_t ssum[64];

void main() {
    const uint g = gl_WorkGroupID.x;
    const uint li = gl_LocalInvocationIndex;
    const uint blocks = meta[0];
    const uint off_groups = meta[4];
    const uint off_segs = meta[5];
    const uint off_pairs = meta[6];
    const uint off_shift = meta[7];
    const uint s0 = meta[off_groups + 2u * g];
    const uint s1 = meta[off_groups + 2u * g + 1u];
    const uint entries = (s1 - s0) * blocks;

    int lo = NONE;
    bool over = false;
    for (uint i = li; i < entries; i += 64u) {
        const uint k = s0 + i / blocks;
        const uint b = i - (k - s0) * blocks;
        const uint p0 = meta[off_segs + 2u * k];
        const uint level = meta[off_pairs + 2u * p0] + meta[off_pairs + 2u * p0 + 1u];
        const int t = int(ea[b]) + int(eb[b]) - 7 * int(level + 2u);
        over = over || t > 91;
        if (t >= 8) {
            lo = min(lo, t);
        }
    }
    if (over) {
        atomicOr(range, 1u);
    }
    smin[li] = lo;
    barrier();
    for (uint w = 32u; w > 0u; w >>= 1u) {
        if (li < w) {
            smin[li] = min(smin[li], smin[li + w]);
        }
        barrier();
    }
    const int gmin = smin[0];

    uint64_t acc = 0ul;
    bool wide = false;
    for (uint i = li; i < entries; i += 64u) {
        const uint k = s0 + i / blocks;
        const uint b = i - (k - s0) * blocks;
        const uint p0 = meta[off_segs + 2u * k];
        const uint pc = meta[off_segs + 2u * k + 1u];
        const uint level = meta[off_pairs + 2u * p0] + meta[off_pairs + 2u * p0 + 1u];
        const int t = int(ea[b]) + int(eb[b]) - 7 * int(level + 2u);
        uint sh = DEAD;
        if (t >= 8) {
            sh = uint(t - gmin);
            if (sh > 45u) {
                wide = true;
            } else {
                acc = min(acc + (uint64_t(pc) << sh), CAP);
            }
        }
        meta[off_shift + k * blocks + b] = sh;
    }
    ssum[li] = acc;
    barrier();
    for (uint w = 32u; w > 0u; w >>= 1u) {
        if (li < w) {
            ssum[li] += ssum[li + w];
        }
        barrier();
    }
    if (wide || (li == 0u && ssum[0] >= CAP)) {
        atomicOr(fallback, 1u);
    }
    if (li == 0u) {
        tmin[g] = gmin == NONE ? 0u : uint(gmin);
    }
}
