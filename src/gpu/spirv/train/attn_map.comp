#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
// The attention prep of one layer: the per-head query/key normalisation, the gate split and the
// rotary embedding, gated (the output gate of Qwen3.5's attention) or ungated (Qwen3's, no gate).
// Consumer: `src/gpu/nn/train/{mixer,front}.rs`, which own the contract; the reference is the CPU
// path (`engine::step::cols::softmax_cols_tap`).
//
// One workgroup per (row, slot), slot < NH a query head, else a key head: split the query row into q
// and gate (gated: q at h·2·HD and gate at h·2·HD + HD; ungated: q at h·HD and no gate),
// RMS-normalise the head with its gain (q gains at 0, k gains at HD), then rotate the first ROT dims
// at position row mod n_ctx in NEOX pairs (x_j, x_{j + ROT/2}) by angle pos·θ^(−2j/ROT).
//
// The attention itself is the engine kernel's KD face, `src/gpu/spirv/attn_coopmat_kd.spv`
// (bf16 x bf16 -> f32 cooperative matrix, causal online softmax, `src/gpu/nn/attn/kd.rs`): this
// file's attend stage was deleted rather than kept as a second forward.
//
// Bindings: 1 qf [T][NH·2·HD] gated, [T][NH·HD] ungated; 2 kf [T][NKV·HD]; 3 gains [2·HD];
// 4 q [T][NH·HD]; 5 gate [T][NH·HD] (written only when gated); 6 k [T][NKV·HD]. Bindings 7 and 8
// (`v`, `out`) are declared so the callers' descriptor set keeps its shape and are never touched.
layout(local_size_x = 256) in;

// META: [flag, n_ctx, NH, NKV, HD, ROT, theta bits, eps bits, workgroups]; the grid is folded
// into x < 65535 and y. Bit 2 of `flag` means ungated: no gate half in qf. Bits 0-1 are the retired
// stage selector, kept at 0 by every caller.
layout(std430, binding = 0) readonly buffer Meta { uint meta[]; };
layout(std430, binding = 1) readonly buffer Qf { float qf[]; };
layout(std430, binding = 2) readonly buffer Kf { float kf[]; };
layout(std430, binding = 3) readonly buffer Gains { float gains[]; };
layout(std430, binding = 4) buffer Q { float q[]; };
layout(std430, binding = 5) buffer Gate { float gate[]; };
layout(std430, binding = 6) buffer K { float k[]; };
layout(std430, binding = 7) readonly buffer Vv { float v[]; };
layout(std430, binding = 8) writeonly buffer Out { float o[]; };

shared float xs[256];
shared float red[64];

void main() {
    bool ungated = (meta[0] & 4u) != 0u;
    uint n_ctx = meta[1];
    uint NH = meta[2];
    uint NKV = meta[3];
    uint HD = meta[4];
    uint ROT = meta[5];
    float theta = uintBitsToFloat(meta[6]);
    float eps = uintBitsToFloat(meta[7]);
    uint lid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    if (wg >= meta[8]) {
        return;
    }
    {
        uint slots = NH + NKV;
        uint row = wg / slots;
        uint slot = wg % slots;
        bool is_q = slot < NH;
        float x = 0.0;
        if (lid < HD) {
            if (is_q) {
                if (ungated) {
                    x = qf[row * NH * HD + slot * HD + lid];
                } else {
                    uint b = row * NH * 2u * HD + slot * 2u * HD;
                    x = qf[b + lid];
                    gate[(row * NH + slot) * HD + lid] = qf[b + HD + lid];
                }
            } else {
                x = kf[(row * NKV + slot - NH) * HD + lid];
            }
        }
        float ss = subgroupAdd(x * x);
        if (subgroupElect()) {
            red[gl_SubgroupID] = ss;
        }
        barrier();
        float tot = 0.0;
        for (uint s = 0u; s < gl_NumSubgroups; s++) {
            tot += red[s];
        }
        if (lid < HD) {
            x *= inversesqrt(tot / float(HD) + eps) * gains[(is_q ? 0u : HD) + lid];
            xs[lid] = x;
        }
        barrier();
        if (lid >= HD) {
            return;
        }
        float r = x;
        uint half_rot = ROT / 2u;
        if (lid < ROT) {
            uint jj = lid % half_rot;
            float pos = float(row % n_ctx);
            float ang = pos * pow(theta, -2.0 * float(jj) / float(ROT));
            float cs = cos(ang);
            float sn = sin(ang);
            if (lid < half_rot) {
                r = xs[lid] * cs - xs[lid + half_rot] * sn;
            } else {
                r = xs[lid] * cs + xs[lid - half_rot] * sn;
            }
        }
        if (is_q) {
            q[(row * NH + slot) * HD + lid] = r;
        } else {
            k[(row * NKV + slot - NH) * HD + lid] = r;
        }
    }
}
